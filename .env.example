# ==========================================
# SYMENO STORE - LOCAL ENVIRONMENT TEMPLATE
# ==========================================
# INSTRUCTIONS: Copy this file to '.env' and populate the values.
# NEVER commit the actual '.env' file to version control.

# 1. FRONTEND VARIABLES (Publicly exposed to the browser)
PUBLIC_STRIPE_KEY="pk_test_placeholder"
PUBLIC_SITE_URL="http://localhost:4321"

# 2. BACKEND SECRETS (Never exposed to the browser)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
RESEND_API_KEY="re_placeholder"

# 3. R2 STORAGE CREDENTIALS (S3 API Access)
R2_ACCOUNT_ID="cloudflare_account_id_placeholder"
R2_ACCESS_KEY_ID="r2_access_key_placeholder"
R2_SECRET_ACCESS_KEY="r2_secret_key_placeholder"
R2_BUCKET_NAME="symeno-images"

# 4. ASTRO/VITE SYSTEM VARIABLES
# Note: MODE and PROD are injected automatically by Vite during build, 
# but are documented here to satisfy strict CI/CD sync audits.
MODE="development"
PROD="false"