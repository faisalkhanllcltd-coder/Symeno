---
interface Props {
  paths: { label: string; url?: string }[];
}
const { paths } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol
    class="text-content-muted flex items-center space-x-2 font-mono text-sm tracking-widest uppercase"
  >
    {
      paths.map((path, index) => (
        <li class="flex items-center">
          {path.url ? (
            <a href={path.url} class="hover:text-brand transition-colors">
              {path.label}
            </a>
          ) : (
            <span class="text-content">{path.label}</span>
          )}
          {index < paths.length - 1 && <span class="mx-2">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
