---
// src/components/seo/JsonLd.astro

interface Props {
  schema?: Record<string, any>;
}

const { schema } = Astro.props;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SYMENO LLC",
  "url": "https://symeno.com",
  "email": "support@symeno.com",
  "telephone": "+13073107918",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "30 N Gould St 59458",
    "addressLocality": "Sheridan",
    "addressRegion": "WY",
    "postalCode": "82801",
    "addressCountry": "US"
  }
};

const structuredData = schema ? {
  '@context': 'https://schema.org',
  ...schema,
} : null;
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(orgSchema)}
/>
{structuredData && (
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(structuredData)}
/>
)}
