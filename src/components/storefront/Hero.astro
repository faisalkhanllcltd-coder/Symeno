---
// src/components/storefront/Hero.astro
---
<section class="relative w-full min-h-[85svh] flex items-center overflow-hidden bg-base transition-colors duration-300">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand opacity-[0.04] blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 py-12 md:py-0">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">

      <div class="md:col-span-7 flex flex-col items-start text-left">
        <h1 class="text-5xl md:text-7xl font-bold text-content tracking-tighter leading-[1.05] mb-6 font-sans transition-colors duration-300">
          Top Brands.<br/>
          <span class="text-brand font-black">Real Prices.</span><br/>
          No Games.
        </h1>
        <p class="text-lg md:text-xl text-content-muted leading-relaxed mb-8 max-w-xl font-light transition-colors duration-300">
          We aggregate global supply chains and buy in volume so you stop overpaying for premium products.
        </p>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
          <a href="/shop" class="bg-brand text-brand-dark px-8 py-4 rounded-md font-semibold text-sm hover:opacity-90 transition-all duration-300 shadow-[0_0_20px_rgba(54,244,164,0.15)] hover:shadow-[0_0_30px_rgba(54,244,164,0.25)]">
            Shop All Deals
          </a>
          <a href="#deal-of-the-day" class="text-content-muted font-medium text-sm group flex items-center gap-2 hover:text-brand transition-colors duration-300">
            See Today's Top Offer <span class="group-hover:translate-x-1 transition-transform duration-300">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="md:col-span-5 relative" id="deal-of-the-day">
        <div class="bg-surface rounded-xl shadow-ambient overflow-hidden flex flex-col transition-all hover:-translate-y-1 duration-500">
          
          <div class="w-full h-64 bg-surface-hover flex items-center justify-center relative overflow-hidden group transition-colors duration-300">
            <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent z-10 opacity-80"></div>
            <span class="absolute top-4 left-4 z-20 bg-base/80 backdrop-blur-md text-brand  text-[10px] uppercase tracking-widest font-mono px-2.5 py-1 rounded-sm shadow-[0_0_10px_rgba(54,244,164,0.1)]">
              Live Deal
            </span>
            <span class="text-content-muted opacity-50 font-mono text-sm z-0 group-hover:scale-105 transition-transform duration-700">Product Image Area</span>
          </div>

          <div class="p-6 relative z-20 -mt-4">
            <div class="flex justify-between items-start mb-3">
              <span class="text-[10px] tracking-widest font-mono text-content-muted uppercase transition-colors duration-300">Sony</span>
              <div class="flex items-center gap-1.5 text-brand font-mono text-xs bg-base/80 px-2 py-1 rounded border border-outline transition-colors duration-300">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                04:12:59
              </div>
            </div>

            <h3 class="text-lg font-semibold text-content mb-4 leading-tight transition-colors duration-300">WH-1000XM5 Wireless Noise Canceling Headphones</h3>

            <div class="flex items-end gap-3 mb-6">
              <span class="text-3xl font-bold text-brand font-mono tracking-tight">$298.00</span>
              <span class="text-sm text-content-muted line-through font-mono mb-1 transition-colors duration-300">RRP $399.00</span>
            </div>

            <button class="w-full border border-outline bg-transparent text-content py-3.5 rounded-md text-sm font-semibold hover:bg-brand/10 hover:border-brand/50 hover:text-brand transition-all duration-300">
              Claim Offer
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
