---
import { env } from "cloudflare:workers";

const { deal } = Astro.props;

let displayDeal = null;
let dbError = false;

// 1. EDGE AUTONOMY: If parent doesn't pass a deal, fetch the latest enriched asset from D1
if (!deal) {
  try {
    const db = env.DB as any;
    if (db) {
      // We specifically query for a product that our Node engine has already enriched
      const { results } = await db.prepare("SELECT slug, title, brand, basePrice, retailPrice, image_url, images_json FROM rapidapi_cache WHERE images_json IS NOT NULL ORDER BY id DESC LIMIT 1").all();
      
      if (results.length > 0) {
        const p = results[0];
        let mainImage = p.image_url;
        
        try {
          if (p.images_json) {
            const parsed = JSON.parse(p.images_json);
            if (parsed.length > 0) mainImage = parsed[0];
          }
        } catch(e) {}

        displayDeal = {
          slug: p.slug,
          brand: p.brand || 'Symeno Select',
          title: p.title,
          basePrice: p.basePrice || 0,
          retailPrice: p.retailPrice,
          images: [mainImage]
        };
      }
    }
  } catch (e) {
    console.error('[HERO_EDGE_ERROR]', e);
    dbError = true;
  }
} else {
  displayDeal = deal;
}

// 2. FAIL-SAFE GRACEFUL DEGRADATION: Prevent 500 error if DB is empty or offline
if (!displayDeal) {
  displayDeal = {
    slug: 'shop',
    brand: 'System',
    title: 'Catalog Updating - Check Back Soon',
    basePrice: 0,
    retailPrice: 0,
    images: ['https://placehold.co/600x400/1a1a1a/36F4A4?text=Processing...']
  };
}

const discount = displayDeal.retailPrice && displayDeal.retailPrice > displayDeal.basePrice 
  ? Math.floor(displayDeal.retailPrice - displayDeal.basePrice)
  : 0;
---

<section class="bg-base relative flex min-h-[85svh] w-full items-center overflow-hidden transition-colors duration-300">
  <div class="bg-brand pointer-events-none absolute top-1/2 left-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-[0.04] blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 md:py-0 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-12 lg:gap-16">
      <div class="flex flex-col items-start text-left md:col-span-7">
        <h1 class="text-content mb-6 font-sans text-5xl leading-[1.05] font-bold tracking-tighter transition-colors duration-300 md:text-7xl">
          Top Brands.<br />
          <span class="text-brand font-black">Real Prices.</span><br />
          No Games.
        </h1>
        <p class="text-content-muted mb-8 max-w-xl text-lg leading-relaxed font-light transition-colors duration-300 md:text-xl">
          We aggregate global supply chains and buy in volume so you stop overpaying for premium lifestyle goods.
        </p>
        <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
          <a href="/shop" class="bg-brand text-brand-dark rounded-md px-8 py-4 text-sm font-semibold shadow-[0_0_20px_rgba(54,244,164,0.15)] transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_30px_rgba(54,244,164,0.25)]">
            Shop All Deals
          </a>
          <a href="#deal-of-the-day" class="text-content-muted group hover:text-brand flex items-center gap-2 text-sm font-medium transition-colors duration-300">
            See Today's Top Offer <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="relative md:col-span-5" id="deal-of-the-day">
        <a href={displayDeal.slug !== 'shop' ? `/shop/product/${displayDeal.slug}` : '/shop'} class="bg-surface shadow-ambient flex flex-col overflow-hidden rounded-xl transition-all duration-500 hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 focus:ring-offset-base block group">
          <div class="bg-surface-hover relative flex h-64 w-full items-center justify-center overflow-hidden transition-colors duration-300">
            <div class="from-surface absolute inset-0 z-10 bg-gradient-to-t to-transparent opacity-80"></div>
            
            <span class="bg-base/80 text-brand absolute top-4 left-4 z-20 rounded-sm px-2.5 py-1 font-mono text-[10px] tracking-widest uppercase shadow-[0_0_10px_rgba(54,244,164,0.1)] backdrop-blur-md">
              Live Deal
            </span>

            <img
              src={displayDeal.images[0]}
              alt={displayDeal.title}
              width="600"
              height="400"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="z-0 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
          </div>

          <div class="relative z-20 -mt-4 p-6">
            <div class="mb-3 flex items-start justify-between">
              <span class="text-content-muted font-mono text-[10px] tracking-widest uppercase transition-colors duration-300">{displayDeal.brand}</span>
              
              {discount > 0 && (
                <div class="text-brand bg-base/80 border-outline flex items-center gap-1.5 rounded border px-2 py-1 font-mono text-xs transition-colors duration-300">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>
                  Save ${discount}
                </div>
              )}
            </div>

            <h3 class="text-content mb-4 text-lg leading-tight font-semibold transition-colors duration-300 truncate" title={displayDeal.title}>
              {displayDeal.title}
            </h3>

            <div class="mb-6 flex items-end gap-3">       
              <span class="text-brand font-mono text-3xl font-bold tracking-tight">${Number(displayDeal.basePrice).toFixed(2)}</span>
              {displayDeal.retailPrice && displayDeal.retailPrice > displayDeal.basePrice && (
                <span class="text-content-muted mb-1 font-mono text-sm line-through transition-colors duration-300">RRP ${Number(displayDeal.retailPrice).toFixed(2)}</span>
              )}
            </div>

            <div class="border-outline text-content group-hover:bg-brand/10 group-hover:border-brand/50 group-hover:text-brand w-full rounded-md border bg-transparent py-3.5 text-center text-sm font-semibold transition-all duration-300">
              Claim Offer
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>