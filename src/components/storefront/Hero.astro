---
// src/components/storefront/Hero.astro
---

<section
  class="bg-base relative flex min-h-[85svh] w-full items-center overflow-hidden transition-colors duration-300"
>
  <div
    class="bg-brand pointer-events-none absolute top-1/2 left-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-[0.04] blur-[100px]"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 md:py-0 lg:px-8"
  >
    <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-12 lg:gap-16">
      <div class="flex flex-col items-start text-left md:col-span-7">
        <h1
          class="text-content mb-6 font-sans text-5xl leading-[1.05] font-bold tracking-tighter transition-colors duration-300 md:text-7xl"
        >
          Top Brands.<br />
          <span class="text-brand font-black">Real Prices.</span><br />
          No Games.
        </h1>
        <p
          class="text-content-muted mb-8 max-w-xl text-lg leading-relaxed font-light transition-colors duration-300 md:text-xl"
        >
          We aggregate global supply chains and buy in volume so you stop
          overpaying for premium products.
        </p>
        <div
          class="flex flex-col items-start gap-6 sm:flex-row sm:items-center"
        >
          <a
            href="/shop"
            class="bg-brand text-brand-dark rounded-md px-8 py-4 text-sm font-semibold shadow-[0_0_20px_rgba(54,244,164,0.15)] transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_30px_rgba(54,244,164,0.25)]"
          >
            Shop All Deals
          </a>
          <a
            href="#deal-of-the-day"
            class="text-content-muted group hover:text-brand flex items-center gap-2 text-sm font-medium transition-colors duration-300"  
          >
            See Today's Top Offer <span
              class="transition-transform duration-300 group-hover:translate-x-1"
              >&rarr;</span
            >
          </a>
        </div>
      </div>

      <div class="relative md:col-span-5" id="deal-of-the-day">      
        <div
          class="bg-surface shadow-ambient flex flex-col overflow-hidden rounded-xl transition-all duration-500 hover:-translate-y-1"     
        >
          <div
            class="bg-surface-hover group relative flex h-64 w-full items-center justify-center overflow-hidden transition-colors duration-300"
          >
            <div
              class="from-surface absolute inset-0 z-10 bg-gradient-to-t to-transparent opacity-80"
            >
            </div>
            <span
              class="bg-base/80 text-brand absolute top-4 left-4 z-20 rounded-sm px-2.5 py-1 font-mono text-[10px] tracking-widest uppercase shadow-[0_0_10px_rgba(54,244,164,0.1)] backdrop-blur-md"
            >
              Live Deal
            </span>
            
            <img
              src="https://placehold.co/600x400/1a1a1a/36F4A4?text=Product+Image"
              alt="WH-1000XM5 Wireless Noise Canceling Headphones"
              width="600"
              height="400"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="z-0 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
          </div>

          <div class="relative z-20 -mt-4 p-6">
            <div class="mb-3 flex items-start justify-between">      
              <span
                class="text-content-muted font-mono text-[10px] tracking-widest uppercase transition-colors duration-300"
                >Sony</span
              >
              <div
                class="text-brand bg-base/80 border-outline flex items-center gap-1.5 rounded border px-2 py-1 font-mono text-xs transition-colors duration-300"
              >
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  ></path></svg
                >
                04:12:59
              </div>
            </div>

            <h3
              class="text-content mb-4 text-lg leading-tight font-semibold transition-colors duration-300"
            >
              WH-1000XM5 Wireless Noise Canceling Headphones
            </h3>

            <div class="mb-6 flex items-end gap-3">
              <span
                class="text-brand font-mono text-3xl font-bold tracking-tight"
                >$298.00</span
              >
              <span
                class="text-content-muted mb-1 font-mono text-sm line-through transition-colors duration-300"
                >RRP $399.00</span
              >
            </div>

            <button
              class="border-outline text-content hover:bg-brand/10 hover:border-brand/50 hover:text-brand w-full rounded-md border bg-transparent py-3.5 text-sm font-semibold transition-all duration-300"    
            >
              Claim Offer
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>