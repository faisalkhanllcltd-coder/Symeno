---
import { env } from "cloudflare:workers";

const { deal } = Astro.props;

let displayDeal = null;

if (!deal) {
  try {
    const db = (env.DB as any) || (Astro.locals as any).runtime?.env?.DB;
    if (db) {
      const { results } = await db.prepare("SELECT id, slug, name, brand, price, images_json FROM catalog_cache WHERE images_json IS NOT NULL AND images_json != '[]' ORDER BY scraped_at DESC LIMIT 1").all();
      
      if (results.length > 0) {
        const p = results[0];
        let mainImage = '';
        
        try {
          if (p.images_json) {
            const parsed = JSON.parse(p.images_json);
            if (parsed.length > 0) mainImage = parsed[0];
          }
        } catch(e) {}

        displayDeal = {
          slug: p.slug || p.id,
          brand: p.brand || 'Symeno Select',
          title: p.name, 
          basePrice: p.price || 0,
          retailPrice: p.price ? p.price * 1.15 : 0, 
          images: mainImage ? [mainImage] : ['https://placehold.co/600x400/1a1a1a/36F4A4?text=Image+Unavailable']
        };
      }
    }
  } catch (e) {
    console.error('[HERO_EDGE_ERROR]', e);
  }
} else {
  displayDeal = deal;
}

if (!displayDeal) {
  displayDeal = {
    slug: 'shop',
    brand: 'System',
    title: 'Catalog Updating - Check Back Soon',
    basePrice: 0,
    retailPrice: 0,
    images: ['https://placehold.co/600x400/1a1a1a/36F4A4?text=Processing...']
  };
}

const discount = displayDeal.retailPrice && displayDeal.retailPrice > displayDeal.basePrice 
  ? Math.floor(displayDeal.retailPrice - displayDeal.basePrice)
  : 0;
---

<section class="bg-base relative flex min-h-[70svh] w-full items-center overflow-hidden transition-colors duration-300 border-b border-outline/30">
  <div class="bg-brand pointer-events-none absolute top-1/2 left-1/2 h-[400px] w-[400px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-[0.03] blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:py-16 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col items-start text-left md:col-span-7">
        <h1 class="text-content mb-4 font-sans text-4xl leading-[1.1] font-bold tracking-tighter transition-colors duration-300 md:text-6xl lg:text-7xl">
          Top Brands.<br />
          <span class="text-brand font-black">Real Prices.</span><br />
          No Games.
        </h1>
        <p class="text-content-muted mb-8 max-w-lg text-base leading-relaxed font-light transition-colors duration-300 md:text-lg">
          We aggregate global supply chains and buy in volume so you stop overpaying for premium lifestyle goods.
        </p>
        <div class="flex w-full flex-col items-start gap-4 sm:w-auto sm:flex-row sm:items-center">
          <a href="/shop" class="bg-brand text-brand-dark flex w-full justify-center rounded-md px-8 py-3.5 text-sm font-bold shadow-[0_0_15px_rgba(54,244,164,0.15)] transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_25px_rgba(54,244,164,0.25)] sm:w-auto">
            Shop All Deals
          </a>
          <a href="#deal-of-the-day" class="text-content-muted group hover:text-brand flex w-full justify-center items-center gap-2 text-sm font-medium transition-colors duration-300 sm:w-auto">
            See Today's Top Offer <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="relative w-full md:col-span-5 flex justify-center lg:justify-end" id="deal-of-the-day">
        <a href={displayDeal.slug !== 'shop' ? `/shop/product/${displayDeal.slug}` : '/shop'} class="w-full max-w-[360px] lg:max-w-[400px] bg-surface shadow-ambient flex flex-col overflow-hidden rounded-2xl transition-all duration-500 hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 focus:ring-offset-base block group border border-outline/50 hover:border-brand/40">
          
          <div class="bg-surface-hover relative flex h-56 sm:h-64 lg:h-[300px] w-full items-center justify-center overflow-hidden transition-colors duration-300">
            <div class="from-surface absolute inset-x-0 bottom-0 h-1/2 z-10 bg-gradient-to-t to-transparent opacity-100 pointer-events-none"></div>
            
            <span class="bg-base/90 text-brand absolute top-4 left-4 z-20 rounded px-2.5 py-1.5 font-mono text-[10px] font-bold tracking-widest uppercase shadow-sm backdrop-blur-md">
              Live Deal
            </span>

            <img
              src={displayDeal.images[0]}
              alt={displayDeal.title}
              width="600"
              height="450"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="z-0 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
          </div>

          <div class="relative z-20 p-6 lg:p-8 bg-surface">
            <div class="mb-3 flex items-start justify-between">
              <span class="text-content-muted font-mono text-[10px] sm:text-[11px] font-bold tracking-widest uppercase transition-colors duration-300">{displayDeal.brand}</span>
              
              {discount > 0 && (
                <div class="text-brand bg-base/90 border-outline/50 flex items-center gap-1 rounded border px-2 py-1 font-mono text-[10px] font-bold transition-colors duration-300 shadow-sm">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>
                  Save ${discount}
                </div>
              )}
            </div>

            <h3 class="text-content mb-4 text-lg sm:text-xl leading-snug font-bold transition-colors duration-300 truncate" title={displayDeal.title}>
              {displayDeal.title}
            </h3>

            <div class="mb-6 flex items-end gap-3">        
              <span class="text-brand font-mono text-2xl sm:text-3xl font-bold tracking-tight">${Number(displayDeal.basePrice).toFixed(2)}</span>
              {displayDeal.retailPrice && displayDeal.retailPrice > displayDeal.basePrice && (
                <span class="text-content-muted mb-1 font-mono text-xs sm:text-sm line-through opacity-70 transition-colors duration-300">RRP ${Number(displayDeal.retailPrice).toFixed(2)}</span>
              )}
            </div>

            <div class="bg-surface-hover border-outline text-content group-hover:bg-brand/10 group-hover:border-brand/40 group-hover:text-brand w-full rounded-lg border py-3.5 text-center text-sm font-bold uppercase tracking-widest transition-all duration-300">
              Claim Offer
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>