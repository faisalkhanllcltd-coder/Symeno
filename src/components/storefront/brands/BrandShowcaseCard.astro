---
interface Props {
  name: string;
  description: string;
  url: string;
}
const { name, description, url } = Astro.props;
---

<a
  href={url}
  class="group block border border-gray-200 bg-white p-8 transition-colors hover:border-black focus:outline-none"
>
  <h3
    class="mb-2 text-2xl font-bold tracking-tight text-gray-900 uppercase transition-colors group-hover:text-[#10b981]"
  >
    {name}.
  </h3>
  <p class="mb-6 line-clamp-2 font-mono text-sm text-gray-500">{description}</p>
  <span
    class="border-b border-transparent pb-0.5 text-[10px] font-bold tracking-widest text-black uppercase transition-colors group-hover:border-black"
    >View Inventory &rarr;</span
  >
</a>
