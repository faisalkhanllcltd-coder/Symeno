---
interface Category {
  name: string;
  slug: string;
  count: number;
  image?: string;
  discount?: string;
  lowStock?: boolean;
  isNew?: boolean;
}

interface Props {
  categories?: Category[];
}

const { categories = [] } = Astro.props;

// Ensure we only ever process the exact 5 items needed for the perfect Bento Grid
const displayCategories = categories.slice(0, 5);
const featured = displayCategories[0];
const topFour = displayCategories.slice(1, 5);
---

<section class="relative w-full bg-base py-10 sm:py-14 border-b border-outline/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="mb-6 sm:mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="mb-1.5 font-mono text-[9px] font-bold tracking-[0.2em] text-content-muted uppercase">
          ● Browse
        </p>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-content leading-none">
          Shop by Category
        </h2>
      </div>
      <a
        href="/shop"
        class="group hidden sm:flex items-center gap-2 font-mono text-[9px] font-bold tracking-[0.15em] uppercase text-content-muted hover:text-brand transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm"
      >
        View All Catalog
        <span class="text-brand transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    {displayCategories.length > 0 ? (
      <div class="flex flex-col gap-2 sm:gap-2.5">
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-2.5">
          {/* FEATURED — col-span-2 row-span-2 */}
          {featured && (
            <a
              href={`/shop/${featured.slug}`}
              class="group relative col-span-2 row-span-2 overflow-hidden rounded-xl border border-outline bg-surface aspect-[16/10] md:aspect-auto md:min-h-[300px] transition-all duration-300 hover:border-brand/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
            >
              {featured.image ? (
                <img src={featured.image} alt={featured.name} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" />
              ) : ( <div class="absolute inset-0 bg-black/90" /> )}
              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/90 via-black/40 to-transparent pointer-events-none" />
              <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6 z-10">
                <p class="mb-2 font-mono text-[8px] font-bold tracking-[0.25em] text-white/60 uppercase">01 — Featured</p>
                <h3 class="mb-3 text-xl sm:text-2xl font-bold tracking-tight text-white uppercase transition-colors group-hover:text-brand">{featured.name}</h3>
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="font-mono text-[9px] font-bold tracking-[0.15em] text-white/80 uppercase">{featured.count} Products</span>
                  {featured.isNew && ( <span class="font-mono text-[7px] font-bold tracking-[0.15em] uppercase px-1.5 py-0.5 rounded-sm border border-brand/25 bg-brand/8 text-brand">New In</span> )}
                  {featured.lowStock && ( <span class="flex items-center gap-1 font-mono text-[7px] font-bold tracking-[0.12em] uppercase px-1.5 py-0.5 rounded-sm border border-brand-alert/20 bg-black/60 text-brand-alert"><span class="h-1 w-1 rounded-full bg-brand-alert animate-pulse" />Low Stock</span> )}
                </div>
              </div>
            </a>
          )}

          {/* TOP 4 REGULAR CARDS */}
          {topFour.map((cat, i) => (
            <a
              href={`/shop/${cat.slug}`}
              class="group relative overflow-hidden rounded-xl border border-outline bg-surface aspect-[4/3] transition-all duration-300 hover:border-brand/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
            >
              {cat.image ? (
                <img src={cat.image} alt={cat.name} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" />
              ) : ( <div class="absolute inset-0 bg-black/90" /> )}
              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/90 via-black/40 to-transparent pointer-events-none" />
              <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4 z-10">
                <p class="mb-1 font-mono text-[7px] font-bold tracking-[0.2em] text-white/60 uppercase">{String(i + 2).padStart(2, '0')}</p>
                <h3 class="mb-1.5 text-[11px] sm:text-sm font-bold tracking-[0.06em] text-white uppercase transition-colors group-hover:text-brand leading-tight">{cat.name}</h3>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[8px] font-bold tracking-[0.12em] text-white/80 uppercase">{cat.count} Items</span>
                  {cat.lowStock && ( <span class="flex items-center gap-1 font-mono text-[7px] font-bold tracking-[0.1em] uppercase px-1.5 py-0.5 rounded-sm border border-brand-alert/20 bg-black/60 text-brand-alert"><span class="h-1 w-1 rounded-full bg-brand-alert animate-pulse" />Low</span> )}
                </div>
              </div>
            </a>
          ))}
        </div>

      </div>
    ) : (
      <div class="flex w-full flex-col items-center justify-center rounded-xl border border-dashed border-outline/50 bg-surface/30 py-14 text-center">
        <svg class="mb-3 h-5 w-5 text-content-muted/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <p class="font-mono text-[9px] font-bold tracking-[0.2em] text-content-muted uppercase">
          Synchronizing Inventory
        </p>
      </div>
    )}

    <div class="mt-5 flex justify-center sm:hidden">
      <a
        href="/shop"
        class="font-mono text-[9px] font-bold tracking-[0.18em] uppercase text-content-muted hover:text-brand transition-colors"
      >
        View All Categories →
      </a>
    </div>

  </div>
</section>