---
// src/components/storefront/CategoryGrid.astro
const categories = [
  { name: "Audio", count: "143", discount: "35%" },
  { name: "Smart Home", count: "89", discount: "20%" },
  { name: "Wearables", count: "212", discount: "40%" },
  { name: "Computing", count: "64", discount: "15%" },
  { name: "Photography", count: "31", discount: "25%", lowStock: true },
  { name: "Accessories", count: "450", discount: "50%" }
];
---
<section class="w-full py-24 bg-[#0b1516] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex justify-between items-end mb-12">
      <h2 class="text-3xl font-bold text-white tracking-tight">Shop by Category</h2>
      <a href="/shop" class="text-sm font-medium text-[#dae5e6]/60 hover:text-[#36f4a4] transition-colors hidden sm:flex items-center gap-1 group">
        View All Catalog <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
      {categories.map((cat) => (
        <a href={/shop/ + cat.name.toLowerCase().replace(' ', '-')} class="group relative block aspect-[4/3] bg-[#131d1e] rounded-xl border border-[#dae5e6]/10 overflow-hidden hover:border-[#dae5e6]/30 transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
          
          <div class="absolute top-4 right-4 z-20 transform -rotate-2 bg-[#070d0e]/90 backdrop-blur-sm border border-[#dae5e6]/15 px-3 py-1.5 rounded shadow-xl">
            <span class="text-[10px] uppercase font-mono text-[#dae5e6]/70 block leading-none mb-0.5 tracking-wider">Up to</span>
            <span class="text-sm font-bold text-[#36f4a4] font-mono leading-none">{cat.discount} Off</span>
          </div>

          <div class="absolute inset-0 bg-[#172122] flex items-center justify-center">
             <span class="text-[#dae5e6]/10 font-mono text-sm group-hover:scale-105 transition-transform duration-700">Category Image</span>
          </div>
          
          <div class="absolute inset-0 bg-gradient-to-t from-[#0b1516] via-[#0b1516]/60 to-transparent z-10 opacity-90 group-hover:opacity-75 transition-opacity duration-500"></div>
          
          <div class="absolute bottom-0 left-0 w-full p-5 z-20 transform translate-y-0">
            <h3 class="text-lg font-bold text-white uppercase tracking-wider mb-1.5 group-hover:text-[#36f4a4] transition-colors">{cat.name}</h3>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-[#dae5e6]/60 tracking-wide">{cat.count} Products</span>
              {cat.lowStock && (
                <div class="flex items-center gap-1.5 bg-[#0b1516]/80 px-2 py-0.5 rounded border border-rose-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                  <span class="text-[10px] uppercase font-mono text-rose-400 tracking-widest">Low Stock</span>
                </div>
              )}
            </div>
          </div>

        </a>
      ))}
    </div>

  </div>
</section>
