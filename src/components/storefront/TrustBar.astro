---
// src/components/storefront/TrustBar.astro
---

<section
  class="w-full overflow-hidden border-y border-outline/40 bg-surface/50 py-3.5 backdrop-blur-md"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-center gap-3 md:flex-row md:justify-between md:gap-6">

      <div class="group flex cursor-default items-center gap-2">
        <svg class="h-3.5 w-3.5 text-content-muted transition-all duration-500 group-hover:text-brand md:h-4 md:w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>
        <span class="font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase transition-colors group-hover:text-content md:text-[10px]">Trusted Distributors</span>
      </div>

      <span class="hidden text-outline/60 md:block">&middot;</span>

      <div class="group flex cursor-default items-center gap-2">
        <svg class="h-3.5 w-3.5 text-content-muted transition-colors duration-300 group-hover:text-brand md:h-4 md:w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
        <span class="font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase transition-colors group-hover:text-content md:text-[10px]">30-Day Returns</span>
      </div>

      <span class="hidden text-outline/60 md:block">&middot;</span>

      <div class="group flex cursor-default items-center gap-2">
        <svg class="h-3.5 w-3.5 text-content-muted transition-colors duration-300 group-hover:text-brand md:h-4 md:w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
        </svg>
        <span class="font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase transition-colors group-hover:text-content md:text-[10px]">Ships Same Business Day</span>
      </div>

    </div>
  </div>
</section>