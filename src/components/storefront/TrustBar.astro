---
// src/components/storefront/TrustBar.astro
---

<section
  class="w-full overflow-hidden border-y border-[#dae5e6]/10 bg-[#0b1516] py-5"
>
  <div class="mx-auto max-w-7xl px-4">
    <div class="hidden items-center justify-between md:flex">
      <div class="group flex cursor-default items-center gap-2">
        <svg
          class="h-5 w-5 text-[#dae5e6]/50 transition-all duration-500 group-hover:rotate-y-180 group-hover:text-[#36f4a4]"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
          ></path></svg
        >
        <span class="text-xs font-medium tracking-wide text-[#dae5e6]/80"
          >Verified Brand Partners</span
        >
      </div>
      <span class="font-bold text-[#dae5e6]/20">&middot;</span>

      <div class="group flex cursor-default items-center gap-2">
        <svg
          class="h-5 w-5 text-[#dae5e6]/50 transition-colors duration-300 group-hover:text-[#36f4a4]"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
          ></path></svg
        >
        <span class="text-xs font-medium tracking-wide text-[#dae5e6]/80"
          >Free Returns <span class="ml-1 font-mono text-[#dae5e6]/50"
            >30 DAYS</span
          ></span
        >
      </div>
      <span class="font-bold text-[#dae5e6]/20">&middot;</span>

      <div class="group flex cursor-default items-center gap-2">
        <svg
          class="h-5 w-5 text-[#dae5e6]/50 transition-colors duration-300 group-hover:text-[#36f4a4]"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"
          ></path></svg
        >
        <span class="text-xs font-medium tracking-wide text-[#dae5e6]/80"
          >Price Match Guarantee</span
        >
      </div>
      <span class="font-bold text-[#dae5e6]/20">&middot;</span>

      <div class="group flex cursor-default items-center gap-2">
        <svg
          class="h-5 w-5 text-[#dae5e6]/50 transition-colors duration-300 group-hover:text-[#36f4a4]"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"
          ></path></svg
        >
        <span class="text-xs font-medium tracking-wide text-[#dae5e6]/80"
          >4.8&star; <span class="ml-1 font-mono text-[#dae5e6]/50"
            >2,400+ REVIEWS</span
          ></span
        >
      </div>
      <span class="font-bold text-[#dae5e6]/20">&middot;</span>

      <div class="group flex cursor-default items-center gap-2">
        <svg
          class="h-5 w-5 text-[#dae5e6]/50 transition-colors duration-300 group-hover:text-[#36f4a4]"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
          ></path></svg
        >
        <span class="text-xs font-medium tracking-wide text-[#dae5e6]/80"
          >Ships in 24 Hours</span
        >
      </div>
    </div>

    <div
      class="relative flex w-full overflow-hidden whitespace-nowrap md:hidden"
    >
      <div
        class="flex w-max animate-[marquee_20s_linear_infinite] items-center gap-6"
      >
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >Verified Partners</span
        ><span class="text-[#36f4a4]/40">&middot;</span>
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >Free Returns</span
        ><span class="text-[#36f4a4]/40">&middot;</span>
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >Price Match</span
        ><span class="text-[#36f4a4]/40">&middot;</span>
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >2,400+ Reviews</span
        ><span class="text-[#36f4a4]/40">&middot;</span>
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >Ships 24 Hrs</span
        >
      </div>
      <div
        class="absolute top-0 left-[100%] flex w-max animate-[marquee_20s_linear_infinite] items-center gap-6"
      >
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >Verified Partners</span
        ><span class="text-[#36f4a4]/40">&middot;</span>
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >Free Returns</span
        ><span class="text-[#36f4a4]/40">&middot;</span>
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >Price Match</span
        ><span class="text-[#36f4a4]/40">&middot;</span>
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >2,400+ Reviews</span
        ><span class="text-[#36f4a4]/40">&middot;</span>
        <span
          class="font-mono text-xs tracking-widest text-[#dae5e6]/60 uppercase"
          >Ships 24 Hrs</span
        >
      </div>
    </div>
  </div>
</section>
