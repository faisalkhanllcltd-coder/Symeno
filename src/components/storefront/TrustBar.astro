---
// src/components/storefront/TrustBar.astro
---

<section
  class="w-full overflow-hidden border-y border-outline/40 bg-surface/50 py-3.5 backdrop-blur-md"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="hidden items-center justify-between md:flex">
      <div class="group flex cursor-default items-center gap-2.5">
        <svg
          class="h-4 w-4 text-content-muted transition-all duration-500 group-hover:rotate-y-180 group-hover:text-brand"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
          ></path></svg
        >
        <span class="font-mono text-[10px] font-bold tracking-widest text-content-muted uppercase transition-colors group-hover:text-content"
          >Trusted Distributors</span
        >
      </div>
      
      <span class="text-outline/60">&middot;</span>

      <div class="group flex cursor-default items-center gap-2.5">
        <svg
          class="h-4 w-4 text-content-muted transition-colors duration-300 group-hover:text-brand"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
          ></path></svg
        >
        <span class="font-mono text-[10px] font-bold tracking-widest text-content-muted uppercase transition-colors group-hover:text-content"
          >30-Day Returns <span class="ml-1 text-brand/70"
            >30 DAYS</span
          ></span
        >
      </div>
      

      
      <span class="text-outline/60">&middot;</span>

      <div class="group flex cursor-default items-center gap-2.5">
        <svg
          class="h-4 w-4 text-content-muted transition-colors duration-300 group-hover:text-brand"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
          ></path></svg
        >
        <span class="font-mono text-[10px] font-bold tracking-widest text-content-muted uppercase transition-colors group-hover:text-content"
          >Ships Same Business Day</span
        >
      </div>
    </div>

    <div class="grid grid-cols-2 gap-y-3 gap-x-2 w-full max-w-[340px] mx-auto md:hidden">
      
      <div class="flex items-center justify-start gap-1.5">
        <svg class="h-3.5 w-3.5 text-content-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"></path>
        </svg>
        <span class="font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase">Trusted Brands</span>
      </div>
      
      <div class="flex items-center justify-end gap-1.5 text-right">
        <svg class="h-3.5 w-3.5 text-content-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"></path>
        </svg>
        <span class="font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase">30-Day Returns</span>
      </div>
      

      
      <div class="flex items-center justify-end gap-1.5 text-right">
        <svg class="h-3.5 w-3.5 text-content-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path>
        </svg>
        <span class="font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase">Ships Same Business Day</span>
      </div>
      
    </div>

  </div>
</section>