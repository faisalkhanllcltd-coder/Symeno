---
// src/components/storefront/Newsletter.astro
---

<section class="w-full bg-surface py-24 border-y border-outline">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="mb-4 text-3xl font-bold tracking-tight text-content md:text-4xl">
      Get First Access.
    </h2>
    <p class="mb-8 mx-auto max-w-xl text-sm leading-relaxed text-content-muted">
      Our deepest deals often sell out in under 60 minutes. Join the priority list for early access and subscriber-only inventory.
    </p>

    <form 
      action="/api/marketing/newsletter" 
      method="POST"
      class="mx-auto max-w-md relative flex items-center mb-6"
    >
      <div class="relative w-full flex items-center rounded-sm border border-outline bg-base p-1 transition-colors focus-within:border-brand focus-within:ring-1 focus-within:ring-brand">
        <input
          type="email"
          name="email"
          required
          placeholder="Enter email address"
          class="w-full bg-transparent py-3 pl-3 pr-[140px] text-sm text-content placeholder:text-content-muted focus:outline-none"
        />
        <button
          type="submit"
          class="btn-premium absolute right-1 top-1 bottom-1 flex items-center justify-center bg-brand px-6 font-mono text-[10px] font-bold tracking-widest text-brand-dark uppercase rounded-sm"
        >
          Send Me Deals
        </button>
      </div>
    </form>

    <div class="flex items-center justify-center gap-2 font-mono text-[9px] tracking-widest text-content-muted uppercase sm:gap-3">
      <span>Zero Spam</span>
      <span class="text-outline">&middot;</span>
      <span>Encrypted Data</span>
      <span class="text-outline">&middot;</span>
      <span>Unsubscribe Anytime</span>
    </div>
  </div>
</section>