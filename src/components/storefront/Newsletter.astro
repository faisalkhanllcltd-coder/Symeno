---
// src/components/storefront/Newsletter.astro
---

<section
  class="relative w-full overflow-hidden border-t border-outline bg-base py-24"
>
  <div
    class="pointer-events-none absolute top-1/2 left-1/2 z-0 h-[400px] w-[400px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand opacity-[0.02] blur-[80px]"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
    <h2 class="mb-4 text-3xl font-bold tracking-tight text-content md:text-4xl">
      Get First Access.
    </h2>
    <p class="mx-auto mb-10 max-w-2xl text-lg font-light text-content-muted">
      Our deepest deals often sell out in under 60 minutes. Join the priority
      list for early access and subscriber-only inventory.
    </p>

    <form class="group mx-auto flex max-w-lg flex-col gap-0 sm:flex-row">
      <input
        type="email"
        placeholder="Enter email address"
        required
        class="flex-grow rounded-none border border-outline bg-surface px-6 py-4 font-mono text-sm text-content transition-all placeholder:text-content-muted/30 focus:border-brand/50 focus:ring-1 focus:ring-brand/50 focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm"
      />
      <button
        type="submit"
        class="rounded-none bg-brand px-8 py-4 text-sm font-bold tracking-wider text-brand-dark uppercase shadow-[0_0_15px_var(--color-brand,rgba(54,244,164,0.1))] transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_25px_var(--color-brand,rgba(54,244,164,0.2))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-dark rounded-sm"
      >
        Send Me Deals
      </button>
    </form>

    <p
      class="mt-6 font-mono text-[10px] tracking-[0.2em] text-content-muted uppercase"
    >
      Zero Spam &middot; Encrypted Data &middot; Unsubscribe Anytime
    </p>
  </div>
</section>
