---
export interface Props {
  products?: any[];
}
const { products = [] } = Astro.props;
---

<section class="w-full border-t border-outline/50 bg-base py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">    
    <div class="mb-8 flex items-end justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-content">
        Best Prices <span class="text-brand">Right Now</span>
      </h2>
    </div>

    <div class="hide-scrollbar -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-6 sm:mx-0 sm:px-0 md:grid md:grid-cols-4">
      {
        products.length > 0 ? (
          products.map((product) => {
            // Safety handler: Support both direct mappings and raw DB rows (images vs images_json)
            let parsedImage = '/images/system/fallback.webp';
            if (product.images && product.images.length > 0) {
              parsedImage = product.images[0];
            } else if (product.images_json && product.images_json !== '[]') {
              try {
                const j = JSON.parse(product.images_json);
                if (j.length > 0) parsedImage = j[0];
              } catch(e) {}
            } else if (product.image_url) {
              parsedImage = product.image_url;
            }

            // Safety handler: Support both name and title mappings
            const displayName = product.name || product.title || 'Unknown Asset';
            const displayPrice = Number(product.price || product.base_price || product.basePrice || 0);
            const displayMsrp = Number(product.retailPrice || product.retail_price || 0);

            return (
              <div class="group relative flex min-w-[75vw] snap-start flex-col border border-outline bg-surface transition-all duration-300 hover:border-content-muted hover:shadow-[0_15px_30px_-10px_rgba(0,0,0,0.5)] sm:min-w-[280px] md:min-w-0 rounded-sm">
                
                <a href={`/shop/product/${product.slug}`} class="relative flex aspect-[4/5] items-center justify-center overflow-hidden bg-surface p-5 block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">      
                  {parsedImage !== '/images/system/fallback.webp' ? (
                    <img 
                      src={parsedImage} 
                      alt={displayName} 
                      loading="lazy" 
                      class="h-full w-full object-contain transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <span class="font-mono text-xs text-content-muted/20 transition-transform duration-500 group-hover:scale-105">
                      Image Syncing
                    </span>
                  )}

                  <div class="absolute top-3 right-3 flex h-7 w-7 items-center justify-center border border-outline bg-base/90 text-content-muted opacity-0 backdrop-blur transition-all duration-300 group-hover:opacity-100 group-hover:border-brand group-hover:text-brand rounded-sm">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </div>
                </a>

                <div class="flex flex-grow flex-col p-4">       
                  <span class="mb-1 font-mono text-[9px] tracking-widest text-content-muted uppercase truncate">
                    {product.brand || 'Symeno Select'}
                  </span>
                  
                  <a href={`/shop/product/${product.slug}`} class="mb-3 line-clamp-2 text-xs leading-snug font-medium text-content transition-colors hover:text-brand focus-visible:outline-none">
                    {displayName}
                  </a>

                  <div class="mt-auto">
                    <div class="mb-2.5 flex items-center gap-1.5">
                      <div class="flex text-brand">
                        <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24">
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                        </svg>
                      </div>
                      <span class="font-mono text-[10px] text-content-muted">
                        {product.rating ? Number(product.rating).toFixed(1) : '5.0'}{' '}        
                        <span class="text-content-muted/30">({product.reviewCount || '100+'})</span>
                      </span>
                    </div>

                    <div class="mb-4 flex items-end gap-2"> 
                      <span class="font-mono text-lg font-bold tracking-tight text-brand">
                        ${displayPrice.toFixed(2)}
                      </span>
                      {displayMsrp > displayPrice && (
                        <span class="mb-0.5 font-mono text-[10px] text-content-muted line-through">
                          WAS ${displayMsrp.toFixed(2)}
                        </span>
                      )}
                    </div>

                    <a href={`/shop/product/${product.slug}`} class="block w-full rounded-none border border-outline bg-surface py-2.5 text-center text-[10px] font-bold tracking-widest text-content uppercase shadow-none transition-all duration-300 hover:border-brand hover:bg-brand hover:text-brand-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm">
                      View & Add to Cart
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        ) : (
          <div class="col-span-full border border-outline bg-surface py-12 text-center md:col-span-4 rounded-sm">
            <p class="font-mono text-[10px] tracking-widest text-content-muted uppercase">
              Inventory depleted. Restocking in progress. 
            </p>
          </div>
        )
      }
    </div>
  </div>

  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</section>