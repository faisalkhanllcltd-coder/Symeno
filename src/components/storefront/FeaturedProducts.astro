---
// src/components/storefront/FeaturedProducts.astro
const products = [
  {
    brand: 'Apple',
    name: 'AirPods Pro (2nd Gen)',
    was: 249.0,
    now: 189.0,
    rating: 4.9,
    reviews: 1240,
  },
  {
    brand: 'Dyson',
    name: 'V15 Detect Absolute',
    was: 749.0,
    now: 599.0,
    rating: 4.8,
    reviews: 892,
  },
  {
    brand: 'Samsung',
    name: '49-Inch Odyssey G9 OLED',
    was: 1799.0,
    now: 1299.0,
    rating: 4.7,
    reviews: 415,
  },
  {
    brand: 'Bose',
    name: 'QuietComfort Ultra',
    was: 429.0,
    now: 349.0,
    rating: 4.8,
    reviews: 633,
  },
];
---

<section class="w-full border-t border-outline/50 bg-base py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex items-end justify-between">
      <h2 class="text-3xl font-bold tracking-tight text-content">
        Best Prices <span class="text-brand">Right Now</span>
      </h2>
    </div>

    <div
      class="hide-scrollbar -mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-8 sm:mx-0 sm:px-0 md:grid md:grid-cols-4"
    >
      {
        products.map((product) => (
          <div class="group relative flex min-w-[75vw] snap-start flex-col border border-outline bg-surface transition-all duration-300 hover:border-content-muted hover:shadow-[0_15px_30px_-10px_rgba(0,0,0,0.5)] sm:min-w-[300px] md:min-w-0">
            <div class="relative flex aspect-[4/5] items-center justify-center overflow-hidden bg-surface p-6">
              <span class="font-mono text-sm text-content-muted/20 transition-transform duration-500 group-hover:scale-105">
                Product Image
              </span>

              <button class="absolute top-3 right-3 flex h-8 w-8 items-center justify-center border border-outline bg-base/80 text-content-muted opacity-0 backdrop-blur transition-all duration-300 group-hover:opacity-100 hover:border-brand hover:bg-brand hover:text-brand-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 4.5v15m7.5-7.5h-15"
                  />
                </svg>
              </button>
            </div>

            <div class="flex flex-grow flex-col p-5">
              <span class="mb-1.5 font-mono text-[10px] tracking-widest text-content-muted uppercase">
                {product.brand}
              </span>
              <h3 class="mb-4 line-clamp-2 text-sm leading-snug font-medium text-content">
                {product.name}
              </h3>

              <div class="mt-auto">
                <div class="mb-3 flex items-center gap-1.5">
                  <div class="flex text-brand">
                    <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                  </div>
                  <span class="font-mono text-xs text-content-muted">
                    {product.rating}{' '}
                    <span class="text-content-muted/30">({product.reviews})</span>
                  </span>
                </div>

                <div class="mb-5 flex items-end gap-2.5">
                  <span class="font-mono text-xl font-bold tracking-tight text-brand">
                    &dollar;{product.now.toFixed(2)}
                  </span>
                  <span class="mb-0.5 font-mono text-xs text-content-muted line-through">
                    WAS &dollar;{product.was.toFixed(2)}
                  </span>
                </div>

                <button class="w-full rounded-none border border-outline bg-surface py-3.5 text-xs font-bold tracking-widest text-content uppercase shadow-none transition-all duration-300 hover:border-brand hover:bg-brand hover:text-brand-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm">
                  Add to Cart
                </button>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</section>
