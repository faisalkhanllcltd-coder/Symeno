---
// src/components/storefront/FeaturedProducts.astro
const products = [
  { brand: "Apple", name: "AirPods Pro (2nd Gen)", was: 249.00, now: 189.00, rating: 4.9, reviews: 1240 },
  { brand: "Dyson", name: "V15 Detect Absolute", was: 749.00, now: 599.00, rating: 4.8, reviews: 892 },
  { brand: "Samsung", name: "49-Inch Odyssey G9 OLED", was: 1799.00, now: 1299.00, rating: 4.7, reviews: 415 },
  { brand: "Bose", name: "QuietComfort Ultra", was: 429.00, now: 349.00, rating: 4.8, reviews: 633 }
];
---
<section class="w-full py-24 bg-[#070d0e] border-t border-[#dae5e6]/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex justify-between items-end mb-12">
      <h2 class="text-3xl font-bold text-white tracking-tight">Best Prices <span class="text-[#36f4a4]">Right Now</span></h2>
    </div>

    <div class="flex overflow-x-auto pb-8 -mx-4 px-4 sm:mx-0 sm:px-0 md:grid md:grid-cols-4 gap-6 snap-x snap-mandatory hide-scrollbar">
      {products.map((product) => (
        <div class="min-w-[75vw] sm:min-w-[300px] md:min-w-0 snap-start group relative bg-[#131d1e] border border-[#dae5e6]/10 hover:border-[#dae5e6]/30 transition-all duration-300 flex flex-col hover:shadow-[0_15px_30px_-10px_rgba(0,0,0,0.5)]">
          
          <div class="relative aspect-[4/5] bg-[#172122] flex items-center justify-center p-6 overflow-hidden">
            <span class="text-[#dae5e6]/20 font-mono text-sm group-hover:scale-105 transition-transform duration-500">Product Image</span>
            
            <button class="absolute top-3 right-3 w-8 h-8 bg-[#0b1516]/80 backdrop-blur border border-[#dae5e6]/15 text-[#dae5e6] flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-[#36f4a4] hover:text-[#003822] hover:border-[#36f4a4]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </button>
          </div>

          <div class="p-5 flex flex-col flex-grow">
            <span class="text-[10px] uppercase font-mono tracking-widest text-[#dae5e6]/50 mb-1.5">{product.brand}</span>
            <h3 class="text-sm font-medium text-white mb-4 line-clamp-2 leading-snug">{product.name}</h3>
            
            <div class="mt-auto">
              <div class="flex items-center gap-1.5 mb-3">
                <div class="flex text-[#36f4a4]">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                </div>
                <span class="text-xs font-mono text-[#dae5e6]/70">{product.rating} <span class="text-[#dae5e6]/30">({product.reviews})</span></span>
              </div>
              
              <div class="flex items-end gap-2.5 mb-5">
                <span class="text-xl font-bold text-[#36f4a4] font-mono tracking-tight">&dollar;{product.now.toFixed(2)}</span>
                <span class="text-xs text-[#dae5e6]/40 line-through font-mono mb-0.5">WAS &dollar;{product.was.toFixed(2)}</span>
              </div>

              <button class="w-full bg-[#172122] border border-[#dae5e6]/15 text-[#dae5e6] text-xs font-bold uppercase tracking-widest py-3.5 hover:bg-[#36f4a4] hover:text-[#003822] hover:border-[#36f4a4] transition-all duration-300 rounded-none shadow-none">
                Add to Cart
              </button>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>
  
  <style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</section>
