---
export interface Props {
  products?: any[];
}

const { products = [] } = Astro.props;

// Extracted parsing logic out of the render loop for faster execution
function parseImage(product: any): string {
  if (product.images && product.images.length > 0) return product.images[0];
  if (product.images_json && product.images_json !== '[]') {
    try {
      const j = JSON.parse(product.images_json);
      if (j.length > 0) return j[0];
    } catch {}
  }
  if (product.image_url) return product.image_url;
  return '/assets/placeholders/product-unavailable.webp';
}
---

<section class="w-full bg-base py-10 sm:py-14 border-t border-outline/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="mb-6 sm:mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="mb-1.5 font-mono text-[9px] font-bold tracking-[0.2em] text-content-muted uppercase">
          ● Deployments
        </p>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-content leading-none">
          Best Prices <span class="text-brand">Right Now</span>
        </h2>
      </div>
      {products.length > 0 && (
        <div class="flex items-center gap-4">
          <span class="hidden sm:block font-mono text-[9px] font-bold tracking-[0.15em] text-content-muted uppercase">
            {products.length} Units Active
          </span>
          <a
            href="/deals"
            class="group hidden sm:flex items-center gap-2 font-mono text-[9px] font-bold tracking-[0.15em] uppercase text-content-muted hover:text-brand transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm"
          >
            View All Deals
            <span class="text-brand transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      )}
    </div>

    {products.length > 0 ? (
      <div class="hide-scrollbar -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0 sm:pb-0 md:grid md:grid-cols-3 lg:grid-cols-4 md:gap-4">
        {products.map((product) => {
          const parsedImage  = parseImage(product);
          const displayName  = product.name || product.title || 'Unknown Asset';
          const displayPrice = Number(product.price || product.base_price || product.basePrice || 0);
          const displayMsrp  = Number(product.retailPrice || product.retail_price || 0);
          const hasDiscount  = displayMsrp > displayPrice;

          return (
            <article class="group relative flex min-w-[75vw] snap-start flex-col overflow-hidden rounded-xl border border-outline/50 bg-surface transition-all duration-300 hover:border-brand/40 hover:shadow-[0_8px_25px_-8px_rgba(54,244,164,0.15)] sm:min-w-[280px] md:min-w-0 focus-within:ring-2 focus-within:ring-brand">
              
              <div class="relative aspect-square overflow-hidden bg-surface-hover/50">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_80%,rgba(54,244,164,0.06)_0%,transparent_70%)] pointer-events-none" />
                
                <div class="from-surface/80 absolute inset-x-0 top-0 h-1/3 z-10 bg-gradient-to-b to-transparent pointer-events-none" />

                {parsedImage !== '/assets/placeholders/product-unavailable.webp' ? (
                  <img 
                    src={parsedImage} 
                    alt={displayName} 
                    loading="lazy" 
                    class="relative z-0 h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.05]"
                  />
                ) : (
                  <div class="absolute inset-0 flex flex-col items-center justify-center gap-1 z-10">
                    <svg class="h-5 w-5 text-content-muted/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="font-mono text-[9px] font-bold tracking-[0.2em] text-content-muted/40 uppercase">
                      Visual Missing
                    </span>
                  </div>
                )}

                <div class="absolute right-3 top-3 z-20 flex flex-col gap-2 opacity-0 transition-all duration-300 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0">
                  <a
                    href={`/shop/product/${product.slug}`}
                    aria-label={`Quick view ${displayName}`}
                    class="flex h-11 w-11 items-center justify-center rounded-lg border border-outline bg-base/95 text-content-muted backdrop-blur-md transition-all duration-200 hover:border-brand hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand shadow-sm"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  </a>
                </div>
              </div>

              <div class="flex flex-grow flex-col p-4 sm:p-5">        
                <p class="mb-1.5 font-mono text-[9px] font-bold tracking-[0.2em] text-content-muted uppercase truncate">
                  {product.brand || 'Symeno Select'}
                </p>

                <a href={`/shop/product/${product.slug}`} class="mb-4 line-clamp-2 text-[14px] sm:text-[15px] font-bold leading-snug text-content transition-colors group-hover:text-brand focus-visible:outline-none group-hover:underline">
                  {displayName}
                </a>

                <div class="mt-auto">
                  {product.rating && (
                    <div class="mb-3 flex items-center gap-1.5">
                      <div class="flex text-brand">
                        <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24">
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                        </svg>
                      </div>
                      <span class="font-mono text-[9px] font-bold text-content-muted">
                        {Number(product.rating).toFixed(1)} 
                        <span class="text-content-muted/50">({product.reviewCount || 0})</span>
                      </span>
                    </div>
                  )}

                  <div class="mb-4 flex flex-wrap items-center justify-between gap-2"> 
                    <div class="flex items-end gap-2">
                      <span class="font-mono text-[18px] sm:text-[20px] font-bold tracking-tight text-brand leading-none">
                        ${displayPrice.toFixed(2)}
                      </span>
                      {hasDiscount && (
                        <span class="font-mono text-[10px] sm:text-[11px] text-content-muted line-through opacity-70">
                          ${displayMsrp.toFixed(2)}
                        </span>
                      )}
                    </div>
                    {hasDiscount && (
                      <span class="font-mono text-[9px] font-bold tracking-widest uppercase px-1.5 py-0.5 rounded-sm border border-brand/25 bg-brand/10 text-brand">
                        Save ${Math.floor(displayMsrp - displayPrice)}
                      </span>
                    )}
                  </div>

                  <a href={`/shop/product/${product.slug}`} class="flex min-h-[44px] w-full items-center justify-center rounded-md border border-outline/80 bg-surface text-[10px] sm:text-[11px] font-bold tracking-widest text-content uppercase transition-all duration-300 group-hover:border-brand/50 group-hover:bg-brand/5 group-hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">
                    View Details
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="col-span-full flex min-h-[200px] flex-col items-center justify-center rounded-xl border border-dashed border-outline/50 bg-surface/30 py-10 text-center">
        <svg class="mb-3 h-6 w-6 text-content-muted/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <p class="font-mono text-[10px] font-bold tracking-[0.2em] text-content-muted uppercase">
          Inventory Synchronizing
        </p>
      </div>
    )}

    {products.length > 0 && (
      <div class="mt-6 flex justify-center sm:hidden">
        <a
          href="/deals"
          class="font-mono text-[10px] font-bold tracking-[0.18em] uppercase text-content-muted hover:text-brand transition-colors"
        >
          View All Deals →
        </a>
      </div>
    )}

  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>