---
export interface Props {
  products?: any[];
}
const { products = [] } = Astro.props;
---

<section class="w-full border-t border-outline/30 bg-base py-8 md:py-12 lg:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">    
    <div class="mb-6 flex items-end justify-between sm:mb-8">
      <h2 class="text-xl font-bold tracking-tight text-content sm:text-2xl">
        Best Prices <span class="text-brand">Right Now</span>
      </h2>
    </div>

    <div class="hide-scrollbar -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-6 sm:mx-0 sm:gap-5 sm:px-0 md:grid md:grid-cols-4 lg:grid-cols-4">
      {
        products.length > 0 ? (
          products.map((product) => {
            // Safety handler: Support both direct mappings and raw DB rows
            // THE FIX: Updated to the correct centralized placeholder asset
            let parsedImage = '/assets/placeholders/product-unavailable.webp';
            if (product.images && product.images.length > 0) {
              parsedImage = product.images[0];
            } else if (product.images_json && product.images_json !== '[]') {
              try {
                const j = JSON.parse(product.images_json);
                if (j.length > 0) parsedImage = j[0];
              } catch(e) {}
            } else if (product.image_url) {
              parsedImage = product.image_url;
            }

            // Safety handler: Support both name and title mappings
            const displayName = product.name || product.title || 'Unknown Asset';
            const displayPrice = Number(product.price || product.base_price || product.basePrice || 0);
            const displayMsrp = Number(product.retailPrice || product.retail_price || 0);

            return (
              <div class="group relative flex min-w-[75vw] snap-start flex-col overflow-hidden rounded-lg border border-outline/60 bg-surface transition-all duration-300 hover:border-brand/40 hover:shadow-[0_8px_25px_-8px_rgba(0,0,0,0.3)] sm:min-w-[260px] md:min-w-0">
                
                <a href={`/shop/product/${product.slug}`} class="relative flex aspect-[4/5] items-center justify-center overflow-hidden bg-surface-hover p-4 block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">      
                  {parsedImage !== '/assets/placeholders/product-unavailable.webp' ? (
                    <img 
                      src={parsedImage} 
                      alt={displayName} 
                      loading="lazy" 
                      class="h-full w-full object-contain transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <span class="font-mono text-[10px] font-bold tracking-widest text-content-muted/40 uppercase transition-transform duration-500 group-hover:scale-105">
                      Visual Missing
                    </span>
                  )}

                  <div class="absolute top-2 right-2 flex h-7 w-7 items-center justify-center rounded border border-outline bg-base/95 text-content-muted opacity-0 shadow-sm backdrop-blur transition-all duration-300 group-hover:opacity-100 group-hover:border-brand/50 group-hover:text-brand sm:top-3 sm:right-3">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </div>
                </a>

                <div class="flex flex-grow flex-col p-4">        
                  <span class="mb-1 font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase truncate">
                    {product.brand || 'Symeno Select'}
                  </span>
                  
                  <a href={`/shop/product/${product.slug}`} class="mb-3 line-clamp-2 text-sm leading-snug font-semibold text-content transition-colors hover:text-brand focus-visible:outline-none">
                    {displayName}
                  </a>

                  <div class="mt-auto">
                    {/* THE FIX: Eradicated fake ratings. Only renders if telemetry exists. */}
                    {product.rating && (
                      <div class="mb-2 flex items-center gap-1.5">
                        <div class="flex text-brand">
                          <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24">
                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                          </svg>
                        </div>
                        <span class="font-mono text-[9px] font-bold text-content-muted">
                          {Number(product.rating).toFixed(1)} 
                          <span class="text-content-muted/50">({product.reviewCount || 0})</span>
                        </span>
                      </div>
                    )}

                    <div class="mb-3 flex items-end gap-2"> 
                      <span class="font-mono text-lg font-bold tracking-tight text-brand">
                        ${displayPrice.toFixed(2)}
                      </span>
                      {displayMsrp > displayPrice && (
                        <span class="mb-0.5 font-mono text-[10px] text-content-muted line-through opacity-70">
                          RRP ${displayMsrp.toFixed(2)}
                        </span>
                      )}
                    </div>

                    {/* THE FIX: Enforced min-h-[44px] touch target for mobile usability */}
                    <a href={`/shop/product/${product.slug}`} class="flex min-h-[44px] w-full items-center justify-center rounded-md border border-outline bg-base text-[10px] font-bold tracking-widest text-content uppercase transition-all duration-300 hover:border-brand/50 hover:bg-brand/5 hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">
                      View Details
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        ) : (
          <div class="col-span-full flex min-h-[150px] flex-col items-center justify-center rounded-lg border border-dashed border-outline/50 bg-surface/30 py-8 text-center md:col-span-4">
            <svg class="mb-2 h-5 w-5 text-content-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <p class="font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase">
              Inventory Synchronizing
            </p>
          </div>
        )
      }
    </div>
  </div>

  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</section>