---
import NewsletterCapture from '../marketing/NewsletterCapture.svelte';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-outline/30 bg-base pt-10 sm:pt-16 lg:pt-20 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">  
    <div class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-12 lg:gap-8">
      
      <div class="col-span-2 lg:col-span-4">
        <a
          href="/"
          class="mb-4 inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
        >
          <img src="/logo.svg" alt="Symeno" class="h-7 w-auto" loading="lazy" />
        </a>
        <p class="mb-6 max-w-sm font-mono text-[11px] sm:text-xs leading-relaxed text-content-muted">
          Operational efficiency applied to consumer electronics. We leverage
          global arbitrage to secure premium hardware at zero-markup wholesale
          rates.
        </p>
        
        <div class="mb-8">
          <NewsletterCapture client:load />
        </div>
      </div>

      <div class="col-span-1 lg:col-span-2">
        <h3 class="mb-3 sm:mb-4 font-mono text-[10px] font-bold tracking-[0.2em] text-content-muted uppercase">
          Shop
        </h3>
        <ul class="space-y-1 text-[13px] sm:text-sm text-content-muted">
          <li>
            <a href="/shop" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Shop All</a>
          </li>
          <li>
            <a href="/deals" class="block py-2 min-h-[44px] font-bold transition-colors text-brand-alert hover:opacity-80 focus-visible:outline-none focus-visible:underline">Deals</a>
          </li>
          <li>
            <a href="/brands" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Brands</a>
          </li>
          <li>
            <a href="/new-arrivals" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">New Arrivals</a>
          </li>
        </ul>
      </div>

      <div class="col-span-1 lg:col-span-2">
        <h3 class="mb-3 sm:mb-4 font-mono text-[10px] font-bold tracking-[0.2em] text-content-muted uppercase">
          Company & Help
        </h3>
        <ul class="space-y-1 text-[13px] sm:text-sm text-content-muted">
          <li>
            <a href="/about" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">About Us</a>
          </li>
          <li>
            <a href="/support/track-order" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Track Order</a>
          </li>
          <li>
            <a href="/support/start-return" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Start a Return</a>
          </li>
          <li>
            <a href="/faq" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">FAQ</a>
          </li>
          <li>
            <a href="/contact" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Contact</a>
          </li>
        </ul>
      </div>

      <div class="col-span-1 lg:col-span-2">
        <h3 class="mb-3 sm:mb-4 font-mono text-[10px] font-bold tracking-[0.2em] text-content-muted uppercase">
          Account
        </h3>
        <ul class="space-y-1 text-[13px] sm:text-sm text-content-muted">
          <li>
            <a href="/auth/login" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Client Login</a>
          </li>
          <li>
            <a href="/account/orders" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Order History</a>
          </li>
          <li>
            <a href="/account/wishlist" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Saved Items</a>
          </li>
          <li>
            <a href="/account/rewards" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Rewards</a>
          </li>
        </ul>
      </div>

      <div class="col-span-1 lg:col-span-2">
        <h3 class="mb-3 sm:mb-4 font-mono text-[10px] font-bold tracking-[0.2em] text-content-muted uppercase">
          Legal
        </h3>
        <ul class="space-y-1 text-[13px] sm:text-sm text-content-muted">
          <li>
            <a href="/policies/terms" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Terms of Service</a>
          </li>
          <li>
            <a href="/policies/privacy" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Privacy Policy</a>
          </li>
          <li>
            <a href="/policies/cookies" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Cookie Protocol</a>
          </li>
          <li>
            <a href="/policies/shipping" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Shipping Ops</a>
          </li>
          <li>
            <a href="/policies/returns" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Returns Policy</a>
          </li>
          <li>
            <a href="/policies/authenticity" class="block py-2 min-h-[44px] transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand">Authenticity</a>
          </li>
        </ul>
      </div>

    </div>
    
    <div class="border-t border-outline/30 py-6 mt-10">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="font-mono text-[9px] font-bold tracking-widest text-content-muted uppercase">
          &copy; {currentYear} SYMENO LLC. All rights reserved.
        </div>
        <div class="font-mono text-[9px] tracking-widest text-content-muted uppercase flex flex-wrap justify-center sm:justify-end gap-x-2 gap-y-1">
          <span>30 N Gould St 59458, Sheridan, WY 82801, USA</span>
          <span class="hidden sm:inline">&middot;</span>
          <a href="mailto:support@symeno.com" class="hover:text-brand transition-colors">support@symeno.com</a>
          <span class="hidden sm:inline">&middot;</span>
          <a href="tel:+13073107918" class="hover:text-brand transition-colors">+1 (307) 310-7918</a>
        </div>
      </div>
    </div>
  </div>
</footer>