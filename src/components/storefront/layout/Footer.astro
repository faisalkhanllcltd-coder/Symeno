---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-outline bg-base pt-16 pb-8 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">  
    <div
      class="mb-16 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-8"
    >
      <div class="lg:col-span-4">
        <a
          href="/"
          class="mb-4 block text-xl font-bold tracking-tighter text-content uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand w-max"
          >Symeno<span class="text-brand">.</span></a
        >
        <p
          class="mb-6 max-w-sm font-mono text-xs leading-relaxed text-content-muted"
        >
          Operational efficiency applied to consumer electronics. We leverage
          global arbitrage to secure premium hardware at zero-markup wholesale
          rates.
        </p>
        <div
          class="mb-6 space-y-1 font-mono text-[10px] tracking-widest text-content-muted uppercase"
        >
          <p>Company Reg No. 15389422</p>
          <p>128 City Road, London, EC1V 2NX</p>        
        </div>
        <div class="flex gap-3">
          <div
            class="flex h-5 w-8 items-center justify-center border border-outline bg-surface font-mono text-[8px] text-content-muted"
          >
            X
          </div>
          <div
            class="flex h-5 w-8 items-center justify-center border border-outline bg-surface font-mono text-[8px] text-content-muted"
          >
            IN
          </div>
          <div
            class="flex h-5 w-8 items-center justify-center border border-outline bg-surface font-mono text-[8px] text-content-muted"
          >
            PAY
          </div>
          <div
            class="flex h-5 w-8 items-center justify-center border border-outline bg-surface font-mono text-[8px] text-content-muted"
          >
            SEC
          </div>
        </div>
      </div>

      <div class="lg:col-span-2">
        <h3
          class="mb-4 font-mono text-[10px] font-bold tracking-widest text-content uppercase"
        >
          Shop
        </h3>
        <ul class="space-y-3 text-sm text-content-muted">   
          <li>
            <a
              href="/shop"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Shop All</a>
          </li>
          <li>
            <a
              href="/new-arrivals"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >New Arrivals</a>
          </li>
          <li>
            <a
              href="/deals"
              class="font-medium transition-colors text-brand-alert hover:opacity-80 focus-visible:outline-none focus-visible:underline"
              >Deals</a>
          </li>
          <li>
            <a
              href="/brands"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >All Brands</a>
          </li>
          <li>
            <a
              href="/shop/audio"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Audio</a>
          </li>
          <li>
            <a
              href="/shop/displays"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Displays</a>
          </li>
          <li>
            <a
              href="/shop/peripherals"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Peripherals</a>
          </li>
          <li>
            <a
              href="/shop/components"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Components</a>
          </li>
          <li>
            <a
              href="/compare"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Compare Products</a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3
          class="mb-4 font-mono text-[10px] font-bold tracking-widest text-content uppercase"
        >
          Help
        </h3>
        <ul class="space-y-3 text-sm text-content-muted">   
          <li>
            <a
              href="/contact"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Contact Us</a>
          </li>
          <li>
            <a
              href="/faq"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >FAQ</a>
          </li>
          <li>
            <a
              href="/support/track-order"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Track My Order</a>
          </li>
          <li>
            <a
              href="/support/start-return"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Start a Return</a>
          </li>
          <li>
            <a
              href="/policies/authenticity"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Authenticity Policy</a>
          </li>
          <li>
            <a
              href="/b2b"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >B2B / Wholesale</a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3
          class="mb-4 font-mono text-[10px] font-bold tracking-widest text-content uppercase"
        >
          Company
        </h3>
        <ul class="space-y-3 text-sm text-content-muted">   
          <li>
            <a
              href="/about"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >About Symeno</a>
          </li>
          <li>
            <a
              href="/blog"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Blog</a>
          </li>
          <li>
            <a
              href="/careers"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Careers</a>
          </li>
          <li>
            <a
              href="/press"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Press</a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3
          class="mb-4 font-mono text-[10px] font-bold tracking-widest text-content uppercase"
        >
          Legal
        </h3>
        <ul class="space-y-3 text-sm text-content-muted">   
          <li>
            <a
              href="/policies/terms"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Terms of Service</a>
          </li>
          <li>
            <a
              href="/policies/privacy"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Privacy Policy</a>
          </li>
          <li>
            <a
              href="/policies/shipping"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Shipping Policy</a>
          </li>
          <li>
            <a
              href="/policies/returns"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Returns Policy</a>
          </li>
          <li>
            <a
              href="/policies/cookies"
              class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
              >Cookie Policy</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-center gap-4 border-t border-outline pt-8 text-center"
    >
      <p
        class="font-mono text-[10px] leading-relaxed tracking-widest text-content-muted uppercase"
      >
        &copy; {currentYear} Symeno Ltd &middot; Registered in UK &middot; Reg. No.
        15389422 &middot; All prices include VAT        
      </p>
    </div>
  </div>
</footer>