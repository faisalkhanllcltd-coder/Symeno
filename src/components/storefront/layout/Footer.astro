---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-200 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 mb-16">
      
      <div class="lg:col-span-4">
        <a href="/" class="text-xl font-bold tracking-tighter text-black uppercase mb-4 block">Symeno<span class="text-[#10b981]">.</span></a>
        <p class="text-xs text-gray-500 font-mono max-w-sm leading-relaxed mb-6">
          Operational efficiency applied to consumer electronics. We leverage global arbitrage to secure premium hardware at zero-markup wholesale rates.
        </p>
        <div class="space-y-1 mb-6 text-[10px] font-mono text-gray-400 uppercase tracking-widest">
          <p>Company Reg No. 15389422</p>
          <p>128 City Road, London, EC1V 2NX</p>
        </div>
        <div class="flex gap-3">
          <div class="w-8 h-5 bg-gray-100 border border-gray-200 flex items-center justify-center text-[8px] font-mono text-gray-400">X</div>
          <div class="w-8 h-5 bg-gray-100 border border-gray-200 flex items-center justify-center text-[8px] font-mono text-gray-400">IN</div>
          <div class="w-8 h-5 bg-gray-100 border border-gray-200 flex items-center justify-center text-[8px] font-mono text-gray-400">PAY</div>
          <div class="w-8 h-5 bg-gray-100 border border-gray-200 flex items-center justify-center text-[8px] font-mono text-gray-400">SEC</div>
        </div>
      </div>

      <div class="lg:col-span-2">
        <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-900 font-mono mb-4">Shop</h3>
        <ul class="space-y-3 text-sm text-gray-500">
          <li><a href="/shop" class="hover:text-black transition-colors focus:outline-none">Shop All</a></li>
          <li><a href="/new-arrivals" class="hover:text-black transition-colors focus:outline-none">New Arrivals</a></li>
          <li><a href="/sale" class="hover:text-[#10b981] font-medium transition-colors focus:outline-none">Deals</a></li>
          <li><a href="/brands" class="hover:text-black transition-colors focus:outline-none">All Brands</a></li>
          <li><a href="/shop/audio" class="hover:text-black transition-colors focus:outline-none">Audio</a></li>
          <li><a href="/shop/displays" class="hover:text-black transition-colors focus:outline-none">Displays</a></li>
          <li><a href="/shop/peripherals" class="hover:text-black transition-colors focus:outline-none">Peripherals</a></li>
          <li><a href="/shop/components" class="hover:text-black transition-colors focus:outline-none">Components</a></li>
          <li><a href="/compare" class="hover:text-black transition-colors focus:outline-none">Compare Products</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-900 font-mono mb-4">Help</h3>
        <ul class="space-y-3 text-sm text-gray-500">
          <li><a href="/contact" class="hover:text-black transition-colors focus:outline-none">Contact Us</a></li>
          <li><a href="/faq" class="hover:text-black transition-colors focus:outline-none">FAQ</a></li>
          <li><a href="/support/track-order" class="hover:text-black transition-colors focus:outline-none">Track My Order</a></li>
          <li><a href="/support/start-return" class="hover:text-black transition-colors focus:outline-none">Start a Return</a></li>
          <li><a href="/policies/authenticity" class="hover:text-black transition-colors focus:outline-none">Authenticity Policy</a></li>
          <li><a href="/b2b" class="hover:text-black transition-colors focus:outline-none">B2B / Wholesale</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-900 font-mono mb-4">Company</h3>
        <ul class="space-y-3 text-sm text-gray-500">
          <li><a href="/about" class="hover:text-black transition-colors focus:outline-none">About Symeno</a></li>
          <li><a href="/blog" class="hover:text-black transition-colors focus:outline-none">Blog</a></li>
          <li><a href="/careers" class="hover:text-black transition-colors focus:outline-none">Careers</a></li>
          <li><a href="/press" class="hover:text-black transition-colors focus:outline-none">Press</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-900 font-mono mb-4">Legal</h3>
        <ul class="space-y-3 text-sm text-gray-500">
          <li><a href="/policies/terms" class="hover:text-black transition-colors focus:outline-none">Terms of Service</a></li>
          <li><a href="/policies/privacy" class="hover:text-black transition-colors focus:outline-none">Privacy Policy</a></li>
          <li><a href="/policies/shipping" class="hover:text-black transition-colors focus:outline-none">Shipping Policy</a></li>
          <li><a href="/policies/returns" class="hover:text-black transition-colors focus:outline-none">Returns Policy</a></li>
          <li><a href="/policies/cookies" class="hover:text-black transition-colors focus:outline-none">Cookie Policy</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-gray-200 pt-8 flex flex-col items-center justify-center text-center gap-4">
      <p class="text-[10px] font-mono text-gray-400 uppercase tracking-widest leading-relaxed">
        &copy; {currentYear} Symeno Ltd &middot; Registered in UK &middot; Reg. No. 15389422 &middot; All prices include VAT
      </p>
    </div>
  </div>
</footer>