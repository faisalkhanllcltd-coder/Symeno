---
import MobileDrawer from './MobileDrawer.svelte';        
import CartBadge from '../cart/CartBadge.svelte';        

const user = Astro.locals.user;
---

<!-- THE PHANTOM SPACER -->
<div class="h-16 w-full shrink-0"></div>

<header 
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 w-full border-b border-transparent bg-transparent transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      
      <!-- YOUR CUSTOM SVG LOGO -->
      <div class="flex flex-shrink-0 items-center">
        <a
          href="/"
          class="group flex items-center transition-transform duration-200 hover:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm"
          aria-label="Symeno Home"
        >
          <!-- Pointing explicitly to your public/logo.svg -->
          <img 
            src="/logo.svg" 
            alt="Symeno" 
            class="h-8 w-auto transition-opacity duration-300 group-hover:opacity-80" 
          />
        </a>
      </div>

      <!-- DESKTOP NAVIGATION (Flat & Fast) -->
      <nav class="hidden h-full flex-1 justify-center md:flex space-x-12">
        <a href="/" class="flex h-full items-center text-[13px] font-medium tracking-wide text-content uppercase hover:text-brand transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm">Home</a>
        <a href="/shop" class="flex h-full items-center text-[13px] font-medium tracking-wide text-content uppercase hover:text-brand transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm">Shop</a>
        <a href="/brands" class="flex h-full items-center text-[13px] font-medium tracking-wide text-content uppercase hover:text-brand transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm">Brands</a>
        <a href="/deals" class="flex h-full items-center text-[13px] font-medium tracking-wide text-brand-alert uppercase hover:opacity-80 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-alert rounded-sm">Deals</a>
        <a href="/new-arrivals" class="flex h-full items-center text-[13px] font-medium tracking-wide text-content uppercase hover:text-brand transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm">New In</a>
      </nav>

      <!-- ICONS -->
      <div class="flex items-center space-x-1 md:space-x-3 text-content">
        <button id="theme-toggle-trigger" class="transition-colors text-content-muted hover:text-brand hover:bg-surface/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-md flex min-h-[40px] min-w-[40px] items-center justify-center" aria-label="Toggle Theme">
          <svg class="h-[18px] w-[18px] block dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
          <svg class="h-[18px] w-[18px] hidden dark:block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
        </button>

        <button id="global-search-trigger" class="transition-colors text-content-muted hover:text-brand hover:bg-surface/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-md flex min-h-[40px] min-w-[40px] items-center justify-center" aria-label="Open Search">
          <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path></svg>
        </button>

        <a href={user ? '/account' : '/auth/login'} class="hidden transition-colors text-content-muted hover:text-brand hover:bg-surface/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-md sm:flex min-h-[40px] min-w-[40px] items-center justify-center" aria-label="Account">
          <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"></path></svg>
        </a>

        <div class="flex min-h-[40px] min-w-[40px] items-center justify-center ml-1">
          <CartBadge client:load />
        </div>

        <button id="mobile-nav-trigger" class="transition-colors text-content-muted hover:text-brand hover:bg-surface/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-md md:hidden flex min-h-[40px] min-w-[40px] items-center justify-center ml-1" aria-label="Open Navigation">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path></svg>
        </button>
      </div>
    </div>
  </div>
</header>

<MobileDrawer client:load />

<script>
  const header = document.getElementById('main-header');
  let lastScroll = window.pageYOffset;
  let scrollThreshold = 64; 

  window.addEventListener('scroll', () => {
    if (!header) return;
    const currentScroll = window.pageYOffset;

    if (currentScroll > lastScroll && currentScroll > scrollThreshold) {
      header.classList.add('-translate-y-full');
    } else if (currentScroll < lastScroll) {
      header.classList.remove('-translate-y-full');
    }
    
    lastScroll = currentScroll;
    updateHeaderState();
  }, { passive: true });

  function updateHeaderState() {
    if (!header) return;
    const currentScroll = window.pageYOffset;

    if (currentScroll > 20) {
      header.classList.add('bg-base/95', 'backdrop-blur-2xl', 'border-outline/30', 'shadow-md', 'supports-[backdrop-filter]:bg-base/85');
      header.classList.remove('bg-transparent', 'border-transparent');
    } else {
      header.classList.remove('bg-base/95', 'backdrop-blur-2xl', 'border-outline/30', 'shadow-md', 'supports-[backdrop-filter]:bg-base/85');
      header.classList.add('bg-transparent', 'border-transparent');
    }
  }

  updateHeaderState(); 

  const themeBtn = document.getElementById('theme-toggle-trigger');
  themeBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    const newTheme = isDark ? 'dark' : 'light';
    localStorage.setItem('theme', newTheme);
    window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: newTheme } }));
  });

  const mobileBtn = document.getElementById('mobile-nav-trigger');   
  mobileBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-mobile-nav'));        
  });

  const searchBtn = document.getElementById('global-search-trigger');
  searchBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });
</script>