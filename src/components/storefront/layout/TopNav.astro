---
import MegaMenu from './MegaMenu.svelte';
import MobileDrawer from './MobileDrawer.svelte';        
import CartBadge from '../cart/CartBadge.svelte';        

const user = Astro.locals.user;
---

<header class="sticky top-0 z-50 w-full border-b border-outline bg-base transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex flex-shrink-0 items-center">
        <a
          href="/"
          class="text-2xl font-bold tracking-tighter text-content uppercase transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm"
          >Symeno<span class="text-brand">.</span></a
        >
      </div>

      <div class="hidden h-full flex-1 justify-center md:flex">      
        <MegaMenu client:load />
      </div>

      <div class="flex items-center space-x-2 md:space-x-5 text-content">
        
        <button
          id="theme-toggle-trigger"
          class="transition-colors text-content-muted hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm flex min-h-[44px] min-w-[44px] items-center justify-center"
          aria-label="Toggle Theme"
        >
          <svg class="h-5 w-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
          <svg class="h-5 w-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
        </button>

        <button
          id="global-search-trigger"
          class="transition-colors text-content-muted hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm flex min-h-[44px] min-w-[44px] items-center justify-center"
          aria-label="Open Search"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
          </svg>
        </button>

        <a
          href={user ? '/account' : '/auth/login'}
          class="hidden transition-colors text-content-muted hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm sm:flex min-h-[44px] min-w-[44px] items-center justify-center"
          aria-label="Account"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"></path>
          </svg>
        </a>

        <div class="flex min-h-[44px] min-w-[44px] items-center justify-center">
          <CartBadge client:load />
        </div>

        <button
          id="mobile-nav-trigger"
          class="transition-colors text-content-muted hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand rounded-sm md:hidden flex min-h-[44px] min-w-[44px] items-center justify-center"
          aria-label="Open Navigation"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<MobileDrawer client:load />

<script>
  // Theme Toggler
  const themeBtn = document.getElementById('theme-toggle-trigger');
  themeBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    const newTheme = isDark ? 'dark' : 'light';
    localStorage.setItem('theme', newTheme);
    // Broadcast for Svelte hydration sync
    window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: newTheme } }));
  });

  // Mobile Nav Dispatcher
  const mobileBtn = document.getElementById('mobile-nav-trigger');   
  mobileBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-mobile-nav'));        
  });

  // Command Palette Dispatcher
  const searchBtn = document.getElementById('global-search-trigger');
  searchBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });
</script>