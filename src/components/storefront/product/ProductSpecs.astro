---
interface Props {
  specs: Record<string, string>;
}
const { specs } = Astro.props;
---
<div class="border border-gray-200 bg-white">
  <div class="bg-gray-50 border-b border-gray-200 px-4 py-3">
    <h3 class="text-xs font-bold uppercase tracking-widest text-gray-900 font-mono">Hardware Specifications</h3>
  </div>
  <div class="divide-y divide-gray-100">
    {Object.entries(specs).map(([key, value]) => (
      <div class="grid grid-cols-3 px-4 py-3 text-sm">
        <dt class="font-bold text-gray-900 col-span-1">{key}</dt>
        <dd class="text-gray-600 col-span-2 font-mono">{value}</dd>
      </div>
    ))}
  </div>
</div>
