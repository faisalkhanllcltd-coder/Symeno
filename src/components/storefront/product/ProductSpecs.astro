---
interface Props {
  specs: Record<string, string>;
}
const { specs } = Astro.props;
---

<div class="border border-gray-200 bg-white">
  <div class="border-b border-gray-200 bg-gray-50 px-4 py-3">
    <h3
      class="font-mono text-xs font-bold tracking-widest text-gray-900 uppercase"
    >
      Hardware Specifications
    </h3>
  </div>
  <div class="divide-y divide-gray-100">
    {
      Object.entries(specs).map(([key, value]) => (
        <div class="grid grid-cols-3 px-4 py-3 text-sm">
          <dt class="col-span-1 font-bold text-gray-900">{key}</dt>
          <dd class="col-span-2 font-mono text-gray-600">{value}</dd>
        </div>
      ))
    }
  </div>
</div>
