---
const mockRelated = [
  { id: '1', name: 'Logitech MX Master 3S', price: 99.0 },
  { id: '2', name: 'Keychron K8 Pro', price: 119.0 },
];
---

<div class="mt-20 border-t border-outline pt-16">
  <h2 class="mb-8 text-2xl font-bold tracking-tight text-content uppercase">
    Related Hardware.
  </h2>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
    {
      mockRelated.map((item) => (
        <a
          href={`/shop/product/${item.id}`}
          class="group block border border-outline bg-surface p-4 transition-colors hover:border-brand"
        >
          <div class="mb-4 flex aspect-square items-center justify-center bg-base font-mono text-[10px] text-content-muted">
            IMG
          </div>
          <h3 class="truncate text-sm font-bold text-content transition-colors group-hover:text-brand">
            {item.name}
          </h3>
          <p class="mt-1 font-mono text-sm text-content-muted">
            ${item.price.toFixed(2)}
          </p>
        </a>
      ))
    }
  </div>
</div>
