---
const mockRelated = [
  { id: '1', name: 'Logitech MX Master 3S', price: 99.00 },
  { id: '2', name: 'Keychron K8 Pro', price: 119.00 }
];
---
<div class="mt-20 border-t border-gray-200 pt-16">
  <h2 class="text-2xl font-bold tracking-tight text-gray-900 uppercase mb-8">Related Hardware.</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
    {mockRelated.map(item => (
      <a href={`/shop/product/${item.id}`} class="group block border border-gray-200 bg-[#F9FAFB] p-4 hover:border-gray-400 transition-colors">
        <div class="aspect-square bg-gray-100 mb-4 flex items-center justify-center text-[10px] text-gray-400 font-mono">IMG</div>
        <h3 class="text-sm font-bold text-gray-900 truncate group-hover:text-[#10b981] transition-colors">{item.name}</h3>
        <p class="text-sm font-mono text-gray-600 mt-1">${item.price.toFixed(2)}</p>
      </a>
    ))}
  </div>
</div>
