---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Symeno</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="flex min-h-screen flex-col bg-[#F9FAFB] font-sans text-gray-900 antialiased selection:bg-[#10b981]/20 selection:text-black"
  >
    <header class="flex w-full shrink-0 items-center justify-center py-8">
      <a
        href="/"
        class="text-3xl font-bold tracking-tighter text-black uppercase focus:outline-none"
        >Symeno<span class="text-[#10b981]">.</span></a
      >
    </header>

    <main
      class="flex w-full flex-1 flex-col items-center justify-center px-4 py-8 sm:px-6 lg:px-8"
    >
      <slot />
    </main>

    <footer class="w-full shrink-0 py-8">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-6 px-4 font-mono text-[10px] tracking-widest text-gray-400 uppercase md:flex-row"
      >
        <p>&copy; {currentYear} Symeno LLC.</p>
        <nav class="flex gap-6">
          <a
            href="/policies/privacy"
            class="transition-colors hover:text-black focus:outline-none"
            >Privacy</a
          >
          <a
            href="/policies/terms"
            class="transition-colors hover:text-black focus:outline-none"
            >Terms</a
          >
        </nav>
      </div>
    </footer>
  </body>
</html>
