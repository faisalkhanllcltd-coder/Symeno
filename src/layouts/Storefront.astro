---
import '../styles/global.css';
import CartDrawer from '../components/storefront/cart/CartDrawer.svelte';
import MetaTags from '../components/seo/MetaTags.astro';  

import TopNav from '../components/storefront/layout/TopNav.astro';
import Footer from '../components/storefront/layout/Footer.astro';
import GlobalSearch from '../components/storefront/search/GlobalSearch.svelte';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Top Brands. Real Prices. No Games.', image } = Astro.props;
const isLoggedIn = !!Astro.locals.user;
---
<!doctype html>
<html lang="en" class="scroll-smooth w-full">
  <head>
    <MetaTags title={`${title} | Symeno`} description={description} image={image} />
    
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1516" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="bg-base text-content flex min-h-screen w-full flex-col overflow-x-hidden font-sans antialiased selection:bg-brand/20 selection:text-content">
    <TopNav />
    <GlobalSearch client:load />
    <main class="relative flex w-full flex-grow flex-col"><slot /></main>
    <footer class="bg-surface mt-auto"><Footer /></footer>
    <CartDrawer client:load />
    
    <script is:inline define:vars={{ isLoggedIn }}>window.SYMENO_IS_LOGGED_IN = isLoggedIn;</script>
    <script>
      import { wishlist } from '../stores/wishlist.svelte.ts'; 
      wishlist.init((window as any).SYMENO_IS_LOGGED_IN);
    </script>
  </body>
</html>