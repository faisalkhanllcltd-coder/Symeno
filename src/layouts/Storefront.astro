                >X</a
              >
              <a
                href="#"
                aria-label="Social Matrix LinkedIn"
                class="bg-surface border-outline hover:border-brand focus-visible:border-brand focus-visible:text-brand flex h-5 w-8 items-center justify-center border font-mono text-[8px] transition-colors focus-visible:outline-none"
                >IN</a
              >
              <a
                href="#"
                aria-label="Payment Gateway Intel"
                class="bg-surface border-outline hover:border-brand focus-visible:border-brand focus-visible:text-brand flex h-5 w-8 items-center justify-center border font-mono text-[8px] transition-colors focus-visible:outline-none"
                >PAY</a
              >
              <a
                href="#"
                aria-label="Security Protocols"
                class="bg-surface border-outline hover:border-brand focus-visible:border-brand focus-visible:text-brand flex h-5 w-8 items-center justify-center border font-mono text-[8px] transition-colors focus-visible:outline-none"
                >SEC</a
              >
            </div>

            <div class="border-t border-white/10 pt-8 pr-8">
              <NewsletterCapture client:load />
