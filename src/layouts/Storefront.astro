---
import '../styles/global.css';
import CartDrawer from '../components/storefront/cart/CartDrawer.svelte';
import MetaTags from '../components/seo/MetaTags.astro';  
import TopNav from '../components/storefront/layout/TopNav.astro';
import Footer from '../components/storefront/layout/Footer.astro';
import GlobalSearch from '../components/storefront/search/GlobalSearch.svelte';
import CookieBanner from '../components/storefront/CookieBanner.svelte';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Top Brands. Real Prices. No Games.', image } = Astro.props;
const isLoggedIn = !!Astro.locals.user;

// EXPOSE SECURITY VARIABLES GLOBALLY
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
// Fallback gracefully if your middleware hasn't mounted the CSRF token yet
const csrfToken = Astro.locals.csrfToken || 'dev_fallback_csrf_token';
---
<!doctype html>
<html lang="en" class="scroll-smooth w-full">
  <head>
    <MetaTags title={`${title} | Symeno`} description={description} image={image} />
    
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1516" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>

    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=initGlobalSecurity" async defer></script>
  </head>
  <body class="bg-base text-content flex min-h-screen w-full flex-col overflow-x-hidden font-sans antialiased selection:bg-brand/20 selection:text-content">
    
    <TopNav />
    <GlobalSearch client:load />
    <main class="relative flex w-full flex-grow flex-col"><slot /></main>
    <footer class="bg-surface mt-auto"><Footer /></footer>
    <CartDrawer client:load />
    <CookieBanner client:load />
    
    <script is:inline define:vars={{ isLoggedIn }}>window.SYMENO_IS_LOGGED_IN = isLoggedIn;</script>
    <script>
      import { wishlist } from '../stores/wishlist.svelte.ts'; 
      wishlist.init((window as any).SYMENO_IS_LOGGED_IN);
    </script>

    <script is:inline define:vars={{ turnstileSiteKey, csrfToken }}>
      window.PUBLIC_TURNSTILE_SITE_KEY = turnstileSiteKey;
      window.initGlobalSecurity = function() {
        
        // This function wires a single form mathematically
        function secureForm(form) {
          // Skip if we already secured it, or if it is a safe GET request
          if (form.dataset.secured || form.getAttribute('method')?.toUpperCase() !== 'POST') return;
          form.dataset.secured = 'true';

          // A. Inject the Invisible CSRF Shield
          const csrfInput = document.createElement('input');
          csrfInput.type = 'hidden';
          csrfInput.name = 'csrf_token';
          csrfInput.value = csrfToken;
          form.appendChild(csrfInput);

          // B. Inject the Visual Turnstile Shield
          const tsContainer = document.createElement('div');
          tsContainer.className = 'my-4 flex justify-center w-full';
          
          // Find the submit button and insert the widget right above it
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) {
            form.insertBefore(tsContainer, submitBtn);
          } else {
            form.appendChild(tsContainer);
          }

          // C. Explicitly render the widget
          const theme = localStorage.getItem('theme') || 'dark';
          window.turnstile.render(tsContainer, {
            sitekey: turnstileSiteKey,
            theme: theme
          });
        }

        // Phase 1: Secure all forms currently on the page
        document.querySelectorAll('form').forEach(secureForm);

        // Phase 2: The Watcher. If Svelte dynamically loads a form later, catch it and secure it.
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            mutation.addedNodes.forEach((node) => {
              if (node.tagName === 'FORM') {
                secureForm(node);
              } else if (node.querySelectorAll) {
                // If a container was added, look for forms inside it
                node.querySelectorAll('form').forEach(secureForm);
              }
            });
          });
        });

        // Start watching the entire body for structural changes
        observer.observe(document.body, { childList: true, subtree: true });
      };
    </script>
  </body>
</html>