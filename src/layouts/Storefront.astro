              >
            </button>
            <a
              href="/"
              class="group focus-visible:ring-brand flex flex-shrink-0 items-center gap-1 rounded-sm focus-visible:ring-2 focus-visible:outline-none"
            >
              <span
                class="text-content text-2xl font-bold tracking-tighter transition-colors"
