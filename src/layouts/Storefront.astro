---
import '../styles/global.css';
import CartDrawer from '../components/storefront/cart/CartDrawer.svelte';
import MetaTags from '../components/seo/MetaTags.astro';  

import TopNav from '../components/storefront/layout/TopNav.astro';
import Footer from '../components/storefront/layout/Footer.astro';
import GlobalSearch from '../components/storefront/search/GlobalSearch.svelte';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Top Brands. Real Prices. No Games.' } = Astro.props;
const isLoggedIn = !!Astro.locals.user;
---
<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden w-full">
  <head>
    <MetaTags title={`${title} | Symeno`} description={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="bg-base text-content flex min-h-screen w-full flex-col font-sans antialiased">
    <TopNav />
    <GlobalSearch client:load />
    <main class="relative flex w-full flex-grow flex-col"><slot /></main>
    <footer class="bg-surface mt-auto"><Footer /></footer>
    <CartDrawer client:load />
    <script is:inline define:vars={{ isLoggedIn }}>window.SYMENO_IS_LOGGED_IN = isLoggedIn;</script>
    <script>
      import { wishlist } from '../stores/wishlist.svelte'; 
      // Typecast to bypass strict Window interface checking
      wishlist.init((window as any).SYMENO_IS_LOGGED_IN);
    </script>
  </body>
</html>