          <div
            class="text-content-muted mt-4 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest uppercase"
          >
            <span class="flex items-center gap-1"
              ><span class="bg-brand-alert h-1.5 w-1.5 animate-pulse"></span> Trending:</span
            >
            <a
              href="/shop/product/sony-xm5"
              class="hover:text-brand border-outline bg-surface focus-visible:border-brand border px-2 py-1 transition-colors focus-visible:outline-none"
