---
import '../styles/global.css';
import CartBadge from '../components/storefront/cart/CartBadge.svelte';
import CartDrawer from '../components/storefront/cart/CartDrawer.svelte';
// TELEMETRY UPGRADE: Injecting orphaned marketing scripts
import GoogleTag from '../components/analytics/GoogleTag.astro';
import MetaPixel from '../components/analytics/MetaPixel.astro';

// MARKETING & SCALE MATRIX UPGRADES
import SEOHead from '../components/storefront/seo/SEOHead.astro';
import PromoBanner from '../components/storefront/marketing/PromoBanner.svelte';
import NewsletterCapture from '../components/storefront/marketing/NewsletterCapture.svelte';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Top Brands. Real Prices. No Games.' } =
  Astro.props;
const currentYear = new Date().getFullYear();

// SEO Schema Generation for Edge Injection
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Symeno',
  url: 'https://symeno.com',
  description:
    'Operational efficiency applied to consumer electronics. We leverage global arbitrage to secure premium hardware at zero-markup wholesale rates.',
  sameAs: ['https://twitter.com/symeno', 'https://linkedin.com/company/symeno'],
});
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead title={`${title} | Symeno`} description={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline set:html={schema} />

    <GoogleTag id="G-XXXXXXXXXX" part="head" />
    <MetaPixel id="XXXXXXXXXX" part="head" />

    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== 'undefined' &&
          localStorage.getItem('theme')
        ) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      if (typeof localStorage !== 'undefined')
        localStorage.setItem('theme', theme);
    </script>
  </head>

  <body
    class="bg-base text-content selection:bg-brand/20 selection:text-brand flex min-h-screen flex-col font-sans antialiased transition-colors duration-300"
  >
    <PromoBanner client:load />

    <div
      class="bg-surface text-content relative z-50 flex h-10 items-center justify-center transition-colors duration-300"
    >
      <div
        class="flex w-full items-center justify-center gap-3 px-4 font-mono text-[10px] tracking-widest uppercase md:hidden"
      >
        <span
          class="bg-brand h-1.5 w-1.5 animate-[dot-pulse_1.5s_ease-in-out_infinite] rounded-full"
        ></span>
        <span
          >Free Priority Shipping Over <span class="text-brand font-bold"
            >$150</span
          ></span
        >
      </div>

      <div
        class="relative mx-auto hidden h-full w-full max-w-7xl items-center justify-center overflow-hidden md:flex"
        id="announcement-carousel"
      >
        <div
          class="carousel-msg absolute inset-0 z-10 flex items-center justify-center gap-3 font-mono text-xs tracking-widest uppercase opacity-100 transition-opacity duration-500"
        >
          <span
            class="bg-brand h-1.5 w-1.5 animate-[dot-pulse_1.5s_ease-in-out_infinite] rounded-full"
          ></span>
          <span
            >Free priority shipping on orders over <span
              class="text-brand font-bold">$150</span
            >
            <a
              href="/shop"
              class="text-content-muted hover:text-brand hover:decoration-brand focus-visible:ring-brand ml-2 underline decoration-transparent transition-all focus-visible:ring-1 focus-visible:outline-none"
              >Shop Now &rarr;</a
            ></span
          >
        </div>
        <div
          class="carousel-msg absolute inset-0 z-0 flex items-center justify-center gap-3 font-mono text-xs tracking-widest uppercase opacity-0 transition-opacity duration-500"
        >
          <span
            class="bg-brand h-1.5 w-1.5 animate-[dot-pulse_1.5s_ease-in-out_infinite] rounded-full"
          ></span>
          <span
            >Flash Deal: <span class="text-brand font-bold"
              >20% Off Apple Audio</span
            >
            <a
              href="/shop/audio"
              class="text-content-muted hover:text-brand hover:decoration-brand focus-visible:ring-brand ml-2 underline decoration-transparent transition-all focus-visible:ring-1 focus-visible:outline-none"
              >Claim Deal &rarr;</a
            ></span
          >
        </div>
        <div
          class="carousel-msg absolute inset-0 z-0 flex items-center justify-center gap-3 font-mono text-xs tracking-widest uppercase opacity-0 transition-opacity duration-500"
        >
          <span
            class="bg-brand h-1.5 w-1.5 animate-[dot-pulse_1.5s_ease-in-out_infinite] rounded-full"
          ></span>
          <span
            >The Symeno Promise: <span class="text-brand font-bold"
              >14-Day Price Match</span
            >
            <a
              href="/about"
              class="text-content-muted hover:text-brand hover:decoration-brand focus-visible:ring-brand ml-2 underline decoration-transparent transition-all focus-visible:ring-1 focus-visible:outline-none"
              >Read Thesis &rarr;</a
            ></span
          >
        </div>
      </div>
    </div>

    <header
      id="main-nav"
      class="bg-surface/80 sticky top-0 z-40 h-[72px] w-full backdrop-blur-2xl transition-all duration-300 ease-out"
