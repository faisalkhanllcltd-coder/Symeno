---
import '../styles/global.css';

const { title = "Store Admin" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Symeno Admin</title>
  </head>
  <body class="bg-gray-50 min-h-screen flex text-gray-900">
    
    <aside class="w-64 bg-slate-900 text-slate-300 flex-shrink-0 flex flex-col hidden md:flex border-r border-slate-800">
      <div class="h-16 flex items-center px-6 border-b border-slate-800 bg-slate-950">
        <span class="text-white font-black tracking-wider text-lg">SYMENO <span class="text-emerald-500">ADMIN</span></span>
      </div>
      
      <nav class="flex-1 px-4 py-6 space-y-8 overflow-y-auto">
        <div>
          <p class="px-2 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Overview</p>
          <div class="space-y-1">
            <a href="/admin" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Dashboard</a>
            <a href="/admin/analytics" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Analytics</a>
          </div>
        </div>

        <div>
          <p class="px-2 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Catalog</p>
          <div class="space-y-1">
            <a href="/admin/categories" class="block px-3 py-2 rounded-lg bg-emerald-500/10 text-emerald-400 font-medium">Categories</a>
            <a href="/admin/brands" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Brands</a>
            <a href="/admin/products" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Products</a>
            <a href="/admin/inventory" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Inventory</a>
          </div>
        </div>

        <div>
          <p class="px-2 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Sales & CRM</p>
          <div class="space-y-1">
            <a href="/admin/orders" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Orders</a>
            <a href="/admin/customers" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Customers</a>
            <a href="/admin/discounts" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Discounts</a>
          </div>
        </div>
      </nav>

      <div class="p-4 border-t border-slate-800">
        <a href="/admin/settings" class="block px-3 py-2 rounded-lg hover:bg-slate-800 hover:text-white transition-colors text-sm">Store Settings</a>
      </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-end px-8 flex-shrink-0">
        <div class="flex items-center gap-4">
          <span class="text-sm font-medium text-gray-600">Admin Session Active</span>
          <button class="text-sm text-red-600 font-medium hover:text-red-800" onclick="document.cookie='auth_session=;path=/;max-age=0';window.location.href='/auth/login'">Sign Out</button>
        </div>
      </header>
      
      <main class="flex-1 overflow-y-auto p-8">
        <slot />
      </main>
    </div>
  </body>
</html>