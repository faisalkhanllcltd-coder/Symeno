---
import '../styles/global.css';
import AdminSidebar from '../components/admin/layout/AdminSidebar.svelte';
import AdminHeader from '../components/admin/layout/AdminHeader.svelte';

const { title = 'Store Admin' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Symeno Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen bg-base text-content">
    
    <div id="mobile-backdrop" class="fixed inset-0 z-40 hidden bg-black/50 md:hidden"></div>

    <div id="admin-sidebar-wrapper" class="z-50 flex">
      <AdminSidebar currentPath={currentPath} client:load />
    </div>

    <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
      <AdminHeader title={title} client:load />

      <main class="flex-1 overflow-y-auto p-8">
        <slot />
      </main>
    </div>

    <script>
      function setupMobileMenu() {
        const menuBtn = document.querySelector('header button[aria-label="Open Menu"]');
        const sidebar = document.querySelector('#admin-sidebar-wrapper aside');
        const backdrop = document.getElementById('mobile-backdrop');

        if (menuBtn && sidebar && backdrop) {
          const toggleMenu = () => {
            // Force Svelte's hardcoded 'hidden' class off, and inject mobile overlay classes
            sidebar.classList.toggle('hidden');
            sidebar.classList.toggle('flex');
            sidebar.classList.toggle('absolute');
            
            backdrop.classList.toggle('hidden');
          };

          menuBtn.addEventListener('click', toggleMenu);
          backdrop.addEventListener('click', toggleMenu); // Close when clicking outside
        }
      }

      // Initialize on load
      document.addEventListener('DOMContentLoaded', setupMobileMenu);
    </script>
  </body>
</html>