---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CartBadge from '../components/storefront/cart/CartBadge.svelte';
import CartDrawer from '../components/storefront/cart/CartDrawer.svelte';

interface Props {
  title: string;
  currentPath?: string;
}

const { title, currentPath = '/account' } = Astro.props;

// Security Check: Kicks unauthenticated users to login
if (!Astro.locals.user) {
  return Astro.redirect('/auth/login');
}

const navItems = [
  { label: 'Overview', path: '/account', exact: true },
  { label: 'Orders & Returns', path: '/account/orders', exact: false },
  { label: 'Saved Items', path: '/account/wishlist', exact: false },
  { label: 'Addresses', path: '/account/addresses', exact: false },
  { label: 'Settings', path: '/account/settings', exact: false },
];
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | System Operator | Symeno</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <style>
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body
    class="bg-base text-content selection:bg-brand/20 selection:text-brand relative flex min-h-screen flex-col overflow-x-hidden font-sans antialiased transition-colors duration-300"
  >
    <div
      class="pointer-events-none fixed inset-0 z-0 bg-[linear-gradient(var(--color-content)_1px,transparent_1px),linear-gradient(90deg,var(--color-content)_1px,transparent_1px)] bg-[size:32px_32px] opacity-[0.05]"
    >
    </div>

    <header
      class="border-outline bg-surface/90 relative z-20 flex h-[64px] shrink-0 items-center border-b px-4 backdrop-blur-md transition-colors md:px-8"
    >
      <div
        class="from-brand/40 absolute bottom-0 left-0 h-[1px] w-full bg-gradient-to-r via-transparent to-transparent"
      >
      </div>

      <div class="flex-1">
        <a
          href="/"
          class="text-content group text-xl font-bold tracking-tighter focus:outline-none"
        >
          SYMENO<span
            class="text-brand transition-all group-hover:drop-shadow-[0_0_8px_var(--color-brand)]"
            >.</span
          >
        </a>
      </div>

      <div class="hidden flex-1 items-center justify-center gap-2 md:flex">
        <span class="relative flex h-2 w-2"
          ><span
            class="bg-brand absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
          ></span><span
            class="bg-brand relative inline-flex h-2 w-2 rounded-full"
          ></span></span
        >
        <span
          class="text-content-muted font-mono text-[10px] tracking-widest uppercase"
          >Secure Session Active</span
        >
      </div>

      <div
        class="flex flex-1 items-center justify-end gap-4 text-sm font-medium md:gap-6"
      >
        <a
          href="/shop"
          class="text-content-muted hover:text-brand hidden font-mono text-xs tracking-widest uppercase transition-colors focus:outline-none md:block"
          >Storefront &rarr;</a
        >

        <CartBadge client:load />

        <form
          action="/api/auth/logout"
          method="POST"
          id="logout-form"
          data-astro-reload
        >
          <button
            type="submit"
            class="text-content-muted hover:text-brand-alert font-mono text-[10px] font-bold tracking-widest uppercase transition-colors focus:outline-none md:text-xs"
            >Terminate</button
          >
        </form>
      </div>
    </header>

    <nav
      class="border-outline bg-base no-scrollbar relative sticky top-0 z-10 w-full overflow-x-auto border-b transition-colors md:hidden"
    >
      <ul class="flex snap-x snap-mandatory whitespace-nowrap">
        {
          navItems.map((item) => {
            const isActive = item.exact
              ? currentPath === item.path
              : currentPath.includes(item.path);
            return (
              <li class="snap-start">
                <a
                  href={item.path}
                  class={`block border-b-2 px-5 py-4 text-xs font-bold tracking-widest uppercase transition-colors ${isActive ? 'text-brand border-brand' : 'text-content-muted hover:text-content border-transparent'}`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div
      class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col md:flex-row"
    >
      <aside
        class="bg-base border-outline hidden min-h-[calc(100vh-64px)] w-[240px] shrink-0 border-r py-8 transition-colors md:block"
      >
        <ul class="space-y-2 px-4">
          <li
            class="border-outline text-content-muted mb-4 border-b px-4 pb-4 font-mono text-[10px] tracking-widest uppercase"
          >
            Operator Matrix
          </li>
          {
            navItems.map((item) => {
              const isActive = item.exact
                ? currentPath === item.path
                : currentPath.includes(item.path);
              return (
                <li>
                  <a
                    href={item.path}
                    class={`group flex items-center px-4 py-3 text-xs font-bold tracking-widest uppercase transition-all ${isActive ? 'bg-surface text-content border-brand border-l-2' : 'text-content-muted hover:bg-surface hover:text-content hover:border-outline border-l-2 border-transparent'}`}
                  >
                    <span
                      class={`mr-3 font-mono ${isActive ? 'text-brand' : 'group-hover:text-content-muted text-transparent'}`}
                    >
                      &gt;
                    </span>
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </aside>

      <main class="w-full max-w-full flex-1 overflow-hidden">
        <div class="mx-auto max-w-[860px] px-4 py-8 md:px-12 md:py-12">
          <slot />
        </div>
      </main>
    </div>

    <footer
      class="border-outline bg-base relative z-10 mt-auto shrink-0 border-t py-6 transition-colors"
    >
      <div
        class="text-content-muted mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 font-mono text-[10px] tracking-widest uppercase md:flex-row md:px-8"
      >
        <p>&copy; {currentYear} Symeno LLC. Internal Systems.</p>
        <nav class="flex gap-6">
          <a
            href="/policies/privacy"
            class="hover:text-content transition-colors focus:outline-none"
            >Privacy</a
          ><a
            href="/policies/terms"
            class="hover:text-content transition-colors focus:outline-none"
            >Terms</a
          ><a
            href="/contact"
            class="hover:text-brand transition-colors focus:outline-none"
            >Support Ping</a>
        </nav>
      </div>
    </footer>

    <CartDrawer client:load />
  </body>
</html>
