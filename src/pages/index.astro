---
import { env } from "cloudflare:workers";
import StorefrontLayout from '../layouts/Storefront.astro';
import Hero from '../components/storefront/Hero.astro';   
import TrustBar from '../components/storefront/TrustBar.astro';
import CategoryGrid from '../components/storefront/CategoryGrid.astro';
import Manifesto from '../components/storefront/Manifesto.astro';
import FeaturedProducts from '../components/storefront/FeaturedProducts.astro';
import Testimonials from '../components/storefront/Testimonials.astro';
import Newsletter from '../components/storefront/Newsletter.astro';
import BrandStory from '../components/storefront/BrandStory.astro';

export const prerender = false;

let featured: any[] = [];
let heroDeal: any = null;
let storeCategories: any[] = [];

try {
  // ARMOR: Fallback to Astro.locals if standard env binding drops
  const db = (env.DB as any) || (Astro.locals as any).runtime?.env?.DB;

  if (db) {
    const { results: productResults } = await db.prepare("SELECT * FROM catalog_cache WHERE in_stock = 1 LIMIT 10").all();

    const mappedProducts = productResults.map((p: any) => {
      let firstImage = '';
      try {
        if (p.images_json) {
          const parsed = JSON.parse(p.images_json);
          if (parsed.length > 0) firstImage = parsed[0];
        }
      } catch(e) {}

      return {     
        id: p.id,
        slug: p.slug || p.id, 
        brand: p.brand || 'Symeno Select',
        title: p.name, 
        name: p.name,
        description: p.description || p.name,
        basePrice: p.price || 0, 
        price: p.price || 0,
        retailPrice: p.price ? p.price * 1.15 : 0, 
        in_stock: p.in_stock,
        images: firstImage ? [firstImage] : ['/assets/placeholders/product-unavailable.webp'],
      };
    });

    if (mappedProducts.length > 0) {
      heroDeal = mappedProducts[0];
      featured = mappedProducts.slice(1, 5);
    }

    const { results: catResults } = await db.prepare(`
      SELECT 
        category as name, 
        COUNT(id) as count, 
        MAX(images_json) as rawImage,
        MAX(price) as maxBase,
        MIN(price) as minBase
      FROM catalog_cache 
      WHERE category IS NOT NULL
      GROUP BY category 
      ORDER BY count DESC 
      LIMIT 6
    `).all();

    storeCategories = catResults.map((c: any) => {
      const maxR = c.maxBase ? c.maxBase * 1.15 : 0;
      const minB = c.minBase || 0;
      const discountCalc = maxR > minB ? Math.floor(((maxR - minB) / maxR) * 100) : 15;
      
      let catImage = '';
      try {
        if (c.rawImage) {
          const parsed = JSON.parse(c.rawImage);
          if (parsed.length > 0) catImage = parsed[0];
        }
      } catch(e) {}

      return {
        name: c.name,
        slug: c.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, ''),
        count: c.count,
        image: catImage,
        discount: `Up to ${discountCalc}% off`,
        lowStock: c.count < 5
      };
    });
  }
} catch (e) {
  console.error('[HOMEPAGE_D1_ERROR]', e);
}
---

<StorefrontLayout
  title="Curated Premium Goods | Symeno"
  description="Skip the retail markup. We secure premium lifestyle, home, and tech goods in volume so you pay strictly wholesale prices."
>
  <Hero deal={heroDeal} />
  <TrustBar />
  <CategoryGrid categories={storeCategories} />
  <BrandStory />
  <Manifesto />
  <FeaturedProducts products={featured} />
  <Testimonials />
  <Newsletter />
</StorefrontLayout>