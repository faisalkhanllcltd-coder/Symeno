---
import { env } from "cloudflare:workers";
import StorefrontLayout from '../layouts/Storefront.astro';
import Hero from '../components/storefront/Hero.astro';   
import TrustBar from '../components/storefront/TrustBar.astro';
import CategoryGrid from '../components/storefront/CategoryGrid.astro';
import Manifesto from '../components/storefront/Manifesto.astro';
import FeaturedProducts from '../components/storefront/FeaturedProducts.astro';
import NewsletterCapture from '../components/storefront/marketing/NewsletterCapture.svelte';
import BrandStory from '../components/storefront/BrandStory.astro';

export const prerender = false;

let featured: any[] = [];
let heroDeal: any = null;
let storeCategories: any[] = [];

try {
  // ARMOR: Fallback to Astro.locals if standard env binding drops
  const db = (env.DB as any) || (Astro.locals as any).runtime?.env?.DB;

  if (db) {
    // We pull extra rows (15 instead of 10) so we have backup inventory if we filter things out
    const { results: productResults } = await db.prepare("SELECT * FROM catalog_cache WHERE in_stock = 1 LIMIT 15").all();

    // FIXED: Removed restricted strings to comply with underwriting
    const HOMEPAGE_BLACKLIST = ['test_dummy_product_string'];

    const mappedProducts = productResults
      .map((p: any) => {
        let firstImage = '';
        try {
          if (p.images_json) {
            const parsed = JSON.parse(p.images_json);
            if (parsed.length > 0) firstImage = parsed[0];
          }
        } catch(e) {}

        return {     
          id: p.id,
          slug: p.slug || p.id, 
          brand: p.brand || 'Symeno Select',
          title: p.name, 
          name: p.name,
          description: p.description || p.name,
          basePrice: p.price || 0, 
          price: p.price || 0,
          retailPrice: p.price ? p.price * 1.15 : 0, 
          in_stock: p.in_stock,
          images: firstImage ? [firstImage] : ['/assets/placeholders/product-unavailable.webp'],
        };
      })
      // Intercept and purge bad products before they hit the UI
      .filter((product: any) => {
        const titleLower = product.name.toLowerCase();
        return !HOMEPAGE_BLACKLIST.some(badWord => titleLower.includes(badWord));
      });

    if (mappedProducts.length > 0) {
      heroDeal = mappedProducts[0];
      // Safely slice the next 4 products for the grid
      featured = mappedProducts.slice(1, 5);
    }

    const { results: catResults } = await db.prepare(`
      SELECT 
        category as name, 
        COUNT(id) as count, 
        MAX(images_json) as rawImage,
        MAX(price) as maxBase,
        MIN(price) as minBase
      FROM catalog_cache 
      WHERE category IS NOT NULL
      GROUP BY category 
      ORDER BY count DESC 
      LIMIT 6
    `).all();

    storeCategories = catResults.map((c: any) => {
      const maxR = c.maxBase ? c.maxBase * 1.15 : 0;
      const minB = c.minBase || 0;
      const discountCalc = maxR > minB ? Math.floor(((maxR - minB) / maxR) * 100) : 15;
      
      let catImage = '';
      try {
        if (c.rawImage) {
          const parsed = JSON.parse(c.rawImage);
          if (parsed.length > 0) catImage = parsed[0];
        }
      } catch(e) {}

      return {
        name: c.name,
        slug: c.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, ''),
        count: c.count,
        image: catImage,
        discount: `Up to ${discountCalc}% off`,
        lowStock: c.count < 5
      };
    });
  }
} catch (e) {
  console.error('[HOMEPAGE_D1_ERROR]', e);
}
---

<StorefrontLayout
  title="Curated Premium Goods | Symeno"
  description="Shop premium lifestyle, tech, and home goods at competitive prices. Symeno sources from established wholesale distributors so you get quality brands without overpaying."
>
  <Hero deal={heroDeal} />
  <TrustBar />
  <CategoryGrid categories={storeCategories} />
  <BrandStory />
  <Manifesto />
  <FeaturedProducts products={featured} />
  
  <section class="relative w-full overflow-hidden border-t border-outline bg-base py-24">
    <div class="pointer-events-none absolute top-1/2 left-1/2 z-0 h-[400px] w-[400px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand opacity-[0.02] blur-[80px]"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-4 text-center" id="home-newsletter-override">
      
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-content md:text-4xl">
        Secure Comm Channel.
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-lg font-light text-content-muted">
        Get early access to new arrivals, exclusive deals, and restocks before they sell out.
      </p>

      <div class="mx-auto flex w-full max-w-lg justify-center">
        <NewsletterCapture client:load />
      </div>

      <p class="mt-8 font-mono text-[10px] tracking-[0.2em] text-content-muted uppercase">
        Zero Spam &middot; Encrypted Data &middot; Unsubscribe Anytime
      </p>
    </div>
  </section>
  
</StorefrontLayout>

<style is:global>
  /* * SURGICAL UI OVERRIDE: SHOPIFY/AMAZON NESTED BUTTON
   * Transmutes the standalone form into a premium, unified input box
   * with a perfectly nested action button. Isolated to the homepage.
   */

  /* 1. Hide Svelte's native title and description */
  #home-newsletter-override h3,
  #home-newsletter-override p.text-content-muted.text-\[10px\] {
    display: none !important;
  }

  /* 2. Clear width constraints */
  #home-newsletter-override > div {
    max-width: 100% !important;
    width: 100% !important;
  }

  /* 3. The Outer Wrapper becomes the "Box" */
  #home-newsletter-override form > div.relative {
    display: flex !important;
    position: relative !important;
    width: 100% !important;
    height: 3.5rem !important; /* Premium touch-target height */
    background-color: var(--color-surface, #1a1a1a) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 0.375rem !important;
    overflow: hidden !important;
    transition: border-color 0.2s ease !important;
    flex-direction: row !important; /* Forces row alignment even on mobile */
    gap: 0 !important;
  }

  /* Focus ring applied to the parent wrapper for a unified look */
  #home-newsletter-override form > div.relative:focus-within {
    border-color: var(--color-brand) !important;
    box-shadow: 0 0 0 1px var(--color-brand) !important;
  }

  /* 4. The Transparent Input Field */
  #home-newsletter-override input {
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
    border: none !important;
    /* Right padding ensures text slides under the button, not through it */
    padding: 0 110px 0 1.25rem !important; 
    font-size: 1rem !important; /* 16px absolutely required to prevent iOS auto-zoom */
    color: var(--color-content) !important;
    outline: none !important;
    box-shadow: none !important;
  }

  @media (min-width: 640px) {
    #home-newsletter-override input {
      padding-right: 140px !important; /* Wider padding for larger desktop button */
    }
  }

  /* 5. The Perfectly Nested Action Button */
  #home-newsletter-override button {
    position: absolute !important;
    top: 0.375rem !important;
    bottom: 0.375rem !important;
    right: 0.375rem !important;
    margin: 0 !important;
    width: auto !important;
    padding: 0 1rem !important;
    background-color: var(--color-brand) !important;
    color: #000 !important; /* High contrast dark text */
    font-size: 0.75rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    border: none !important;
    border-radius: 0.25rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: transform 0.1s ease, opacity 0.2s ease !important;
  }

  @media (min-width: 640px) {
    #home-newsletter-override button {
      font-size: 0.875rem !important;
      padding: 0 1.5rem !important;
    }
  }

  #home-newsletter-override button:hover:not(:disabled) {
    opacity: 0.9 !important;
    transform: scale(0.98) !important;
  }

  #home-newsletter-override button:disabled {
    opacity: 0.5 !important;
    cursor: not-allowed !important;
  }

  /* 6. Centering Turnstile & Messages */
  #home-newsletter-override .cf-turnstile,
  #home-newsletter-override iframe {
    margin: 1rem auto 0 !important;
  }

  #home-newsletter-override p.animate-fade-in {
    text-align: center !important;
    font-size: 0.75rem !important;
    margin-top: 1rem !important;
  }
</style>