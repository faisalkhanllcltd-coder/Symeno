---
import { env } from "cloudflare:workers";
import StorefrontLayout from '../layouts/Storefront.astro';
import Hero from '../components/storefront/Hero.astro';   
import TrustBar from '../components/storefront/TrustBar.astro';
import CategoryGrid from '../components/storefront/CategoryGrid.astro';
import Manifesto from '../components/storefront/Manifesto.astro';
import FeaturedProducts from '../components/storefront/FeaturedProducts.astro';
import DealTicker from '../components/storefront/DealTicker.astro';
import Testimonials from '../components/storefront/Testimonials.astro';
import Newsletter from '../components/storefront/Newsletter.astro';
import BrandStory from '../components/storefront/BrandStory.astro';

export const prerender = false;

let featured: any[] = [];
let dynamicDeals: string[] = [];
let heroDeal: any = null;
let storeCategories: any[] = []; // NEW: Array to hold real DB categories

const cities = ['London, UK', 'Dubai, UAE', 'Toronto, CA', 'New York, US', 'Sydney, AU'];

try {
  // ASTRO V6 D1 CONNECTION
  const db = env.DB as any;

  if (db) {
    // ----------------------------------------------------
    // QUERY 1: FETCH TOP PRODUCTS
    // ----------------------------------------------------
    const { results: productResults } = await db.prepare("SELECT * FROM rapidapi_cache WHERE stockStatus = 'IN_STOCK' LIMIT 10").all();

    const mappedProducts = productResults.map((p: any) => ({     
      id: p.id,
      slug: p.slug,
      brand: p.brand || 'Symeno Select',
      title: p.title,
      description: p.description || p.title,
      basePrice: p.basePrice,
      retailPrice: p.retailPrice, 
      stockStatus: p.stockStatus,
      images: p.image_url ? [p.image_url] : [],
    }));

    if (mappedProducts.length > 0) {
      heroDeal = mappedProducts[0];
      featured = mappedProducts.slice(1, 5);
    }

    dynamicDeals = mappedProducts
      .slice(0, 5)
      .map((p: any, i: number) => {
        const city = cities[i % cities.length];
        const savings = p.retailPrice && p.retailPrice > p.basePrice 
          ? Math.floor(p.retailPrice - p.basePrice) 
          : Math.floor(p.basePrice * 0.2);
        return `${city} — A customer just saved $${savings} on ${p.brand} goods`;
      });

    // ----------------------------------------------------
    // QUERY 2: AGGREGATE REAL CATEGORIES
    // ----------------------------------------------------
    const { results: catResults } = await db.prepare(`
      SELECT 
        category as name, 
        categorySlug as slug, 
        COUNT(id) as count, 
        MAX(image_url) as image,
        MAX(retailPrice) as maxRetail,
        MIN(basePrice) as minBase
      FROM rapidapi_cache 
      WHERE category IS NOT NULL AND categorySlug IS NOT NULL
      GROUP BY category, categorySlug 
      ORDER BY count DESC 
      LIMIT 6
    `).all();

    storeCategories = catResults.map((c: any) => {
      const maxR = c.maxRetail || 0;
      const minB = c.minBase || 0;
      // Calculate real discount margin based on DB max/min prices
      const discountCalc = maxR > minB ? Math.floor(((maxR - minB) / maxR) * 100) : 25;
      
      return {
        name: c.name,
        slug: c.slug,
        count: c.count,
        image: c.image,
        discount: `${discountCalc}%`,
        lowStock: c.count < 5 // Dynamically flags if inventory is less than 5
      };
    });
  }
} catch (e) {
  console.error('[HOMEPAGE_D1_ERROR]', e);
}

if (dynamicDeals.length === 0) {
  dynamicDeals.push('Global — Customers are saving up to 40% on premium goods daily');
}
---

<StorefrontLayout
  title="Premium Goods. Real Prices."
  description="We buy in volume so you pay less. Aggregate pricing across premium categories."
>
  <Hero deal={heroDeal} />
  <TrustBar />
  <!-- Passing the real D1 data to the Category Grid -->
  <CategoryGrid categories={storeCategories} />
  <BrandStory />
  <Manifesto />
  <FeaturedProducts products={featured} />
  <DealTicker deals={dynamicDeals} />
  <Testimonials />
  <Newsletter />
</StorefrontLayout>