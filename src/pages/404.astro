---
import StorefrontLayout from '../layouts/Storefront.astro';
---

<StorefrontLayout
  title="404: Node Not Found | Symeno"
  description="System error. The requested hardware node does not exist."
>
  <div
    class="bg-base relative flex min-h-[70vh] flex-col items-center justify-center overflow-hidden px-4 transition-colors duration-300"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(var(--color-content)_1px,transparent_1px),linear-gradient(90deg,var(--color-content)_1px,transparent_1px)] bg-[size:32px_32px] opacity-[0.05]"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-2xl text-center">
      <div
        class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert mb-8 inline-block border px-3 py-1 text-[10px] font-bold tracking-widest uppercase shadow-[0_0_15px_var(--color-brand-alert)]"
      >
        Error Code: 404
      </div>

      <h1
        class="text-content mb-4 text-6xl font-bold tracking-tighter uppercase drop-shadow-[0_0_10px_rgba(255,255,255,0.1)] md:text-8xl"
      >
        Dead <span class="text-brand-alert">End.</span>
      </h1>

      <p
        class="text-content-muted mb-10 font-mono text-base leading-relaxed md:text-lg"
      >
        The requested logistics node cannot be located. The hardware shipment
        may have been re-routed, or the URL parameters are invalid.
      </p>

      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/deals"
          class="bg-brand text-brand-dark w-full px-8 py-4 text-xs font-bold tracking-widest uppercase shadow-[0_0_15px_var(--color-brand)] transition-all duration-300 hover:opacity-80 focus:outline-none sm:w-auto"
        >
          Scan Live Deals &rarr;
        </a>
        <a
          href="/shop"
          class="border-outline text-content hover:border-brand hover:text-brand w-full border bg-transparent px-8 py-4 text-xs font-bold tracking-widest uppercase transition-all duration-300 focus:outline-none sm:w-auto"
        >
          Return to Catalog
        </a>
      </div>
    </div>
  </div>
</StorefrontLayout>
