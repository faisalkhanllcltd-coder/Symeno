---
import AccountLayout from '../../layouts/Account.astro';
import WishlistGrid from '../../components/storefront/account/WishlistGrid.svelte';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

// Simple hash generator for the share ID based on user ID (Deterministic, URL-safe)
const generateShareId = (id: string) =>
  Buffer.from(id)
    .toString('base64')
    .replace(/[^a-zA-Z0-9]/g, '')
    .substring(0, 12);
const shareId = generateShareId(user.id);

let wishlistItems = [];
if (env.DB) {
  try {
    const { results } = await env.DB.prepare(
      `
      SELECT w.id, w.product_id, w.notify_price_drop, w.notify_restock,
             p.title, p.slug, p.base_price, p.image_url, 
             COALESCE(v.inventory_quantity, 0) as stock
      FROM wishlists w
      JOIN products p ON w.product_id = p.id
      LEFT JOIN product_variants v ON p.id = v.product_id AND v.is_default = 1
      WHERE w.customer_id = ?1
      ORDER BY w.created_at DESC
    `
    )
      .bind(user.id)
      .all();
    wishlistItems = results || [];
  } catch (e) {}
}
---

<AccountLayout title="Wishlist & Saves" currentPath="/account/wishlist">
  <div class="mx-auto max-w-5xl space-y-6">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-xl font-bold tracking-widest text-white uppercase">
        Saved Inventory
      </h1>
      <p class="mt-1 font-mono text-xs text-white/50">
        Manage your hardware pipeline and alerts.
      </p>
    </div>

    <WishlistGrid client:load initialItems={wishlistItems} shareId={shareId} />
  </div>
</AccountLayout>
