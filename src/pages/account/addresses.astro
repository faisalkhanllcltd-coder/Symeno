---
import AccountLayout from '../../layouts/Account.astro';
import AddressManager from '../../components/account/AddressManager.svelte';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

let savedAddresses: any[] = [];
if (env.DB) {
  try {
    const { results } = await env.DB.prepare(
      `
      SELECT id, customer_id, label, full_name, phone, country, state, city, line1, line2, landmark, is_default FROM addresses 
      WHERE customer_id = ?1 
      ORDER BY is_default DESC, created_at DESC
    `
    )
      .bind(user.id)
      .all();
    savedAddresses = results || [];
  } catch (e) {}
}
---

<AccountLayout title="Saved Addresses" currentPath="/account/addresses">
  <div class="mx-auto max-w-5xl space-y-6">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-xl font-bold tracking-widest text-white uppercase">
        Logistics Hub
      </h1>
      <p class="mt-1 font-mono text-xs text-white/50">
        Manage delivery vectors and dispatch locations.
      </p>
    </div>

    <AddressManager client:load initialAddresses={savedAddresses} />
  </div>
</AccountLayout>
