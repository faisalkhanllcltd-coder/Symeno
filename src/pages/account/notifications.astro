---
import AccountLayout from '../../layouts/Account.astro';
import NotificationInbox from '../../components/storefront/account/notifications/NotificationInbox.svelte';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

let notificationsData = [];

if (env.DB) {
  try {
    const { results } = await env.DB.prepare(`
      SELECT id, type, title, message, COALESCE(is_read, 0) as is_read, action_url, created_at 
      FROM customer_notifications 
      WHERE customer_id = ?1 
      ORDER BY is_read ASC, created_at DESC 
      LIMIT 50
    `).bind(user.id).all();
    
    notificationsData = results || [];
  } catch (e) {}
}
---

<AccountLayout title="Notification Matrix" currentPath="/account/notifications">
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-xl font-bold text-white uppercase tracking-widest">Telemetry & Alerts</h1>
      <p class="text-xs text-white/50 font-mono mt-1">Operational updates, logistics tracking, and matrix broadcasts.</p>
    </div>
    
    <NotificationInbox client:load initialNotifications={notificationsData} />
  </div>
</AccountLayout>