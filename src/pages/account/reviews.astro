---
import AccountLayout from '../../layouts/Account.astro';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

let myReviews = [];
if (env.DB) {
  try {
    const { results } = await env.DB.prepare(
      `
      SELECT r.id, r.rating, r.title, r.status, r.created_at, p.title as product_title, p.slug
      FROM reviews r
      JOIN products p ON r.product_id = p.id
      WHERE r.customer_id = ?1
      ORDER BY r.created_at DESC
    `
    )
      .bind(user.id)
      .all();
    myReviews = results || [];
  } catch (e) {}
}

const renderStars = (rating: number) =>
  '★'.repeat(rating) + '☆'.repeat(5 - rating);
---

<AccountLayout title="My Field Reports" currentPath="/account/reviews">
  <div class="mx-auto max-w-4xl space-y-6">
    <div class="border-b border-outline pb-4">
      <h1 class="text-xl font-bold tracking-widest text-content uppercase">
        Submitted Reports
      </h1>
      <p class="mt-1 font-mono text-xs text-content-muted">
        Manage your product evaluations.
      </p>
    </div>

    <div class="space-y-4">
      {
        myReviews.map((review) => (
          <div class="flex flex-col justify-between gap-6 border border-outline bg-base p-6 transition-colors hover:border-brand/30 sm:flex-row">
            <div class="flex-1">
              <div class="mb-2 flex items-center gap-3">
                <span class="text-sm tracking-widest text-amber-400">
                  {renderStars(review.rating)}
                </span>
                {review.status === 'APPROVED' ? (
                  <span class="border border-brand/30 bg-brand/10 px-2 py-0.5 text-[9px] tracking-widest text-brand uppercase">
                    Published
                  </span>
                ) : review.status === 'REJECTED' ? (
                  <span class="border border-brand-alert/30 bg-brand-alert/10 px-2 py-0.5 text-[9px] tracking-widest text-brand-alert uppercase">
                    Rejected
                  </span>
                ) : (
                  <span class="border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[9px] tracking-widest text-amber-400 uppercase">
                    Pending Review
                  </span>
                )}
              </div>
              <h3 class="mb-1 text-sm font-bold text-content">{review.title}</h3>
              <p class="mb-2 font-mono text-[10px] text-content-muted">
                For:{' '}
                <a
                  href={`/shop/product/${review.slug}`}
                  class="text-brand hover:underline"
                >
                  {review.product_title}
                </a>
              </p>
            </div>
            <div class="flex flex-col items-end justify-between text-right">
              <span class="font-mono text-[10px] text-content-muted">
                {new Date(review.created_at).toLocaleDateString()}
              </span>
            </div>
          </div>
        ))
      }

      {
        myReviews.length === 0 && (
          <div class="border border-outline bg-base p-12 text-center">
            <p class="font-mono text-xs text-content-muted uppercase">
              No field reports submitted.
            </p>
          </div>
        )
      }
    </div>
  </div>
</AccountLayout>
