---
import AccountLayout from '../../layouts/Account.astro';
import AccountSettingsOrchestrator from '../../components/storefront/account/settings/AccountSettingsOrchestrator.svelte';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
---

<AccountLayout title="Identity & Security" currentPath="/account/settings">
  <div class="mx-auto max-w-6xl space-y-8">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-xl font-bold tracking-widest text-white uppercase">
        Configuration Matrix
      </h1>
      <p class="mt-1 font-mono text-xs text-white/50">
        Control your identity, security parameters, and telemetry preferences.
      </p>
    </div>

    <AccountSettingsOrchestrator client:load user={user} />
  </div>
</AccountLayout>
