---
import AccountLayout from '../../layouts/Account.astro';
import OrderListManager from '../../components/storefront/account/OrderListManager.svelte';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

let orders = [];
if (env.DB) {
  try {
    const { results } = await env.DB.prepare(
      'SELECT id, created_at, status, total, tracking_url FROM orders WHERE customer_id = ? ORDER BY created_at DESC'
    )
      .bind(user.id)
      .all();
    orders = results || [];
  } catch (e) {}
}
---

<AccountLayout title="Order Ledger" currentPath="/account/orders">
  <div class="mx-auto max-w-4xl space-y-6">
    <div class="flex items-end justify-between border-b border-white/10 pb-4">
      <div>
        <h1 class="text-xl font-bold tracking-widest text-white uppercase">
          Transaction Ledger
        </h1>
        <p class="mt-1 font-mono text-xs text-white/50">
          Review your operational history
        </p>
      </div>
    </div>

    <OrderListManager client:load orders={orders} />
  </div>
</AccountLayout>
