---
import AccountLayout from '../../../layouts/Account.astro';
import CustomerOrderTimeline from '../../../components/storefront/account/CustomerOrderTimeline.svelte';
import ReorderButton from '../../../components/storefront/account/ReorderButton.svelte';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

const { id } = Astro.params;
let order = null;

if (env.DB) {
  try {
    order = await env.DB.prepare("SELECT * FROM orders WHERE id = ? AND customer_id = ?").bind(id, user.id).first();
  } catch (e) {}
}

if (!order) return Astro.redirect('/404');
---

<AccountLayout title={`Order #${id.substring(0,8)}`} currentPath="/account/orders">
  <div class="max-w-4xl mx-auto space-y-8">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-white/10 pb-6">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-xl font-bold text-white uppercase tracking-widest font-mono">#{id.substring(0,8)}</h1>
          <span class="text-[9px] px-2 py-0.5 uppercase tracking-widest border border-white/10 text-white/70">{order.status}</span>
        </div>
        <p class="text-xs text-white/50 font-mono mt-1">Placed on {new Date(order.created_at).toLocaleDateString()}</p>
      </div>
      <div class="flex gap-3 w-full md:w-auto">
        <a href={`/api/account/orders/${id}/invoice`} target="_blank" class="flex-1 md:flex-none text-center px-4 py-2 border border-white/10 text-white/70 hover:text-white text-[10px] font-mono uppercase tracking-widest transition-colors">Get Invoice</a>
      </div>
    </div>

    <div class="bg-[#111318] border border-white/10 p-6 mb-8 hidden sm:block">
      <CustomerOrderTimeline client:load status={order.status} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="md:col-span-2 space-y-6">
        <div class="bg-[#111318] border border-white/10 p-6">
          <h2 class="text-xs font-bold uppercase tracking-widest text-white/50 font-mono mb-4 border-b border-white/10 pb-2">Manifest</h2>
          <div class="space-y-4">
            <div class="flex gap-4 items-center">
              <div class="w-16 h-16 bg-[#1A1D23] border border-white/5"></div>
              <div class="flex-1">
                <h3 class="text-sm font-bold text-white">Example Product Name</h3>
                <p class="text-[10px] font-mono text-white/40 mt-0.5">Variant: Default</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-[#36f4a4] font-mono">${order.total.toFixed(2)}</p>
                <p class="text-[10px] font-mono text-white/40">Qty: 1</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-[#111318] border border-white/10 p-6">
          <h2 class="text-xs font-bold uppercase tracking-widest text-white/50 font-mono mb-4 border-b border-white/10 pb-2">Logistics</h2>
          <p class="text-xs text-white/80 font-mono whitespace-pre-wrap">{order.shipping_address || 'No address provided.'}</p>
        </div>

        <div class="bg-[#111318] border border-white/10 p-6">
          <h2 class="text-xs font-bold uppercase tracking-widest text-white/50 font-mono mb-4 border-b border-white/10 pb-2">Summary</h2>
          <div class="space-y-2 text-xs font-mono">
            <div class="flex justify-between text-white/70"><span>Subtotal</span><span>${order.total.toFixed(2)}</span></div>
            <div class="flex justify-between text-white/70"><span>Shipping</span><span>$0.00</span></div>
            <div class="flex justify-between text-white font-bold pt-2 border-t border-white/5"><span>Total</span><span class="text-[#36f4a4]">${order.total.toFixed(2)}</span></div>
          </div>
        </div>

        <ReorderButton client:load orderId={id} />
      </div>

    </div>

  </div>
</AccountLayout>