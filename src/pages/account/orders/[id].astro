---
import AccountLayout from '../../../layouts/Account.astro';
import CustomerOrderTimeline from '../../../components/account/CustomerOrderTimeline.svelte';
import ReorderButton from '../../../components/account/ReorderButton.svelte';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

const id = Astro.params.id as string;
let order = null;

if (env.DB) {
  try {
    order = await env.DB.prepare(
      'SELECT id, status, created_at, amount_total, total_amount, shipping_address FROM orders WHERE id = ? AND customer_id = ?'
    )
      .bind(id, user.id)
      .first();
  } catch (e) {}
}

if (!order) return Astro.redirect('/404');
---

<AccountLayout
  title={`Order #${id.substring(0, 8)}`}
  currentPath="/account/orders"
>
  <div class="mx-auto max-w-4xl space-y-8">
    <div
      class="flex flex-col items-start justify-between gap-4 border-b border-outline pb-6 md:flex-row md:items-center"
    >
      <div>
        <div class="flex items-center gap-3">
          <h1
            class="font-mono text-xl font-bold tracking-widest text-content uppercase"
          >
            #{id.substring(0, 8)}
          </h1>
          <span
            class="border border-outline px-2 py-0.5 text-[9px] tracking-widest text-content-muted uppercase"
            >{(order as any).status}</span
          >
        </div>
        <p class="mt-1 font-mono text-xs text-content-muted">
          Placed on {new Date((order as any).created_at).toLocaleDateString()}
        </p>
      </div>
      <div class="flex w-full gap-3 md:w-auto">
        <a
          href={`/api/account/orders/${id}/invoice`}
          target="_blank"
          class="flex-1 border border-outline px-4 py-2 text-center font-mono text-[10px] tracking-widest text-content-muted uppercase transition-colors hover:text-content md:flex-none"
          >Get Invoice</a
        >
      </div>
    </div>

    <div class="mb-8 hidden border border-outline bg-base p-6 sm:block">
      <CustomerOrderTimeline client:load status={(order as any).status} />
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="space-y-6 md:col-span-2">
        <div class="border border-outline bg-base p-6">
          <h2
            class="mb-4 border-b border-outline pb-2 font-mono text-xs font-bold tracking-widest text-content-muted uppercase"
          >
            Manifest
          </h2>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="h-16 w-16 border border-outline bg-surface"></div>
              <div class="flex-1">
                <h3 class="text-sm font-bold text-content">
                  Example Product Name
                </h3>
                <p class="mt-0.5 font-mono text-[10px] text-content-muted">
                  Variant: Default
                </p>
              </div>
              <div class="text-right">
                <p class="font-mono text-sm font-bold text-brand">
                  ${(order as any).total.toFixed(2)}
                </p>
                <p class="font-mono text-[10px] text-content-muted">Qty: 1</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="border border-outline bg-base p-6">
          <h2
            class="mb-4 border-b border-outline pb-2 font-mono text-xs font-bold tracking-widest text-content-muted uppercase"
          >
            Logistics
          </h2>
          <p class="font-mono text-xs whitespace-pre-wrap text-content">
            {(order as any).shipping_address || 'No address provided.'}
          </p>
        </div>

        <div class="border border-outline bg-base p-6">
          <h2
            class="mb-4 border-b border-outline pb-2 font-mono text-xs font-bold tracking-widest text-content-muted uppercase"
          >
            Summary
          </h2>
          <div class="space-y-2 font-mono text-xs">
            <div class="flex justify-between text-content-muted">
              <span>Subtotal</span><span>${(order as any).total.toFixed(2)}</span>
            </div>
            <div class="flex justify-between text-content-muted">
              <span>Shipping</span><span>$0.00</span>
            </div>
            <div
              class="flex justify-between border-t border-outline pt-2 font-bold text-content"
            >
              <span>Total</span><span class="text-brand"
                >${(order as any).total.toFixed(2)}</span>
            </div>
          </div>
        </div>

        <ReorderButton client:load orderId={id} />
      </div>
    </div>
  </div>
</AccountLayout>
