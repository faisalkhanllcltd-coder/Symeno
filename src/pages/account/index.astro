---
import AccountLayout from '../../layouts/Account.astro';
import DynamicGreeting from '../../components/account/DynamicGreeting.svelte';
import DashboardStats from '../../components/account/DashboardStats.svelte';
import RecentOrdersWidget from '../../components/account/RecentOrdersWidget.svelte';
import AccountQuickLinks from '../../components/account/AccountQuickLinks.svelte';
import { env } from 'cloudflare:workers';

// --- SERVER-SIDE AUTHENTICATION GATE ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}

const db = env?.DB;

// STRICT TYPE FIXES
let stats = { totalOrders: 0, totalSpent: 0, points: user.points || 0 };
let recentOrders: any[] = [];

// SECURE EDGE MATRIX QUERIES
if (db) {
  try {
    const ordersQuery = await db.prepare(
      'SELECT COUNT(*) as count, SUM(total_amount) as total FROM orders WHERE customer_id = ?1'
    ).bind(user.id).first<{ count: number, total: number }>();
    
    stats.totalOrders = ordersQuery?.count || 0;
    stats.totalSpent = ordersQuery?.total || 0;

    const { results } = await db.prepare(
      'SELECT id, status, total_amount as total, created_at FROM orders WHERE customer_id = ?1 ORDER BY created_at DESC LIMIT 3'
    ).bind(user.id).all();
    
    recentOrders = results || [];
  } catch (err) {
    console.error('[D1_ACCOUNT_ERROR]', err);
  }
}
---

<AccountLayout title="Secure Dashboard | Symeno">
  <div class="mx-auto max-w-6xl px-6 py-12 space-y-8">
    <DynamicGreeting name={user.first_name || user.email.split('@')[0]} client:load />
    
    <DashboardStats stats={stats} client:load />
    
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <RecentOrdersWidget orders={recentOrders} client:load />
      </div>
      <div class="space-y-8">
        <AccountQuickLinks client:load />
      </div>
    </div>
  </div>
</AccountLayout>
