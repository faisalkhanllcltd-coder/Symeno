---
import StorefrontLayout from '../../layouts/Storefront.astro';

const brands = [
  { name: 'Apple', slug: 'apple', status: 'Verified', nodes: 12 },
  { name: 'Sony', slug: 'sony', status: 'Verified', nodes: 8 },
  { name: 'LG', slug: 'lg', status: 'Verified', nodes: 4 },
  { name: 'Logitech', slug: 'logitech', status: 'Verified', nodes: 6 },
  { name: 'Keychron', slug: 'keychron', status: 'Verified', nodes: 3 },
];
---

<StorefrontLayout
  title="Authorized Brands | Symeno"
  description="Our network of verified hardware suppliers."
>
  <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.02]"
      style="background-image: linear-gradient(var(--color-outline) 1px, transparent 1px), linear-gradient(90deg, var(--color-outline) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <nav
      class="relative z-10 mb-8 flex font-mono text-[10px] tracking-widest text-content-muted uppercase"
    >
      <a href="/" class="transition-colors hover:text-content focus:outline-none"
        >Base</a
      >
      <span class="mx-2">/</span>
      <span class="text-brand">Directory</span>
    </nav>

    <div class="relative z-10 mb-12 border-b border-outline pb-8">
      <h1
        class="mb-4 text-4xl font-bold tracking-tighter text-content uppercase md:text-6xl"
      >
        Supplier <span class="text-brand">Nodes.</span>
      </h1>
      <p class="max-w-xl font-mono text-sm text-content-muted">
        We only interface with tier-1 manufacturers. Every brand listed here is
        cryptographically verified and subject to our zero-markup wholesale
        guarantee.
      </p>
    </div>

    <div
      class="relative z-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        brands.map((brand) => (
          <a
            href={`/brands/${brand.slug}`}
            class="group flex items-center justify-between border border-outline bg-surface p-6 transition-colors hover:border-brand/50 focus:outline-none"
          >
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center border border-outline bg-base font-mono text-[8px] text-content-muted transition-colors group-hover:text-brand">
                LOGO
              </div>
              <div>
                <h2 class="text-lg font-bold tracking-tight text-content uppercase transition-colors group-hover:text-brand">
                  {brand.name}
                </h2>
                <div class="mt-1 flex items-center gap-2">
                  <span class="h-1.5 w-1.5 bg-brand" />
                  <span class="font-mono text-[10px] tracking-widest text-content-muted uppercase">
                    {brand.status}
                  </span>
                </div>
              </div>
            </div>
            <div class="flex flex-col items-end">
              <span class="font-mono text-xs font-bold text-content">
                {brand.nodes} SKUs
              </span>
              <span class="mt-1 font-mono text-[10px] tracking-widest text-content-muted uppercase transition-colors group-hover:text-content">
                Access &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</StorefrontLayout>
