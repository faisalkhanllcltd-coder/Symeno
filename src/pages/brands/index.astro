---
import { env } from "cloudflare:workers";
import StorefrontLayout from '../../layouts/Storefront.astro';

export const prerender = false;

let brands: any[] = [];
let errorMessage = '';

try {
  const db = env.DB as any;
  if (!db) {
    errorMessage = 'Database connection offline.';
  } else {
    const { results } = await db.prepare(
      "SELECT brand, COUNT(id) as nodes FROM catalog_cache WHERE brand IS NOT NULL AND brand != '' GROUP BY brand ORDER BY nodes DESC"
    ).all();

    brands = results.map((row: any) => ({
      name: row.brand,
      slug: row.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, ''),
      status: 'Verified',
      nodes: row.nodes
    }));
  }
} catch (e) {
  console.error('[EDGE_DB_ERROR] Failed to aggregate brand nodes.', e);
  errorMessage = 'Anomaly detected while accessing edge datastore.';
}
---

<StorefrontLayout
  title="Authorized Brands | Symeno"
  description="Our network of verified hardware suppliers."
>
  <div class="fixed top-0 left-1/2 -z-10 h-[800px] w-[800px] -translate-x-1/2 rounded-full bg-brand/5 blur-[120px] pointer-events-none"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-14 lg:px-8">
    
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.02] bg-[linear-gradient(var(--color-outline)_1px,transparent_1px),linear-gradient(90deg,var(--color-outline)_1px,transparent_1px)] bg-[size:32px_32px]"
    ></div>

    <nav
      class="relative z-10 mb-6 flex font-mono text-[10px] tracking-widest text-content-muted uppercase"
    >
      <a href="/" class="transition-colors hover:text-content min-h-[44px] flex items-center focus:outline-none">Base</a>
      <span class="mx-2 flex items-center">/</span>
      <span class="text-brand min-h-[44px] flex items-center">Directory</span>
    </nav>

    <div class="relative z-10 mb-6 border-b border-outline/50 pb-6 sm:mb-8">
      <h1
        class="mb-3 text-3xl font-bold tracking-tighter text-content uppercase md:text-5xl"
      >
        Supplier <span class="text-brand">Nodes.</span>
      </h1>
      <p class="max-w-xl font-mono text-xs sm:text-sm text-content-muted leading-relaxed">
        We only interface with tier-1 manufacturers. Every brand listed here is
        cryptographically verified and subject to our zero-markup wholesale
        guarantee.
      </p>
    </div>

    <div class="relative z-10 mb-8 max-w-md">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-content-muted">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="text"
        id="brand-search"
        class="block w-full min-h-[44px] rounded-2xl border border-outline/60 bg-surface/50 backdrop-blur-md py-3 pl-10 pr-4 text-sm font-medium text-content placeholder:text-content-muted focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand transition-colors shadow-sm"
        placeholder="Search verified network..."
        autocomplete="off"
      />
    </div>

    {errorMessage && (
      <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert relative z-10 mb-8 rounded border p-5 text-center font-mono text-[10px] sm:text-xs tracking-widest uppercase">
        {errorMessage}
      </div>
    )}

    {!errorMessage && brands.length === 0 && (
      <div class="bg-surface border-outline/50 relative z-10 mb-8 rounded-2xl border p-10 text-center">
        <h2 class="text-content mb-2 font-mono text-sm sm:text-base tracking-widest uppercase font-bold">No Suppliers Indexed</h2>
        <p class="text-content-muted font-mono text-[10px] sm:text-xs">The edge datastore returned zero verified brands.</p>
      </div>
    )}

    <div id="search-empty" class="hidden bg-surface border-outline/50 relative z-10 mb-8 rounded-2xl border p-10 text-center flex-col items-center">
      <svg class="mb-3 h-6 w-6 text-content-muted/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <h2 class="text-content mb-1 font-mono text-sm tracking-widest uppercase font-bold">Query Miss</h2>
      <p class="text-content-muted font-mono text-[10px] sm:text-xs">No authorized suppliers match this exact query.</p>
    </div>

    <div id="brand-grid" class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4 lg:gap-6 auto-rows-[minmax(160px,auto)] grid-flow-dense">
      {
        brands.map((brand, i) => {
          // Asymmetric Bento Logic
          const isHero = i === 0;
          const isWide = i > 0 && i % 7 === 0;
          const spanClass = isHero 
            ? "md:col-span-2 lg:col-span-2 lg:row-span-2" 
            : isWide 
            ? "md:col-span-2 lg:col-span-2" 
            : "col-span-1";

          return (
            <a
              href={`/shop?brand=${brand.slug}`}
              data-brand={brand.name.toLowerCase()}
              class={`brand-card group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-outline/40 bg-surface/30 backdrop-blur-xl p-6 transition-all duration-500 hover:-translate-y-1 hover:border-brand/50 hover:bg-surface/60 hover:shadow-[0_10px_40px_-15px_rgba(0,0,0,0.3)] ${spanClass}`}
            >
              <div class="absolute inset-0 -z-10 translate-y-full bg-gradient-to-t from-brand/5 to-transparent opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"></div>

              <div class="flex items-start justify-between gap-4 relative z-10">
                <h2 class={`font-bold tracking-tight text-content uppercase transition-colors group-hover:text-brand ${isHero ? 'text-3xl sm:text-4xl pr-12' : 'text-lg pr-4'}`}>
                  {brand.name}
                </h2>
                <div class="flex shrink-0 items-center gap-1.5 rounded-full border border-outline/50 bg-base/50 px-2.5 py-1 backdrop-blur-md">
                  <span class="h-1.5 w-1.5 bg-brand animate-pulse rounded-full" />
                  <span class="font-mono text-[8px] tracking-widest text-content-muted uppercase">
                    {brand.status}
                  </span>
                </div>
              </div>
              
              <div class={`mt-8 flex items-end justify-between relative z-10 ${isHero ? 'mt-16' : ''}`}>
                <div class="flex flex-col">
                  <span class={`font-mono font-black tracking-tighter text-content transition-colors group-hover:text-brand ${isHero ? 'text-6xl sm:text-8xl opacity-10' : 'text-2xl'}`}>
                    {brand.nodes}
                  </span>
                  <span class="font-mono text-[9px] tracking-widest text-content-muted uppercase mt-1">
                    Active SKUs
                  </span>
                </div>
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-outline/20 text-content opacity-50 transition-all duration-300 group-hover:bg-brand group-hover:text-black group-hover:opacity-100 transform -translate-x-2 group-hover:translate-x-0">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</StorefrontLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('brand-search') as HTMLInputElement;
    const brandCards = document.querySelectorAll('.brand-card');
    const emptyState = document.getElementById('search-empty');
    const brandGrid = document.getElementById('brand-grid');

    if (!searchInput || !brandCards.length) return;

    searchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;

      brandCards.forEach(card => {
        const brandName = card.getAttribute('data-brand') || '';
        
        // THE FIX: Toggle inline display to protect the Bento CSS Grid structure
        if (brandName.includes(term)) {
          (card as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (emptyState && brandGrid) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          brandGrid.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
          brandGrid.classList.remove('hidden');
        }
      }
    });
  });
</script>