---
import StorefrontLayout from '../../layouts/Storefront.astro';

// FORCE EDGE SSR
export const prerender = false;

const { brand } = Astro.params;
const displayName = brand ? brand.toString().replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) : 'Brand';

let activeProducts: any[] = [];

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    const { results } = await db.prepare("SELECT * FROM rapidapi_cache WHERE LOWER(category) = LOWER(?1) OR LOWER(title) LIKE LOWER(?2) LIMIT 50").bind(brand, `%${brand}%`).all();
    
    activeProducts = results.map((p: any) => ({
      slug: p.sku,
      title: p.title,
      category: p.category || 'Hardware',
      basePrice: p.price,
      retailPrice: p.price * 1.2,
      images: p.image_url ? [p.image_url] : []
    }));
  }
} catch (e) {
  console.error('[BRAND_EDGE_ERROR]', e);
}
---

<StorefrontLayout
  title={`${displayName} Hardware | Symeno`}
  description={`Verified wholesale arbitrage for ${displayName} hardware.`}
>
  <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.02]"
      style="background-image: linear-gradient(var(--color-outline) 1px, transparent 1px), linear-gradient(90deg, var(--color-outline) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <nav
      class="relative z-10 mb-8 flex font-mono text-[10px] tracking-widest text-content-muted uppercase"
    >
      <a href="/" class="transition-colors hover:text-content">Base</a>
      <span class="mx-2">/</span>
      <a href="/brands" class="transition-colors hover:text-content">Directory</a>
      <span class="mx-2">/</span>
      <span class="text-brand">{displayName}</span>
    </nav>

    <div
      class="relative z-10 mb-12 flex flex-col justify-between gap-6 border-b border-outline pb-8 md:flex-row md:items-end"
    >
      <div>
        <div class="mb-4 flex items-center gap-3">
          <span class="h-2 w-2 bg-brand"></span>
          <p
            class="font-mono text-[10px] tracking-widest text-content-muted uppercase"
          >
            Authorized Supplier Node
          </p>
        </div>
        <h1
          class="text-4xl font-bold tracking-tighter text-content uppercase md:text-6xl"
        >
          {displayName}<span class="text-brand">.</span>
        </h1>
      </div>

      <div
        class="flex gap-6 border border-outline bg-surface px-4 py-3 font-mono text-[10px] tracking-widest uppercase"
      >
        <div>
          <span class="mb-1 block text-content-muted">Status</span><span
            class="text-brand">Verified</span>
        </div>
        <div>
          <span class="mb-1 block text-content-muted">Active SKUs</span><span
            class="text-content">{activeProducts.length}</span>
        </div>
      </div>
    </div>

    <div
      class="relative z-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        activeProducts.length > 0 ? (
          activeProducts.map((product: any) => (
            <a
              href={`/shop/product/${product.slug}`}
              class="group flex flex-col focus:outline-none"
            >
              <div class="relative mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden border border-outline bg-surface transition-colors group-hover:border-brand/50">
                {product.retailPrice && product.retailPrice > product.basePrice && (
                  <div class="absolute top-3 left-3 z-10 border border-brand/30 bg-brand/10 px-2 py-1 text-[9px] font-bold tracking-widest text-brand uppercase">
                    Save ${Math.floor(product.retailPrice - product.basePrice)}
                  </div>
                )}
                {/* FIX: Wired the Amazon images natively */}
                {product.images && product.images[0] ? (
                  <img 
                    src={product.images[0]} 
                    alt={product.title} 
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <span class="font-mono text-[10px] text-content-muted">Unit Visual</span>
                )}
              </div>
              <span class="mb-1 font-mono text-[10px] tracking-widest text-content-muted uppercase">
                {product.category}
              </span>
              <h2 class="mb-1 truncate text-sm font-bold text-content transition-colors group-hover:text-brand">
                {product.title}
              </h2>
              <div class="mt-auto flex items-baseline gap-2 font-mono">
                <span class="text-sm font-bold text-brand">
                  ${product.basePrice.toFixed(2)}
                </span>

                {product.retailPrice && product.retailPrice > product.basePrice && (
                  <span class="text-[10px] text-content-muted line-through">
                    ${product.retailPrice.toFixed(2)}
                  </span>
                )}
              </div>
            </a>
          ))
        ) : (
          <div class="col-span-full border border-outline bg-surface py-20 text-center">
            <p class="font-mono text-xs tracking-widest text-content-muted uppercase">
              No units currently secured from this supplier.
            </p>
          </div>
        )
      }
    </div>
  </div>
</StorefrontLayout>