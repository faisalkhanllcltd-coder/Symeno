---
import StorefrontLayout from '../layouts/Storefront.astro';
---

<StorefrontLayout
  title="Contact Operations"
  description="Get in touch with Symeno support or B2B sourcing."
>
  <div class="min-h-screen bg-base py-12 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 max-w-2xl">
        <h1
          class="mb-4 text-4xl font-bold tracking-tighter text-content md:text-5xl"
        >
          Operations & Support.
        </h1>
        <p class="text-lg font-light text-content-muted">
          We maintain strict SLA times. Expect a response within 4 hours during
          business operations.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <form
            class="space-y-6 border border-outline bg-surface p-6 md:p-8"
          >
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              <div>
                <label
                  class="mb-2 block font-mono text-[10px] tracking-widest text-content-muted uppercase"
                  >Name</label
                >
                <input
                  type="text"
                  required
                  class="w-full rounded-none border border-outline bg-base px-4 py-3.5 font-mono text-sm text-content transition-colors focus:border-brand/50 focus:outline-none"
                />
              </div>
              <div>
                <label
                  class="mb-2 block font-mono text-[10px] tracking-widest text-content-muted uppercase"
                  >Email Address</label
                >
                <input
                  type="email"
                  required
                  class="w-full rounded-none border border-outline bg-base px-4 py-3.5 font-mono text-sm text-content transition-colors focus:border-brand/50 focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label
                class="mb-2 block font-mono text-[10px] tracking-widest text-content-muted uppercase"
                >Order Number (Optional)</label
              >
              <input
                type="text"
                class="w-full rounded-none border border-outline bg-base px-4 py-3.5 font-mono text-sm text-content transition-colors placeholder:text-content-muted focus:border-brand/50 focus:outline-none"
                placeholder="e.g. SYM-A8F29"
              />
            </div>

            <div>
              <label
                class="mb-2 block font-mono text-[10px] tracking-widest text-content-muted uppercase"
                >Message</label
              >
              <textarea
                required
                rows="5"
                class="w-full rounded-none border border-outline bg-base px-4 py-3.5 font-mono text-sm text-content transition-colors focus:border-brand/50 focus:outline-none"
              ></textarea>
            </div>

            <button
              type="button"
              class="w-full bg-brand py-4 text-sm font-bold tracking-widest text-black uppercase shadow-none transition-colors duration-300 hover:opacity-80"
            >
              Transmit Message
            </button>
            <p
              class="text-center font-mono text-[10px] tracking-widest text-content-muted uppercase"
            >
              Secured via 256-bit TLS
            </p>
          </form>
        </div>

        <div class="space-y-12 lg:col-span-5">
          <div>
            <h3
              class="mb-4 border-b border-outline pb-2 text-sm font-bold tracking-widest text-content uppercase"
            >
              Direct Channels
            </h3>
            <ul class="space-y-4 font-mono text-sm">
              <li class="flex flex-col">
                <span
                  class="mb-1 text-[10px] tracking-wider text-content-muted uppercase"
                  >Customer Support</span
                >
                <a
                  href="mailto:support@symeno.com"
                  class="text-content transition-colors hover:text-brand"
                  >support@symeno.com</a
                >
              </li>
              <li class="flex flex-col">
                <span
                  class="mb-1 text-[10px] tracking-wider text-content-muted uppercase"
                  >B2B Volume & Procurement</span
                >
                <a
                  href="mailto:wholesale@symeno.com"
                  class="text-content transition-colors hover:text-brand"
                  >wholesale@symeno.com</a
                >
              </li>
            </ul>
          </div>

          <div>
            <h3
              class="mb-4 border-b border-outline pb-2 text-sm font-bold tracking-widest text-content uppercase"
            >
              Operating Hours
            </h3>
            <ul class="space-y-2 font-mono text-sm text-content">
              <li class="flex justify-between">
                <span>Mon - Fri:</span>
                <span class="text-content">09:00 - 18:00 (EST)</span>
              </li>
              <li class="flex justify-between">
                <span>Saturday:</span>
                <span class="text-content">10:00 - 14:00 (EST)</span>
              </li>
              <li class="flex justify-between">
                <span>Sunday:</span>
                <span class="text-content-muted">System Maintenance</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</StorefrontLayout>
