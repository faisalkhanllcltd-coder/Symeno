---
import StorefrontLayout from '../layouts/Storefront.astro';
import Turnstile from '../components/security/Turnstile.svelte';
---

<StorefrontLayout
  title="Contact Operations"
  description="Get direct access to the Symeno operations and support team."  
>
  <div class="min-h-screen bg-base py-12 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 max-w-2xl">
        <h1
          class="mb-4 text-4xl font-bold tracking-tighter text-content md:text-5xl"
        >
          Real humans. Real answers.
        </h1>
        <p class="text-lg font-light text-content-muted">
          We don't use AI chatbots to deflect your questions. Whether you need an update on a single order or want to negotiate a 50-unit B2B procurement, you get direct access to our operations team.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <form
            id="contact-form"
            class="space-y-6 border border-outline bg-surface p-6 md:p-8 relative"
          >
            <div id="contact-success" class="absolute inset-0 z-10 hidden bg-surface flex-col items-center justify-center p-8 text-center border border-brand">
              <svg class="mb-4 h-12 w-12 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <h3 class="mb-2 font-mono text-sm font-bold tracking-widest text-content uppercase">Transmission Received</h3>
              <p class="text-xs text-content-muted">Our operations team will respond to your coordinates shortly.</p>
            </div>

            <div id="contact-error" class="hidden rounded-sm border border-brand-alert/30 bg-brand-alert/10 p-3 font-mono text-[10px] tracking-widest text-brand-alert uppercase"></div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">      
              <div>
                <label class="mb-2 block font-mono text-[10px] tracking-widest text-content-muted uppercase">Name</label>
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full rounded-sm border border-outline bg-base px-4 py-3.5 font-mono text-sm text-content transition-colors focus:border-brand/50 focus:outline-none focus:ring-1 focus:ring-brand disabled:opacity-50"
                />
              </div>
              <div>
                <label class="mb-2 block font-mono text-[10px] tracking-widest text-content-muted uppercase">Email Address</label>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full rounded-sm border border-outline bg-base px-4 py-3.5 font-mono text-sm text-content transition-colors focus:border-brand/50 focus:outline-none focus:ring-1 focus:ring-brand disabled:opacity-50"
                />
              </div>
            </div>

            <div>
              <label class="mb-2 block font-mono text-[10px] tracking-widest text-content-muted uppercase">Order Number (Optional)</label>
              <input
                type="text"
                name="order_id"
                class="w-full rounded-sm border border-outline bg-base px-4 py-3.5 font-mono text-sm text-content transition-colors placeholder:text-content-muted/50 focus:border-brand/50 focus:outline-none focus:ring-1 focus:ring-brand disabled:opacity-50" 
                placeholder="e.g. SYM-A8F29"
              />
            </div>

            <div>
              <label class="mb-2 block font-mono text-[10px] tracking-widest text-content-muted uppercase">Message</label>
              <textarea
                name="message"
                required
                rows="5"
                placeholder="How can we help?"
                class="w-full rounded-sm border border-outline bg-base px-4 py-3.5 font-mono text-sm text-content placeholder:text-content-muted/50 transition-colors focus:border-brand/50 focus:outline-none focus:ring-1 focus:ring-brand disabled:opacity-50"
              ></textarea>
            </div>

            <div class="pt-2 pb-4">
               <Turnstile client:load />
            </div>

            <button
              type="submit"
              id="contact-submit-btn"
              class="btn-premium w-full rounded-sm bg-brand py-4 text-sm font-bold tracking-widest text-brand-dark uppercase disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Transmit Message
            </button>
            <p
              class="text-center font-mono text-[10px] tracking-widest text-content-muted uppercase"
            >
              Secured via 256-bit TLS
            </p>
          </form>
        </div>

        <div class="space-y-12 lg:col-span-5">
          <div>
            <h3 class="mb-4 border-b border-outline pb-2 text-sm font-bold tracking-widest text-content uppercase">Direct Channels</h3>
            <ul class="space-y-4 font-mono text-sm">
              <li class="flex flex-col">
                <span class="mb-1 text-[10px] tracking-wider text-content-muted uppercase">Customer Support</span>
                <a href="mailto:support@symeno.com" class="text-content transition-colors hover:text-brand">support@symeno.com</a>
              </li>
              <li class="flex flex-col">
                <span class="mb-1 text-[10px] tracking-wider text-content-muted uppercase">Business & Procurement</span>
                <a href="mailto:support@symeno.com" class="text-content transition-colors hover:text-brand">support@symeno.com</a>
              </li>
              <li class="flex flex-col">
                <span class="mb-1 text-[10px] tracking-wider text-content-muted uppercase">Phone</span>
                <a href="tel:+13073107918" class="text-content transition-colors hover:text-brand">+1 (307) 310-7918</a>
              </li>
              <li class="flex flex-col">
                <span class="mb-1 text-[10px] tracking-wider text-content-muted uppercase">Headquarters</span>
                <span class="text-content">30 N Gould St 59458, Sheridan, WY 82801, USA</span>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="mb-4 border-b border-outline pb-2 text-sm font-bold tracking-widest text-content uppercase">Operating Hours</h3>
            <ul class="space-y-2 font-mono text-sm text-content">   
              <li class="flex justify-between">
                <span>Mon - Fri:</span>
                <span class="text-content">09:00 - 17:00 (MT)</span>
              </li>
              <li class="flex justify-between">
                <span>Weekend:</span>
                <span class="text-content-muted">System Maintenance</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</StorefrontLayout>

<script>
  // THE FIX: Added boolean isSubmitting guard and Turnstile payload extraction
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
  const successOverlay = document.getElementById('contact-success');
  const errorBox = document.getElementById('contact-error');
  
  let isSubmitting = false;

  if (form && btn && successOverlay && errorBox) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (isSubmitting) return;
      isSubmitting = true;
      
      errorBox.classList.add('hidden');
      
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      // Guard: ensure Turnstile widget has completed before submitting
      const cfToken = (window as any).turnstile?.getResponse?.() ?? '';
      if (!cfToken) {
        errorBox.textContent = 'Please complete the security check before submitting.';
        errorBox.classList.remove('hidden');
        isSubmitting = false;
        return;
      }
      payload['cf-turnstile-response'] = cfToken;

      // Lock UI
      const inputs = form.querySelectorAll('input, textarea');
      inputs.forEach(el => (el as HTMLInputElement).disabled = true);
      btn.disabled = true;
      btn.textContent = 'TRANSMITTING...';

      try {
        const res = await fetch('/api/support/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          successOverlay.classList.remove('hidden');
          successOverlay.classList.add('flex');
        } else {
          const errorData = await res.json().catch(() => ({}));
          throw new Error(errorData.error || 'Transmission failed');
        }
      } catch (err: any) {
        // Unlock UI on failure
        inputs.forEach(el => (el as HTMLInputElement).disabled = false);
        btn.disabled = false;
        btn.textContent = 'Transmit Message';
        errorBox.textContent = err.message || 'Connection failed. Please verify your connection or use the direct email channels.';
        errorBox.classList.remove('hidden');
        isSubmitting = false;
        
        // Reset Turnstile on failure
        if ((window as any).turnstile) {
          (window as any).turnstile.reset();
        }
      }
    });
  }
</script>