---
import Storefront from '../layouts/Storefront.astro';
---

<Storefront title="Careers">
  <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <h1 class="mb-6 text-5xl font-bold tracking-tighter uppercase">
      Join The Network
    </h1>
    <p class="text-content-muted mx-auto mb-12 max-w-2xl text-lg">
      We are scaling our global arbitrage network. Currently seeking logistics
      operators, software engineers, and supply chain analysts.
    </p>
    <div
      class="bg-surface border-outline shadow-ambient rounded-xl border p-12"
    >
      <p class="text-content font-mono text-xs tracking-widest uppercase">
        We'll be hiring soon. Check back next quarter.
      </p>
      <p class="mt-4 text-content-muted font-mono text-xs tracking-widest uppercase">
        Contact support@symeno.com for applications.
      </p>
    </div>
  </div>
</Storefront>
