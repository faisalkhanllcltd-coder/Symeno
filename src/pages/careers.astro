---
import Storefront from '../layouts/Storefront.astro';
---
<Storefront title="Careers">
  <div class="max-w-4xl mx-auto py-20 px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-5xl font-bold tracking-tighter uppercase mb-6">Join The Network</h1>
    <p class="text-content-muted text-lg max-w-2xl mx-auto mb-12">We are scaling our global arbitrage network. Currently seeking logistics operators, software engineers, and supply chain analysts.</p>
    <div class="bg-surface border border-outline rounded-xl p-12 shadow-ambient">
      <p class="text-content font-mono uppercase tracking-widest text-xs">No active global requisitions at this exact moment. Check back next quarter.</p>
    </div>
  </div>
</Storefront>
