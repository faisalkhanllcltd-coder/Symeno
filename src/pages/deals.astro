---
import StorefrontLayout from '../layouts/Storefront.astro';

const dealProducts = [
  { id: 'sony-xm5', name: 'Sony WH-1000XM5', price: 249.00, retail: 399.00, category: 'audio', brand: 'Sony', unitsLeft: 14 },
  { id: 'lg-ultragear', name: 'LG 27" UltraGear OLED', price: 649.00, retail: 899.00, category: 'displays', brand: 'LG', unitsLeft: 3 },
  { id: 'apple-airpods-max', name: 'AirPods Max', price: 399.00, retail: 549.00, category: 'audio', brand: 'Apple', unitsLeft: 8 },
  { id: 'keychron-k8', name: 'Keychron K8 Pro', price: 79.00, retail: 109.00, category: 'peripherals', brand: 'Keychron', unitsLeft: 22 }
];
---

<StorefrontLayout title="Live Arbitrage Deals | Symeno" description="Secure premium hardware at global wholesale rates. Limited allocations.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 relative bg-base transition-colors duration-300">

    <div class="absolute inset-0 opacity-[0.05] pointer-events-none bg-[linear-gradient(var(--color-content)_1px,transparent_1px),linear-gradient(90deg,var(--color-content)_1px,transparent_1px)] bg-[size:32px_32px]"></div>

    <nav class="flex text-[10px] font-mono text-content-muted uppercase tracking-widest mb-8 relative z-10">     
      <a href="/" class="hover:text-content transition-colors focus:outline-none">Base</a>
      <span class="mx-2">/</span>
      <span class="text-brand">Active Operations</span>
    </nav>

    <div class="border-b border-outline pb-8 mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6 relative z-10">
      <div>
        <div class="flex items-center gap-3 mb-4">      
          <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-brand"></span></span>
          <p class="text-[10px] font-mono uppercase tracking-widest text-brand">Flash Drop Active</p>        
        </div>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter text-content uppercase mb-2">Arbitrage<span class="text-brand">.</span></h1>
        <p class="text-sm text-content-muted font-mono">Deeply discounted global allocations. Inventory updates every 15 minutes.</p>
      </div>
      <div class="bg-surface border border-brand/30 px-6 py-4 shrink-0 flex flex-col items-end text-right transition-colors duration-300">
        <span class="text-[10px] font-mono uppercase tracking-widest text-content-muted mb-1">Total Margin Available</span>
        <span class="text-2xl font-bold text-brand font-mono tracking-tighter drop-shadow-[0_0_8px_var(--color-brand)]">
          ${dealProducts.reduce((sum, p) => sum + (p.retail - p.price), 0).toFixed(2)}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">
      {dealProducts.map(product => {
        const savings = Math.floor(product.retail - product.price);
        const discountPercent = Math.floor((savings / product.retail) * 100);

        return (
        <a href={`/shop/product/${product.id}`} class="group flex flex-col focus:outline-none relative bg-surface border border-outline p-4 hover:border-brand/50 transition-colors">

          <div class="flex justify-between items-start mb-4">
            <span class="text-[10px] font-mono text-content-muted uppercase tracking-widest">{product.brand}</span>
            <span class="bg-brand/10 text-brand text-[9px] font-bold uppercase tracking-widest px-2 py-1">
              -{discountPercent}% MSRP
            </span>
          </div>

          <div class="aspect-[4/5] mb-4 relative flex items-center justify-center overflow-hidden bg-base border border-outline/50">
            <span class="text-[10px] font-mono text-content-muted">Hardware Array</span>
          </div>

          <h2 class="text-sm font-bold text-content mb-3 group-hover:text-brand transition-colors truncate">{product.name}</h2>

          <div class="flex flex-col gap-1 font-mono mt-auto">
            <div class="flex items-baseline gap-2">     
              <span class="text-lg font-bold text-brand">${product.price.toFixed(2)}</span>
              <span class="text-[10px] text-content-muted line-through">${product.retail.toFixed(2)}</span>      
            </div>
            <span class="text-[10px] text-content-muted uppercase tracking-widest flex items-center gap-2 mt-2"> 
              <span class={`w-1.5 h-1.5 ${product.unitsLeft < 5 ? 'bg-brand-alert' : 'bg-brand'}`}></span>     
              {product.unitsLeft} Units Remaining        
            </span>
          </div>
        </a>
      )})}
    </div>

  </div>
</StorefrontLayout>