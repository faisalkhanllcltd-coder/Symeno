---
import { env } from "cloudflare:workers";
import StorefrontLayout from '../layouts/Storefront.astro';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=1200'
);

let dealProducts: any[] = [];
let dbError = false;
let totalSavings = 0; // THE FIX: Renamed from totalMargin

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q')?.toLowerCase() || '';
const sort = url.searchParams.get('sort') || 'savings_desc';

try {
  const db = (env.DB as any) || (Astro.locals as any).runtime?.env?.DB;
  
  if (db) {
    const { results } = await db.prepare(
      "SELECT id, slug, brand, category, name, price, images_json, scraped_at FROM catalog_cache WHERE in_stock = 1 ORDER BY scraped_at DESC LIMIT 100"
    ).all();

    let filtered = results ? [...results] : [];

    if (q) {
      filtered = filtered.filter(p => 
        (p.name && String(p.name).toLowerCase().includes(q)) ||
        (p.brand && String(p.brand).toLowerCase().includes(q))
      );
    }

    let processedDeals = filtered.map((p: any) => {
      let mainImage = '/assets/placeholders/product-unavailable.webp';
      try {
        if (p.images_json && p.images_json !== '[]') {
          const parsedImages = JSON.parse(p.images_json);
          if (parsedImages.length > 0) mainImage = parsedImages[0];
        }
      } catch(e) {}

      const price = Number(p.price) || 0;
      const retailPrice = price > 0 ? price * 1.20 : 0; 
      // THE FIX: Clean floating point math for savings
      const savings = Math.round((retailPrice - price) * 100) / 100;
      
      return {
        id: p.id,
        slug: p.slug || p.id,
        name: p.name,
        price: price,
        retail: retailPrice,
        savings: savings,
        category: p.category || 'Hardware',
        brand: p.brand || 'Symeno Select',
        image_url: mainImage,
        inStock: true 
      };
    });

    if (sort === 'price_asc') {
      processedDeals.sort((a, b) => a.price - b.price);
    } else if (sort === 'price_desc') {
      processedDeals.sort((a, b) => b.price - a.price);
    } else {
      processedDeals.sort((a, b) => b.savings - a.savings);
    }

    dealProducts = processedDeals.slice(0, 24);

    // Calculate total savings of displayed deals
    dealProducts.forEach(p => { totalSavings += p.savings; });

  } else {
    throw new Error("DB Offline");
  }
} catch (e) {
  console.error('[DEALS_EDGE_ERROR]', e);
  dbError = true;
}
---

<StorefrontLayout
  title="Live Arbitrage Deals | Symeno"
  description="Secure premium hardware at global wholesale rates. Limited allocations."
>
  <div class="bg-base relative mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-14 lg:px-8 lg:py-20 transition-colors duration-300">
    <div class="pointer-events-none absolute inset-0 opacity-[0.02] bg-[linear-gradient(var(--color-outline)_1px,transparent_1px),linear-gradient(90deg,var(--color-outline)_1px,transparent_1px)] bg-[size:32px_32px]"></div>

    <nav class="text-content-muted relative z-10 mb-6 flex font-mono text-[10px] tracking-widest uppercase">
      <a href="/" class="hover:text-content transition-colors focus:outline-none min-h-[44px] flex items-center">Base</a>
      <span class="mx-2 flex items-center">/</span>
      <span class="text-brand min-h-[44px] flex items-center">Active Operations</span>
    </nav>

    <div class="border-outline/50 relative z-10 mb-8 sm:mb-10 flex flex-col justify-between gap-6 border-b pb-6 sm:pb-8 lg:flex-row lg:items-end">
      <div>
        <div class="mb-3 sm:mb-4 flex items-center gap-2 sm:gap-3">
          <span class="relative flex h-1.5 w-1.5 sm:h-2 sm:w-2">
            <span class="bg-brand absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"></span>
            <span class="bg-brand relative inline-flex h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full"></span>
          </span>
          <p class="text-brand font-mono text-[9px] sm:text-[10px] tracking-widest uppercase font-bold">
            Flash Drop Active
          </p>
        </div>
        <h1 class="text-content mb-2 text-3xl font-bold tracking-tighter uppercase sm:text-4xl md:text-5xl lg:text-6xl">
          Arbitrage<span class="text-brand">.</span>
        </h1>
        <p class="text-content-muted font-mono text-xs sm:text-sm">
          Deeply discounted global allocations. Inventory updates every 15 minutes.
        </p>
      </div>

      <div class="bg-surface border-outline/60 flex shrink-0 flex-col items-start lg:items-end border p-4 sm:px-6 sm:py-4 transition-colors duration-300 rounded-md shadow-sm">
        <span class="text-content-muted mb-1 font-mono text-[9px] sm:text-[10px] tracking-widest uppercase">Total Savings Available</span>
        <span class="text-brand font-mono text-xl sm:text-2xl font-bold tracking-tighter drop-shadow-[0_0_8px_rgba(var(--color-brand-rgb),0.3)]">
          ${totalSavings.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}
        </span>
      </div>
    </div>

    <div class="relative z-10 mb-8">
      <form method="GET" action="/deals" class="flex flex-col gap-3 sm:flex-row">
        <div class="relative flex-1">
          <input
            type="search"
            name="q"
            value={q}
            placeholder="Search deals..."
            class="w-full rounded-sm border border-outline bg-surface px-3 py-2.5 font-mono text-xs text-content placeholder:text-content-muted focus:border-brand/50 focus:outline-none focus:ring-1 focus:ring-brand"
          />
        </div>
        <select 
          name="sort" 
          class="sm:w-64 cursor-pointer rounded-sm border border-outline bg-surface px-3 py-2.5 font-mono text-[10px] uppercase text-content focus:border-brand/50 focus:outline-none" 
          onchange="this.form.submit()"
        >
          <option value="savings_desc" selected={sort === 'savings_desc'}>Highest Discount</option>
          <option value="price_asc" selected={sort === 'price_asc'}>Price: Low to High</option>
          <option value="price_desc" selected={sort === 'price_desc'}>Price: High to Low</option>
        </select>
        <button type="submit" class="hidden">Filter</button>
      </form>
    </div>

    {dbError ? (
      <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert relative z-10 mb-8 rounded border p-5 text-center font-mono text-[10px] sm:text-xs tracking-widest uppercase">
        Database connection offline. Operations suspended.
      </div>
    ) : dealProducts.length === 0 ? (
      <div class="bg-surface border-outline/50 relative z-10 mb-8 rounded-lg border p-10 text-center">
        <h2 class="text-content mb-2 font-mono text-sm sm:text-base tracking-widest uppercase font-bold">Allocations Depleted</h2>
        <p class="text-content-muted font-mono text-[10px] sm:text-xs">No active arbitrage nodes match your criteria.</p>
        {q && <a href="/deals" class="text-brand mt-4 inline-block text-xs font-bold hover:underline">Clear Search</a>}
      </div>
    ) : (
      <div class="relative z-10 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4 lg:gap-8">
        {dealProducts.map((product) => {
          const discountPercent = Math.floor((product.savings / product.retail) * 100);

          return (
            /* THE FIX: Rebuilt card layout to push image edge-to-edge with no padding */
            <a
              href={`/shop/product/${product.slug}`}
              class="group bg-surface border-outline/60 hover:border-brand/50 relative flex flex-col border transition-colors focus:outline-none rounded-lg shadow-sm hover:shadow-[0_8px_25px_-8px_rgba(0,0,0,0.2)] overflow-hidden"
            >
              <div class="bg-surface-hover relative flex aspect-[4/5] sm:aspect-square w-full items-center justify-center overflow-hidden border-b border-outline/30">
                <div class="absolute top-3 left-3 z-10">
                  <span class="bg-brand text-brand-dark px-2 py-1 text-[8px] sm:text-[9px] font-bold tracking-widest uppercase rounded-sm shadow-md">
                    -{discountPercent}% MSRP
                  </span>
                </div>
                
                {product.image_url !== '/assets/placeholders/product-unavailable.webp' ? (
                  <img 
                    src={product.image_url} 
                    alt={product.name} 
                    loading="lazy"
                    /* Changed from object-contain to object-cover to stretch edge-to-edge */
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                  />
                ) : (
                  <span class="text-content-muted font-mono text-[9px] sm:text-[10px]">Visual Missing</span>
                )}
              </div>

              <div class="flex flex-col flex-1 p-3 sm:p-4">
                <span class="text-content-muted font-mono text-[8px] sm:text-[9px] tracking-widest uppercase truncate mb-1.5">
                  {product.brand}
                </span>
                
                <h2 class="text-content group-hover:text-brand mb-3 line-clamp-2 text-[11px] sm:text-[13px] font-bold transition-colors leading-snug">
                  {product.name}
                </h2>

                <div class="mt-auto flex flex-col gap-1 sm:gap-1.5 font-mono">
                  <div class="flex items-baseline gap-2">
                    <span class="text-brand text-sm sm:text-base font-bold">
                      ${product.price.toFixed(2)}
                    </span>
                    <span class="text-content-muted text-[9px] sm:text-[10px] line-through">
                      ${product.retail.toFixed(2)}
                    </span>
                  </div>
                  
                  <span class="text-content-muted mt-2 flex items-center gap-1.5 text-[8px] sm:text-[9px] tracking-widest uppercase pt-2 border-t border-outline/30">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand" />
                    Verified Allocation
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</StorefrontLayout>