---
import StorefrontLayout from '../layouts/Storefront.astro';

const dealProducts = [
  {
    id: 'sony-xm5',
    name: 'Sony WH-1000XM5',
    price: 249.0,
    retail: 399.0,
    category: 'audio',
    brand: 'Sony',
    unitsLeft: 14,
  },
  {
    id: 'lg-ultragear',
    name: 'LG 27" UltraGear OLED',
    price: 649.0,
    retail: 899.0,
    category: 'displays',
    brand: 'LG',
    unitsLeft: 3,
  },
  {
    id: 'apple-airpods-max',
    name: 'AirPods Max',
    price: 399.0,
    retail: 549.0,
    category: 'audio',
    brand: 'Apple',
    unitsLeft: 8,
  },
  {
    id: 'keychron-k8',
    name: 'Keychron K8 Pro',
    price: 79.0,
    retail: 109.0,
    category: 'peripherals',
    brand: 'Keychron',
    unitsLeft: 22,
  },
];
---

<StorefrontLayout
  title="Live Arbitrage Deals | Symeno"
  description="Secure premium hardware at global wholesale rates. Limited allocations."
>
  <div
    class="bg-base relative mx-auto max-w-7xl px-4 py-12 transition-colors duration-300 sm:px-6 md:py-20 lg:px-8"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(var(--color-content)_1px,transparent_1px),linear-gradient(90deg,var(--color-content)_1px,transparent_1px)] bg-[size:32px_32px] opacity-[0.05]"
    >
    </div>

    <nav
      class="text-content-muted relative z-10 mb-8 flex font-mono text-[10px] tracking-widest uppercase"
    >
      <a
        href="/"
        class="hover:text-content transition-colors focus:outline-none">Base</a
      >
      <span class="mx-2">/</span>
      <span class="text-brand">Active Operations</span>
    </nav>

    <div
      class="border-outline relative z-10 mb-12 flex flex-col justify-between gap-6 border-b pb-8 md:flex-row md:items-end"
    >
      <div>
        <div class="mb-4 flex items-center gap-3">
          <span class="relative flex h-2 w-2"
            ><span
              class="bg-brand absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
            ></span><span
              class="bg-brand relative inline-flex h-2 w-2 rounded-full"
            ></span></span
          >
          <p class="text-brand font-mono text-[10px] tracking-widest uppercase">
            Flash Drop Active
          </p>
        </div>
        <h1
          class="text-content mb-2 text-4xl font-bold tracking-tighter uppercase md:text-6xl"
        >
          Arbitrage<span class="text-brand">.</span>
        </h1>
        <p class="text-content-muted font-mono text-sm">
          Deeply discounted global allocations. Inventory updates every 15
          minutes.
        </p>
      </div>
      <div
        class="bg-surface border-brand/30 flex shrink-0 flex-col items-end border px-6 py-4 text-right transition-colors duration-300"
      >
        <span
          class="text-content-muted mb-1 font-mono text-[10px] tracking-widest uppercase"
          >Total Margin Available</span
        >
        <span
          class="text-brand font-mono text-2xl font-bold tracking-tighter drop-shadow-[0_0_8px_var(--color-brand)]"
        >
          ${
            dealProducts
              .reduce((sum, p) => sum + (p.retail - p.price), 0)
              .toFixed(2)
          }
        </span>
      </div>
    </div>

    <div
      class="relative z-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        dealProducts.map((product) => {
          const savings = Math.floor(product.retail - product.price);
          const discountPercent = Math.floor((savings / product.retail) * 100);

          return (
            <a
              href={`/shop/product/${product.id}`}
              class="group bg-surface border-outline hover:border-brand/50 relative flex flex-col border p-4 transition-colors focus:outline-none"
            >
              <div class="mb-4 flex items-start justify-between">
                <span class="text-content-muted font-mono text-[10px] tracking-widest uppercase">
                  {product.brand}
                </span>
                <span class="bg-brand/10 text-brand px-2 py-1 text-[9px] font-bold tracking-widest uppercase">
                  -{discountPercent}% MSRP
                </span>
              </div>

              <div class="bg-base border-outline/50 relative mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden border">
                <span class="text-content-muted font-mono text-[10px]">
                  Hardware Array
                </span>
              </div>

              <h2 class="text-content group-hover:text-brand mb-3 truncate text-sm font-bold transition-colors">
                {product.name}
              </h2>

              <div class="mt-auto flex flex-col gap-1 font-mono">
                <div class="flex items-baseline gap-2">
                  <span class="text-brand text-lg font-bold">
                    ${product.price.toFixed(2)}
                  </span>
                  <span class="text-content-muted text-[10px] line-through">
                    ${product.retail.toFixed(2)}
                  </span>
                </div>
                <span class="text-content-muted mt-2 flex items-center gap-2 text-[10px] tracking-widest uppercase">
                  <span
                    class={`h-1.5 w-1.5 ${product.unitsLeft < 5 ? 'bg-brand-alert' : 'bg-brand'}`}
                  />
                  {product.unitsLeft} Units Remaining
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</StorefrontLayout>
