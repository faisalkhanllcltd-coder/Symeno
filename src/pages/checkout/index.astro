---
import StorefrontLayout from '../../layouts/Storefront.astro';
import CheckoutForm from '../../components/storefront/checkout/CheckoutForm.svelte';
import OrderSummary from '../../components/storefront/checkout/OrderSummary.svelte';

// Load Stripe Public Key from Environment Variables securely
const STRIPE_PUBLIC_KEY = import.meta.env.PUBLIC_STRIPE_KEY || '';
---

<StorefrontLayout title="Checkout | Secure Gateway | Symeno">
  <script is:inline src="https://js.stripe.com/v3/"></script>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    
    <div class="mb-12">
      <h1 class="text-3xl font-bold tracking-tighter text-content uppercase flex items-center gap-3">
        <span class="w-2 h-2 bg-brand rounded-full animate-pulse"></span> Acquisition Protocol
      </h1>
      <p class="text-xs text-content-muted font-mono uppercase tracking-widest mt-2">128-bit Encrypted Connection Established</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start relative">
      
      <div class="lg:col-span-7 xl:col-span-8">
        {STRIPE_PUBLIC_KEY ? (
          <CheckoutForm client:only="svelte" publicKey={STRIPE_PUBLIC_KEY} />
        ) : (
          <div class="bg-rose-500/10 border border-rose-500/30 p-8 text-center">
            <p class="text-xs text-rose-400 font-mono uppercase tracking-widest">CRITICAL SYSTEM FAILURE</p>
            <p class="text-[10px] text-rose-400/70 font-mono mt-2">Stripe Public Key is missing from Environment Variables.</p>
          </div>
        )}
      </div>

      <aside class="lg:col-span-5 xl:col-span-4">
        <OrderSummary client:only="svelte" />
        
        <div class="mt-6 flex items-center gap-4 text-[10px] font-mono text-content-muted justify-center">
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg> 
            SSL Secured
          </span>
          <span>•</span>
          <span>Zero Logging</span>
        </div>
      </aside>

    </div>
  </main>
</StorefrontLayout>