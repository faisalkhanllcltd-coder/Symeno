---
import StorefrontLayout from '../../layouts/Storefront.astro';
import CheckoutForm from '../../components/storefront/checkout/CheckoutForm.svelte';
import OrderSummary from '../../components/storefront/checkout/OrderSummary.svelte';

// --- SERVER-SIDE AUTHENTICATION GATE ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login?redirect=/checkout');
}
// ----------------------------------------
---

<StorefrontLayout title="Checkout | Secure Gateway | Symeno">
  <main class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-12">
      <h1 class="text-content flex items-center gap-3 text-3xl font-bold tracking-tighter uppercase">
        <span class="bg-brand h-2 w-2 animate-pulse rounded-full"></span> Acquisition Protocol
      </h1>
      <p class="text-content-muted mt-2 font-mono text-xs tracking-widest uppercase">
        Encrypted Local Session Established
      </p>
    </div>

    <div class="relative grid grid-cols-1 items-start gap-12 lg:grid-cols-12">

      <!-- NATIVE CHECKOUT ENGINE -->
      <div class="lg:col-span-7 xl:col-span-8">
        <CheckoutForm client:only="svelte" />
      </div>

      <!-- ORDER SUMMARY -->
      <aside class="lg:col-span-5 xl:col-span-4">
        <OrderSummary client:only="svelte" />

        <div class="text-content-muted mt-6 flex items-center justify-center gap-4 font-mono text-[10px]">
          <span class="flex items-center gap-1">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
            Internal Authorization
          </span>
          <span>•</span>
          <span>Zero Logging</span>
        </div>
      </aside>
    </div>
  </main>
</StorefrontLayout>
