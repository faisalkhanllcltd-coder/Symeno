---
import StorefrontLayout from '../../layouts/Storefront.astro';

// In a real application, this would verify the secure session/order ID from the URL params via Stripe
const orderNumber = 'SYM-' + Math.floor(100000 + Math.random() * 900000);
---

<StorefrontLayout
  title="Acquisition Confirmed | Symeno"
  description="Your hardware order has been secured."
>
  <div
    class="relative flex min-h-[75vh] flex-col items-center justify-center overflow-hidden bg-base px-4"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.02]"
      style="background-image: linear-gradient(var(--color-outline) 1px, transparent 1px), linear-gradient(90deg, var(--color-outline) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <div
      class="relative z-10 mx-auto w-full max-w-2xl border border-outline bg-surface p-8 text-center shadow-ambient rounded-xl md:p-12"
    >
      <div
        class="mx-auto mb-8 flex h-16 w-16 items-center justify-center rounded-full border border-brand/30 bg-brand/10 text-brand shadow-[0_0_15px_var(--color-brand)]"
      >
        <svg
          class="h-8 w-8"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"></path></svg
        >
      </div>

      <h1
        class="mb-4 text-3xl font-bold tracking-tighter text-content uppercase md:text-5xl"
      >
        Deployment <span class="text-brand">Secured.</span>
      </h1>

      <div class="inline-block bg-base border border-outline/50 rounded px-4 py-2 mb-8">
        <p class="font-mono text-[11px] font-bold tracking-widest uppercase text-content-muted">
          Order Reference: <span class="text-brand ml-2">{orderNumber}</span>
        </p>
      </div>

      <p
        class="mx-auto mb-10 max-w-md font-mono text-xs leading-relaxed text-content-muted"
      >
        Your acquisition has been logged in the master ledger. Logistics will
        dispatch within 24 hours. A secure receipt has been transmitted to your
        terminal.
      </p>

      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/account/orders"
          class="w-full sm:w-auto bg-brand px-8 py-4 rounded text-[11px] font-bold tracking-widest text-brand-dark uppercase shadow-[0_0_15px_rgba(54,244,164,0.15)] transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_25px_rgba(54,244,164,0.3)] focus:outline-none"
        >
          Track Shipment &rarr;
        </a>
        <a
          href="/shop"
          class="w-full sm:w-auto border border-outline bg-transparent px-8 py-4 rounded text-[11px] font-bold tracking-widest text-content uppercase transition-all duration-300 hover:border-brand hover:text-brand focus:outline-none"
        >
          Return to Catalog
        </a>
      </div>
    </div>
  </div>
</StorefrontLayout>

<script>
  import { cart } from '../../stores/cart.svelte.ts';

  document.addEventListener('DOMContentLoaded', () => {
    try {
      cart.clearCart();
      console.log('[LOGISTICS] Local payload purged post-deployment.');
    } catch (e) {
      console.error('[LOGISTICS_ERROR] Failed to purge local payload.', e);
    }
  });
</script>