---
import Storefront from '../../layouts/Storefront.astro';
import Turnstile from '../../components/security/Turnstile.svelte';

if (Astro.cookies.has('auth_error')) {
  Astro.cookies.delete('auth_error', { path: '/' });
}
---

<Storefront title="Authenticate">
  <div class="mx-auto max-w-md px-4 py-24">
    <div class="mb-8 text-center">
      <h1
        class="text-content mb-2 text-3xl font-bold tracking-tighter uppercase"
      >
        Account Access
      </h1>
      <p class="text-content-muted font-mono text-sm">
        Authorized personnel and verified clients only.
      </p>
    </div>

    <div
      id="auth-error-container"
      class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert mb-6 flex hidden items-center justify-center gap-2 border p-4 text-center font-mono text-xs tracking-widest uppercase shadow-[0_0_15px_rgba(239,68,68,0.15)]"
    >
      <svg
        class="h-4 w-4 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
        ></path></svg
      >
      <div id="auth-error" class="font-bold"></div>
    </div>

    <div class="bg-surface border-outline shadow-ambient rounded-xl border p-8">
      <form id="login-form" class="space-y-6">
        <div>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="Email address"
            class="bg-base border-outline text-content w-full rounded-lg border px-4 py-3 font-mono text-sm outline-none"
          />
        </div>
        <div>
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="Password"
            class="bg-base border-outline text-content w-full rounded-lg border px-4 py-3 font-mono text-sm outline-none"
          />
        </div>
        <Turnstile client:load />
        <button
          type="submit"
          id="auth-submit-btn"
          class="bg-brand text-brand-dark w-full rounded-lg py-4 font-bold tracking-widest uppercase transition-opacity hover:opacity-90"
          >Authenticate</button
        >
      </form>
    </div>
    <div class="mt-8 text-center">
      <a
        href="/auth/register"
        class="text-content-muted hover:text-brand font-mono text-xs tracking-widest uppercase"
        >No credentials? Register.</a>
    </div>
  </div>

  <script is:inline>
    window.addEventListener('load', () => {
      const form = document.getElementById('login-form');
      const errorContainer = document.getElementById('auth-error-container');
      const errorText = document.getElementById('auth-error');

      if (!form || !errorContainer || !errorText) return;

      async function processLogin() {
        errorContainer.classList.add('hidden');
        const formData = new FormData(form);

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            body: formData,
            redirect: 'manual',
          });

          if (
            res.type === 'opaqueredirect' ||
            res.status === 302 ||
            res.status === 301 ||
            res.redirected ||
            (res.status >= 200 && res.status < 300)
          ) {
            window.location.href = res.url || '/account/orders';
            return;
          }

          if (res.status === 401) {
            errorText.textContent = 'The credentials provided are invalid.';
          } else if (res.status === 403) {
            errorText.textContent = 'Access denied by security matrix.';
          } else {
            errorText.textContent = 'A system error occurred. Please try again.';
          }
          errorContainer.classList.remove('hidden');
        } catch (err) {
          errorText.textContent = 'Network error. Check connection.';
          errorContainer.classList.remove('hidden');
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        processLogin();
      });
    });
  </script>
</Storefront>
