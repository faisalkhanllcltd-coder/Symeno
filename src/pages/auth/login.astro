---
import Storefront from '../../layouts/Storefront.astro';

if (Astro.cookies.has('auth_error')) {
  Astro.cookies.delete('auth_error', { path: '/' });
}
---

<Storefront title="Authenticate | Symeno">
  <div class="mx-auto max-w-md px-4 py-24">
    <div class="mb-8 text-center">
      <h1 class="text-content mb-2 text-3xl font-bold tracking-tighter uppercase">Account Access</h1>
    </div>

    <div id="auth-error-container" class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert mb-6 hidden items-center justify-center gap-2 rounded-lg border p-4 text-center font-mono text-xs tracking-widest uppercase">
      <div id="auth-error" class="font-bold"></div>
    </div>

    <div class="bg-surface border-outline shadow-ambient rounded-xl border p-8">
      <form id="login-form" class="space-y-6">
        <input type="email" id="email" name="email" required placeholder="Email address" class="bg-base border-outline text-content focus:border-brand w-full rounded-lg border px-4 py-3 font-mono text-sm outline-none" />
        <input type="password" id="password" name="password" required placeholder="Password" class="bg-base border-outline text-content focus:border-brand w-full rounded-lg border px-4 py-3 font-mono text-sm outline-none" />
        
        <button type="submit" id="auth-submit-btn" class="bg-brand text-brand-dark w-full rounded-lg py-4 font-bold tracking-widest uppercase hover:opacity-90 disabled:opacity-50">
          Authenticate
        </button>
      </form>
    </div>
    
    <div class="mt-8 text-center">
      <a href="/auth/register" id="register-link" class="text-content-muted hover:text-brand font-mono text-[10px] tracking-widest uppercase transition-colors">No credentials? Register.</a>
    </div>
  </div>

  <script is:inline>
    (function() {
      function initAuth() {
        const urlParams = new URLSearchParams(window.location.search);
        const returnTo = urlParams.get('returnTo');

        if (returnTo) {
          const registerLink = document.getElementById('register-link');
          if (registerLink) registerLink.href = `/auth/register?returnTo=${encodeURIComponent(returnTo)}`;
        }

        const form = document.getElementById('login-form');
        const errorContainer = document.getElementById('auth-error-container');
        const errorText = document.getElementById('auth-error');
        const submitBtn = document.getElementById('auth-submit-btn');

        if (!form || !errorContainer || !errorText || !submitBtn) return;

        form.onsubmit = async function(e) {
          e.preventDefault();
          errorContainer.classList.add('hidden');
          
          submitBtn.disabled = true;
          submitBtn.innerText = 'AUTHENTICATING...';
          
          const payload = Object.fromEntries(new FormData(form));

          try {
            const res = await fetch('/api/auth/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              redirect: 'manual',
            });

            const data = await res.json().catch(() => ({}));

            if (res.type === 'opaqueredirect' || res.status === 302 || res.status === 301 || res.redirected || (res.status >= 200 && res.status < 300)) {
              let finalRedirect = returnTo;
              if (!finalRedirect || !finalRedirect.startsWith('/')) {
                finalRedirect = data.redirectUrl || '/account/orders';
              }
              window.location.href = finalRedirect;
              return;
            }

            errorText.textContent = data.error || 'The credentials provided are invalid.';
            errorContainer.classList.remove('hidden');
            errorContainer.classList.add('flex');
            
          } catch (err) {
            errorText.textContent = 'Network error. Check connection.';
            errorContainer.classList.remove('hidden');
            errorContainer.classList.add('flex');
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = 'AUTHENTICATE';
          }
        };
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAuth);
      } else {
        initAuth();
      }
    })();
  </script>
</Storefront>