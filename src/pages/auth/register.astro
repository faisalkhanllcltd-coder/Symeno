---
import Storefront from '../../layouts/Storefront.astro';
---

<Storefront title="Register Access">
  <div class="mx-auto max-w-md px-4 py-24">
    <div class="mb-8 text-center">
      <h1
        class="text-content mb-2 text-3xl font-bold tracking-tighter uppercase"
      >
        Request Access
      </h1>
      <p class="text-content-muted font-mono text-sm">
        Provision a new cryptographic identity.
      </p>
    </div>
    <div class="bg-surface border-outline shadow-ambient rounded-xl border p-8">
      <form action="/api/auth/register" method="POST" class="space-y-6">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <input
              type="text"
              name="firstName"
              placeholder="First Name"
              class="bg-base border-outline text-content w-full rounded-lg border px-4 py-3 font-mono text-sm transition-all outline-none"
            />
          </div>
          <div>
            <input
              type="text"
              name="lastName"
              placeholder="Last Name"
              class="bg-base border-outline text-content w-full rounded-lg border px-4 py-3 font-mono text-sm transition-all outline-none"
            />
          </div>
        </div>
        <div>
          <input
            type="email"
            name="email"
            required
            placeholder="Email Address"
            class="bg-base border-outline text-content w-full rounded-lg border px-4 py-3 font-mono text-sm transition-all outline-none"
          />
        </div>
        <div>
          <input
            type="password"
            name="password"
            required
            placeholder="Password"
            class="bg-base border-outline text-content w-full rounded-lg border px-4 py-3 font-mono text-sm transition-all outline-none"
          />
          <p
            class="text-content-muted mt-2 font-mono text-[10px] tracking-widest uppercase"
          >
            Min 8 chars, 1 uppercase, 1 number.
          </p>
        </div>
        <button
          type="submit"
          class="bg-brand text-brand-dark shadow-brand/10 w-full rounded-lg py-4 font-bold tracking-widest uppercase shadow-lg hover:opacity-90"
        >
          Initialize Identity
        </button>
      </form>
    </div>
    <div class="mt-8 text-center">
      <a
        href="/auth/login"
        class="text-content-muted hover:text-brand font-mono text-xs tracking-widest uppercase transition-colors"
        >Already provisioned? Login.</a
      >
    </div>
  </div>
</Storefront>
