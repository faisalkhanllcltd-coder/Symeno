---
import StorefrontLayout from '../../layouts/Storefront.astro';
---

<StorefrontLayout title="Recover Access | Symeno">
  <div
    class="bg-base flex min-h-[75vh] items-center justify-center px-4 transition-colors duration-300 sm:px-6 lg:px-8"
  >
    <div
      class="bg-surface shadow-ambient w-full max-w-md space-y-8 rounded-xl p-8 transition-colors duration-300 sm:p-10"
    >
      <div>
        <h2
          class="text-content text-center font-sans text-3xl font-bold tracking-tight transition-colors duration-300"
        >
          Recover Access
        </h2>
        <p
          class="text-content-muted mt-2 text-center font-mono text-sm tracking-wide transition-colors duration-300"
        >
          Enter your email to receive secure reset instructions.
        </p>
      </div>

      <form class="mt-8 space-y-6" action="/api/auth/reset" method="POST">
        <div>
          <label for="email-address" class="sr-only">Email address</label>
          <input
            id="email-address"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="border-outline bg-base text-content placeholder-content-muted focus:border-brand focus:ring-brand relative block w-full appearance-none rounded-md border px-3 py-3 font-mono transition-colors duration-300 focus:z-10 focus:ring-1 focus:outline-none sm:text-sm"
            placeholder="Email address"
          />
        </div>

        <div>
          <button
            type="submit"
            class="group bg-content focus:ring-content focus:ring-offset-base relative flex w-full justify-center rounded-md border border-transparent px-4 py-3 text-base text-sm font-bold tracking-widest uppercase transition-all hover:opacity-90 focus:ring-2 focus:ring-offset-2 focus:outline-none"
          >
            Send Instructions
          </button>
        </div>

        <div class="text-center text-sm">
          <a
            href="/auth/login"
            class="text-content-muted hover:text-content font-medium transition-colors"
          >
            &larr; Return to Authentication
          </a>
        </div>
      </form>
    </div>
  </div>
</StorefrontLayout>
