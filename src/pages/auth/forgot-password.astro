---
import StorefrontLayout from '../../layouts/Storefront.astro';
---

<StorefrontLayout title="Recover Access | Symeno">
  <div class="bg-base flex min-h-[75vh] items-center justify-center px-4 transition-colors duration-300 sm:px-6 lg:px-8">
    <div class="bg-surface shadow-ambient w-full max-w-md space-y-8 rounded-xl p-8 transition-colors duration-300 sm:p-10">
      
      <div id="header-text">
        <h2 class="text-content text-center font-sans text-3xl font-bold tracking-tight transition-colors duration-300 uppercase">
          Recover Access
        </h2>
        <p class="text-content-muted mt-2 text-center font-mono text-sm tracking-wide transition-colors duration-300">
          Enter your email to receive secure reset instructions.
        </p>
      </div>

      <div id="success-state" class="hidden text-center py-6">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-brand/10">
          <svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <h3 class="text-content mb-2 font-bold tracking-widest uppercase text-sm">Protocol Dispatched</h3>
        <p class="text-content-muted font-mono text-[10px] uppercase tracking-widest leading-relaxed">If an account exists for that address, recovery instructions have been sent. Check your inbox.</p>
      </div>

      <form id="forgot-form" class="mt-8 space-y-6">
        <div id="error-alert" class="hidden bg-brand-alert/10 border-brand-alert/30 text-brand-alert rounded-lg p-3 font-mono text-[10px] uppercase tracking-widest text-center"></div>

        <div>
          <label for="email" class="sr-only">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="border-outline bg-base text-content placeholder-content-muted focus:border-brand focus:ring-brand relative block w-full appearance-none rounded-md border px-4 py-3 font-mono transition-colors duration-300 focus:z-10 focus:ring-1 focus:outline-none text-sm"
            placeholder="Email address"
          />
        </div>

        <div>
          <button
            type="submit"
            id="submit-btn"
            class="bg-brand text-brand-dark focus:ring-brand-dark focus:ring-offset-base relative flex w-full justify-center rounded-md border border-transparent px-4 py-3 font-bold tracking-widest uppercase transition-all hover:opacity-90 focus:ring-2 focus:ring-offset-2 focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed text-xs"
          >
            Send Instructions
          </button>
        </div>
      </form>

      <div class="text-center text-sm border-t border-outline/50 pt-6">
        <a
          href="/auth/login"
          class="text-content-muted hover:text-brand font-mono text-[10px] tracking-widest uppercase transition-colors"
        >
          &larr; Return to Authentication
        </a>
      </div>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('forgot-form');
      const submitBtn = document.getElementById('submit-btn');
      const errorAlert = document.getElementById('error-alert');
      const successState = document.getElementById('success-state');
      const headerText = document.getElementById('header-text');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.innerText = 'DISPATCHING...';

        const email = document.getElementById('email').value;

        try {
          const response = await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              email
            })
          });

          if (!response.ok) throw new Error('Recovery request failed.');

          // Hide form and header, show success
          form.classList.add('hidden');
          headerText.classList.add('hidden');
          successState.classList.remove('hidden');

        } catch (error) {
          errorAlert.innerText = error.message;
          errorAlert.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerText = 'SEND INSTRUCTIONS';
        }
      });
    });
  </script>
</StorefrontLayout>