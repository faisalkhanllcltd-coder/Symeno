---
import StorefrontLayout from '../../layouts/Storefront.astro';
---

<StorefrontLayout title="Recover Access | Symeno">
  <div class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 bg-base transition-colors duration-300">
    <div class="max-w-md w-full space-y-8 bg-surface p-8 sm:p-10 shadow-ambient rounded-xl transition-colors duration-300">
      
      <div>
        <h2 class="text-center text-3xl font-bold tracking-tight text-content font-sans transition-colors duration-300">
          Recover Access
        </h2>
        <p class="mt-2 text-center text-sm text-content-muted font-mono tracking-wide transition-colors duration-300">
          Enter your email to receive secure reset instructions.
        </p>
      </div>

      <form class="mt-8 space-y-6" action="/api/auth/reset" method="POST">
        <div>
          <label for="email-address" class="sr-only">Email address</label>
          <input id="email-address" name="email" type="email" autocomplete="email" required class="relative block w-full appearance-none rounded-md border border-outline bg-base px-3 py-3 text-content placeholder-content-muted focus:z-10 focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand sm:text-sm font-mono transition-colors duration-300" placeholder="Email address">
        </div>

        <div>
          <button type="submit" class="group relative flex w-full justify-center rounded-md border border-transparent bg-content py-3 px-4 text-sm font-bold text-base hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-content focus:ring-offset-2 focus:ring-offset-base transition-all uppercase tracking-widest">
            Send Instructions
          </button>
        </div>
        
        <div class="text-center text-sm">
          <a href="/auth/login" class="font-medium text-content-muted hover:text-content transition-colors">
            &larr; Return to Authentication
          </a>
        </div>
      </form>
      
    </div>
  </div>
</StorefrontLayout>
