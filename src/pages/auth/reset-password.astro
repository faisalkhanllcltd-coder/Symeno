---
import AuthLayout from '../../layouts/Auth.astro';
import InputField from '../../components/ui/forms/InputField.svelte'; 
import Button from '../../components/ui/navigation/Button.svelte';    

if (Astro.locals.user) return Astro.redirect('/account');
---

<AuthLayout title="Credential Recovery">
  <div class="w-full max-w-md">
    <div class="mb-10 text-center">
      <h1 class="text-2xl font-bold tracking-tight text-content uppercase">
        System Override.
      </h1>
      <p class="mt-2 font-mono text-sm text-content-muted">
        Enter your registered email address to receive a secure recovery token.
      </p>
    </div>

    <div class="border border-outline bg-surface p-8 shadow-sm">        
      <form class="space-y-6" action="/api/auth/reset-password" method="POST">
        <InputField
          id="email"
          label="Email Address"
          type="email"
          required={true}
          client:load
        />
        <Button type="submit" variant="primary" client:load class="w-full"
          >Transmit Reset Link</Button
        >
      </form>

      <div
        class="mt-8 border-t border-outline pt-6 text-center font-mono text-xs text-content-muted"
      >
        <a
          href="/auth/login"
          class="transition-colors hover:text-brand focus-visible:outline-none focus-visible:text-brand"
          >&larr; Return to Authentication</a
        >
      </div>
    </div>
  </div>
</AuthLayout>