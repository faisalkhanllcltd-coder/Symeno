---
import AuthLayout from '../../layouts/Auth.astro';
import InputField from '../../components/ui/forms/InputField.svelte';
import Button from '../../components/ui/navigation/Button.svelte';

if (Astro.locals.user) return Astro.redirect('/account');
---

<AuthLayout title="Credential Recovery">
  <div class="w-full max-w-md">
    
    <div class="text-center mb-10">
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 uppercase">System Override.</h1>
      <p class="mt-2 text-sm text-gray-500 font-mono">Enter your registered email address to receive a secure recovery token.</p>
    </div>

    <div class="bg-white border border-gray-200 p-8 shadow-sm">
      <form class="space-y-6" action="/api/auth/reset-password" method="POST">
        <InputField id="email" label="Email Address" type="email" required={true} client:load />
        <Button type="submit" variant="primary" client:load className="w-full">Transmit Reset Link</Button>
      </form>

      <div class="mt-8 pt-6 border-t border-gray-100 text-center text-xs font-mono text-gray-500">
        <a href="/auth/login" class="text-gray-400 hover:text-black transition-colors focus:outline-none">&larr; Return to Authentication</a>
      </div>
    </div>

  </div>
</AuthLayout>