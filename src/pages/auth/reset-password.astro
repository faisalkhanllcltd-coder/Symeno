---
import StorefrontLayout from '../../layouts/Storefront.astro';
import Turnstile from '../../components/security/Turnstile.svelte';

if (Astro.locals.user) return Astro.redirect('/account');
---

<StorefrontLayout title="Establish New Cipher | Symeno">
  <div class="bg-base flex min-h-[75vh] items-center justify-center px-4 transition-colors duration-300 sm:px-6 lg:px-8">
    <div class="bg-surface shadow-ambient w-full max-w-md space-y-8 rounded-xl p-8 transition-colors duration-300 sm:p-10">
      
      <div>
        <h2 class="text-content text-center font-sans text-3xl font-bold tracking-tight transition-colors duration-300 uppercase">
          System Override
        </h2>
        <p class="text-content-muted mt-2 text-center font-mono text-sm tracking-wide transition-colors duration-300">
          Enter your new credentials to finalize recovery.
        </p>
      </div>

      <form id="reset-form" class="mt-8 space-y-6">
        <div id="error-alert" class="hidden bg-brand-alert/10 border-brand-alert/30 text-brand-alert rounded-lg p-3 font-mono text-[10px] uppercase tracking-widest text-center"></div>

        <div>
          <label for="newPassword" class="sr-only">New Password</label>
          <input
            id="newPassword"
            name="newPassword"
            type="password"
            required
            class="border-outline bg-base text-content placeholder-content-muted focus:border-brand focus:ring-brand relative block w-full appearance-none rounded-md border px-4 py-3 font-mono transition-colors duration-300 focus:z-10 focus:ring-1 focus:outline-none sm:text-sm"
            placeholder="New Password"
          />
        </div>

        <Turnstile client:load />

        <div>
          <button
            type="submit"
            id="submit-btn"
            class="bg-brand text-brand-dark focus:ring-brand-dark focus:ring-offset-base relative flex w-full justify-center rounded-md border border-transparent px-4 py-3 font-bold tracking-widest uppercase transition-all hover:opacity-90 focus:ring-2 focus:ring-offset-2 focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed text-xs"
          >
            Lock In Credentials
          </button>
        </div>

        <div class="text-center text-sm border-t border-outline/50 pt-6">
          <a
            href="/auth/login"
            class="text-content-muted hover:text-brand font-mono text-[10px] tracking-widest uppercase transition-colors"
          >
            &larr; Return to Authentication
          </a>
        </div>
      </form>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get('token');

      const form = document.getElementById('reset-form');
      const submitBtn = document.getElementById('submit-btn');
      const errorAlert = document.getElementById('error-alert');

      if (!token) {
        errorAlert.innerText = 'INVALID OR MISSING RECOVERY TOKEN.';
        errorAlert.classList.remove('hidden');
        submitBtn.disabled = true;
        return;
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.innerText = 'UPDATING...';

        const newPassword = document.getElementById('newPassword').value;
        const payload = Object.fromEntries(new FormData(form));

        if (!payload['cf-turnstile-response']) {
            errorAlert.innerText = 'SECURITY VERIFICATION MISSING.';
            errorAlert.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.innerText = 'LOCK IN CREDENTIALS';
            return;
        }

        try {
          const response = await fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              token, 
              newPassword,
              'cf-turnstile-response': payload['cf-turnstile-response']
            })
          });

          const data = await response.json();

          if (!response.ok) throw new Error(data.error || 'Password reset failed.');

          // Success - route them back to login
          window.location.href = '/auth/login';

        } catch (error) {
          errorAlert.innerText = error.message;
          errorAlert.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerText = 'LOCK IN CREDENTIALS';
        }
      });
    });
  </script>
</StorefrontLayout>