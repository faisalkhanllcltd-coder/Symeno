---
import StorefrontLayout from '../../layouts/Storefront.astro';

const EFFECTIVE_DATE = 'May 15, 2026';
const COMPANY_NAME = 'SYMENO LLC';
const CONTACT_EMAIL = 'support@symeno.com';
const SUPPORT_EMAIL = 'support@symeno.com';
const ADDRESS_LINE_1 = '30 N Gould St 59458';
const ADDRESS_LINE_2 = 'Sheridan, WY 82801, USA';
const PHONE = '+1 (307) 310-7918';
---

<StorefrontLayout
  title="Privacy Policy | Symeno"
  description="The Privacy Policy of SYMENO LLC. Learn what personal data we collect (email, shipping address, payment details), how we protect it, and how our third-party payment processors (Stripe, Airwallex) handle your financial data."
>
  <div class="min-h-screen bg-base py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="mb-12">
        <p class="font-mono text-xs tracking-widest text-brand uppercase mb-3">Legal Document</p>
        <h1 class="mb-4 text-4xl font-bold tracking-tighter text-content md:text-5xl uppercase">
          Privacy Policy.
        </h1>
        <p class="font-mono text-xs tracking-widest text-content-muted uppercase">
          Effective Date: {EFFECTIVE_DATE} &nbsp;|&nbsp; {COMPANY_NAME}
        </p>
        <div class="mt-6 rounded-lg border border-brand/30 bg-brand/5 p-4">
          <p class="text-sm text-content-muted leading-relaxed">
            <strong class="text-content">Your privacy is not a formality — it is a core operating principle.</strong> This Privacy Policy describes how {COMPANY_NAME}, a Wyoming limited liability company, collects, uses, stores, discloses, and protects your personal information when you visit <em>symeno.com</em> (the "Site") or make a purchase through our platform. By using the Site, you consent to the data practices described in this policy.
          </p>
        </div>
      </div>

      <!-- Body -->
      <div class="space-y-12 leading-relaxed font-light text-content-muted">

        <!-- Section 1 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            1. Data Controller
          </h2>
          <p class="mb-4">
            The data controller responsible for the collection and processing of your personal data is:
          </p>
          <div class="rounded-lg border border-outline bg-surface p-5 mb-4">
            <p class="font-bold text-content text-base mb-1">{COMPANY_NAME}</p>
            <p class="text-sm mb-1">{ADDRESS_LINE_1}</p>
            <p class="text-sm mb-1">{ADDRESS_LINE_2}</p>
            <p class="text-sm mb-1">Email: <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand hover:underline">{CONTACT_EMAIL}</a></p>
            <p class="text-sm">Phone: <a href={`tel:${PHONE.replace(/\s/g, '')}`} class="text-brand hover:underline">{PHONE}</a></p>
          </div>
        </section>

        <!-- Section 2 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            2. What Personal Data We Collect
          </h2>
          <p class="mb-4">
            We collect personal data that you voluntarily provide to us, as well as data generated automatically through your use of the Site. We collect only the minimum data necessary to fulfill the purposes outlined in this policy.
          </p>

          <h3 class="mb-3 mt-5 text-base font-semibold text-content uppercase tracking-wide">2.1 — Data You Provide Directly</h3>
          <div class="mb-6 space-y-4">
            <div class="rounded-lg border border-outline p-4">
              <p class="font-semibold text-content mb-1">📧 Email Address</p>
              <p class="text-sm">Collected at account registration and checkout. Used exclusively for: order confirmation receipts, shipping notifications, account security alerts, and, only if you expressly opt in, promotional communications. You may unsubscribe from marketing emails at any time.</p>
            </div>
            <div class="rounded-lg border border-outline p-4">
              <p class="font-semibold text-content mb-1">📦 Shipping Address</p>
              <p class="text-sm">Collected at checkout. This includes your full name, street address, city, state/province, postal code, and country. Used exclusively to physically fulfill and ship your order and to generate a return shipping label where applicable. This data is shared with our logistics carriers (e.g., USPS, UPS, FedEx, DHL) solely to the extent necessary to complete delivery.</p>
            </div>
            <div class="rounded-lg border border-outline p-4">
              <p class="font-semibold text-content mb-1">💳 Payment Details (Tokenized)</p>
              <p class="text-sm">When you make a purchase, your payment information (credit card number, expiration date, CVV, billing address) is entered directly into a secure payment form hosted by our third-party payment processors. <strong class="text-content">{COMPANY_NAME} servers never receive, process, store, or have access to your raw credit card numbers.</strong> We receive only a payment token and a transaction status from our payment processors. See Section 5 for full details.</p>
            </div>
            <div class="rounded-lg border border-outline p-4">
              <p class="font-semibold text-content mb-1">📞 Phone Number (Optional)</p>
              <p class="text-sm">Collected only if voluntarily provided during checkout or account setup. Used only to coordinate delivery or resolve urgent order issues. Never used for unsolicited marketing communications.</p>
            </div>
            <div class="rounded-lg border border-outline p-4">
              <p class="font-semibold text-content mb-1">🔐 Account Credentials</p>
              <p class="text-sm">If you create an account, we store your email address and a cryptographically hashed (bcrypt) version of your password. We never store your password in plaintext under any circumstances.</p>
            </div>
          </div>

          <h3 class="mb-3 mt-5 text-base font-semibold text-content uppercase tracking-wide">2.2 — Data Collected Automatically</h3>
          <ul class="mb-4 list-disc space-y-2 pl-5">
            <li>
              <strong class="text-content">Log Data:</strong> Our web infrastructure (Cloudflare) may automatically collect server logs containing your IP address, browser type, pages visited, referring URLs, and timestamps. This data is used for security monitoring, bot mitigation, and DDoS protection. Cloudflare may retain this data per its own data retention policy.
            </li>
            <li>
              <strong class="text-content">Cookies &amp; Session Tokens:</strong> We use strictly necessary session cookies to maintain your logged-in state and shopping cart. We may use analytical cookies, with your explicit consent via our cookie consent banner, to understand how users navigate the Site. You may disable cookies via your browser settings; however, some Site features may become unavailable.
            </li>
            <li>
              <strong class="text-content">Device Information:</strong> We may collect anonymized data about the device you use to access the Site (e.g., screen resolution, operating system) to optimize the Site's display and performance.
            </li>
          </ul>
        </section>

        <!-- Section 3 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            3. How We Use Your Personal Data
          </h2>
          <p class="mb-4">We process your personal data under the following lawful bases and for the following purposes:</p>
          <ul class="mb-4 list-disc space-y-2 pl-5">
            <li><strong class="text-content">Contract Performance:</strong> To process and fulfill your orders, manage your account, process payments through our processors, and handle returns and refunds.</li>
            <li><strong class="text-content">Legal Obligation:</strong> To comply with applicable laws, regulations, and legal proceedings, including tax, anti-money-laundering (AML), and fraud prevention obligations.</li>
            <li><strong class="text-content">Legitimate Interest:</strong> To detect, prevent, and investigate fraudulent activity, chargebacks, and abuse of our platform. To maintain the security and integrity of our infrastructure. To analyze anonymized usage patterns to improve the Site's performance.</li>
            <li><strong class="text-content">Consent:</strong> To send you promotional emails or marketing communications about new products, sales, or other offers, where you have explicitly opted in. You may withdraw this consent at any time.</li>
          </ul>
          <p class="mb-4">
            <strong class="text-content">We do not sell, trade, rent, or otherwise transfer your personal data to unaffiliated third parties for their independent marketing purposes.</strong>
          </p>
        </section>

        <!-- Section 4 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            4. Data Sharing &amp; Disclosure
          </h2>
          <p class="mb-4">We disclose your personal data only in the following limited circumstances:</p>
          <ul class="mb-4 list-disc space-y-2 pl-5">
            <li>
              <strong class="text-content">Service Providers (Subprocessors):</strong> We share data with vetted third-party vendors who perform services on our behalf (e.g., payment processing, shipping, email delivery, cloud infrastructure). These providers are contractually bound to use your data only to perform the specified services and are prohibited from disclosing or using it for any other purpose.
            </li>
            <li>
              <strong class="text-content">Shipping Carriers:</strong> Your name and shipping address are shared with the relevant carrier (e.g., USPS, UPS, FedEx, DHL) to fulfill delivery of your order.
            </li>
            <li>
              <strong class="text-content">Legal Compliance:</strong> We may disclose your information if required to do so by law, by a court order, by a governmental or regulatory authority, or when we believe in good faith that disclosure is necessary to protect our rights, protect your safety or the safety of others, investigate fraud, or respond to a lawful government request.
            </li>
            <li>
              <strong class="text-content">Business Transfers:</strong> In the event of a merger, acquisition, corporate reorganization, or sale of all or a portion of our assets, your personal data may be transferred as part of that transaction. We will notify you via email and/or a prominent notice on our Site of any such change in ownership and of any choices you may have regarding your information.
            </li>
          </ul>
        </section>

        <!-- Section 5 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            5. Payment Processing &amp; PCI-DSS Compliance
          </h2>
          <div class="rounded-lg border border-green-500/30 bg-green-500/5 p-5 mb-6">
            <p class="font-semibold text-green-400 mb-2">🔒 Zero Raw Card Data On Our Servers</p>
            <p class="text-sm">
              <strong class="text-content">{COMPANY_NAME} does not collect, store, transmit, or process raw credit card numbers, CVV codes, or full payment card data on our own servers at any time.</strong> All payment card data is handled exclusively by our certified third-party payment processors, who are independently certified to PCI-DSS (Payment Card Industry Data Security Standard) Level 1 — the highest standard in the industry.
            </p>
          </div>
          <p class="mb-4">Our active payment processors are:</p>
          <ul class="mb-4 list-disc space-y-3 pl-5">
            <li>
              <strong class="text-content">Stripe, Inc.</strong> — A PCI-DSS Level 1 certified payment processor. When you enter your card details, the data is transmitted directly from your browser to Stripe's secure servers via an encrypted channel (TLS 1.2+). Stripe returns a payment token (a non-sensitive reference ID) to our system. Stripe's privacy policy is available at <a href="https://stripe.com/privacy" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline">stripe.com/privacy</a>.
            </li>
            <li>
              <strong class="text-content">Airwallex Pty Ltd.</strong> — A licensed global payment service provider and money services business. Airwallex processes payments under its own regulatory authorizations. Airwallex's privacy policy is available at <a href="https://www.airwallex.com/us/legal/privacy-notice" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline">airwallex.com/us/legal/privacy-notice</a>.
            </li>
          </ul>
          <p class="mb-4">
            By submitting payment information, you expressly consent to the transfer of your payment data to the relevant payment processor for the purpose of completing your transaction. {COMPANY_NAME} is not responsible for the data practices of these third-party processors; their use of your payment data is governed by their respective privacy policies.
          </p>
        </section>

        <!-- Section 6 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            6. Third-Party Subprocessors
          </h2>
          <p class="mb-4">We use the following categories of subprocessors to operate our platform. All subprocessors are contractually bound to process data only as instructed by {COMPANY_NAME} and in compliance with applicable data protection laws:</p>
          <div class="overflow-x-auto mb-4">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-outline">
                  <th class="py-3 px-4 text-left font-semibold text-content">Subprocessor</th>
                  <th class="py-3 px-4 text-left font-semibold text-content">Purpose</th>
                  <th class="py-3 px-4 text-left font-semibold text-content">Data Category</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-outline">
                <tr>
                  <td class="py-3 px-4 font-medium text-content">Stripe, Inc.</td>
                  <td class="py-3 px-4">Payment authorization &amp; PCI processing</td>
                  <td class="py-3 px-4">Payment tokens, transaction metadata</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-medium text-content">Airwallex Pty Ltd.</td>
                  <td class="py-3 px-4">Global payment processing</td>
                  <td class="py-3 px-4">Payment tokens, transaction metadata</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-medium text-content">Cloudflare, Inc.</td>
                  <td class="py-3 px-4">CDN, DNS, edge security, bot mitigation, database (D1)</td>
                  <td class="py-3 px-4">IP addresses (transient), log data, session data</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-medium text-content">Resend, Inc.</td>
                  <td class="py-3 px-4">Transactional email delivery</td>
                  <td class="py-3 px-4">Email address, order details</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-medium text-content">Shipping Carriers</td>
                  <td class="py-3 px-4">Physical package fulfillment</td>
                  <td class="py-3 px-4">Full name, shipping address</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 7 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            7. Data Retention
          </h2>
          <p class="mb-4">
            We retain your personal data only for as long as necessary to fulfill the purposes described in this policy, to comply with our legal obligations (e.g., financial record-keeping requirements under US tax law), resolve disputes, and enforce our agreements.
          </p>
          <ul class="mb-4 list-disc space-y-2 pl-5">
            <li><strong class="text-content">Order Data:</strong> Retained for a minimum of 7 years to comply with US federal and Wyoming state financial record-keeping requirements.</li>
            <li><strong class="text-content">Account Data:</strong> Retained for the lifetime of your account. Upon account deletion request, data is purged within 30 days, subject to legal retention requirements.</li>
            <li><strong class="text-content">Inactive Accounts:</strong> Accounts with no activity for 3 consecutive years may be scheduled for deletion, with prior email notification.</li>
          </ul>
        </section>

        <!-- Section 8 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            8. Data Security
          </h2>
          <p class="mb-4">
            We implement industry-standard technical and organizational security measures to protect your personal data against unauthorized access, disclosure, alteration, or destruction. These measures include:
          </p>
          <ul class="mb-4 list-disc space-y-2 pl-5">
            <li>Transport Layer Security (TLS 1.2+) encryption for all data transmitted between your browser and our servers.</li>
            <li>Cryptographic hashing (bcrypt) of all account passwords. We never store plaintext passwords.</li>
            <li>Cloudflare enterprise-grade DDoS protection, Web Application Firewall (WAF), and bot mitigation at the network edge.</li>
            <li>Strict access controls ensuring that only authorized personnel have access to production databases, and only on a need-to-know basis.</li>
            <li>Regular security reviews of our codebase and third-party dependencies.</li>
          </ul>
          <p class="mb-4">
            While we take these steps to protect your information, no method of internet transmission or electronic storage is 100% secure. We cannot guarantee absolute security. In the event of a material data breach affecting your rights and freedoms, we will notify affected users and relevant authorities as required by applicable law.
          </p>
        </section>

        <!-- Section 9 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            9. Your Privacy Rights
          </h2>
          <p class="mb-4">Depending on your jurisdiction, you may have the following rights regarding your personal data. To exercise any of these rights, contact us at <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand hover:underline">{CONTACT_EMAIL}</a>. We will respond to verified requests within 30 days.</p>

          <h3 class="mb-3 mt-5 text-base font-semibold text-content uppercase tracking-wide">9.1 — General Rights (All Users)</h3>
          <ul class="mb-4 list-disc space-y-2 pl-5">
            <li><strong class="text-content">Right to Access:</strong> You may request a copy of the personal data we hold about you.</li>
            <li><strong class="text-content">Right to Rectification:</strong> You may request correction of any inaccurate or incomplete personal data.</li>
            <li><strong class="text-content">Right to Deletion (Right to Erasure):</strong> You may request the deletion of your personal data from our systems, subject to legal retention requirements.</li>
            <li><strong class="text-content">Right to Opt-Out of Marketing:</strong> You may unsubscribe from marketing communications at any time via the unsubscribe link in any marketing email or by contacting us directly.</li>
          </ul>

          <h3 class="mb-3 mt-5 text-base font-semibold text-content uppercase tracking-wide">9.2 — California Residents (CCPA/CPRA)</h3>
          <ul class="mb-4 list-disc space-y-2 pl-5">
            <li><strong class="text-content">Right to Know:</strong> You may request disclosure of the specific pieces of personal data we have collected about you in the past 12 months, the categories of data, and the purposes for which it was collected.</li>
            <li><strong class="text-content">Right to Delete:</strong> You may request deletion of your personal data, subject to legal exceptions.</li>
            <li><strong class="text-content">Right to Non-Discrimination:</strong> We will not discriminate against you for exercising your CCPA rights. We will not deny you goods or services, charge different prices, or provide a different quality of service because you exercised your privacy rights.</li>
            <li><strong class="text-content">Do Not Sell or Share My Personal Information:</strong> {COMPANY_NAME} does not sell or share personal information to third parties for cross-context behavioral advertising. No opt-out is required, as this practice does not occur.</li>
          </ul>

          <h3 class="mb-3 mt-5 text-base font-semibold text-content uppercase tracking-wide">9.3 — Canadian Residents (PIPEDA)</h3>
          <p class="mb-4">
            In compliance with Canada's Personal Information Protection and Electronic Documents Act (PIPEDA), we collect data based on explicit or implied consent and provide you the right to access, correct, and withdraw consent for non-essential processing at any time by contacting <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand hover:underline">{CONTACT_EMAIL}</a>.
          </p>

          <h3 class="mb-3 mt-5 text-base font-semibold text-content uppercase tracking-wide">9.4 — European &amp; UK Residents (GDPR/UK GDPR)</h3>
          <p class="mb-4">
            If you are located in the European Economic Area (EEA) or the United Kingdom, you have additional rights under the General Data Protection Regulation (GDPR) or UK GDPR, including the right to restriction of processing, the right to data portability, and the right to lodge a complaint with your relevant supervisory authority. To exercise these rights, contact <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand hover:underline">{CONTACT_EMAIL}</a>.
          </p>
        </section>

        <!-- Section 10 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            10. Children's Privacy
          </h2>
          <p class="mb-4">
            The Site is not directed to individuals under the age of 13 in the United States, or under the age of 16 in the European Union. We do not knowingly collect personal data from children. If you are a parent or guardian and believe that your child has provided us with personal data without your consent, please contact us immediately at <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand hover:underline">{CONTACT_EMAIL}</a> and we will take immediate steps to delete such information.
          </p>
        </section>

        <!-- Section 11 -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            11. Changes to This Privacy Policy
          </h2>
          <p class="mb-4">
            We reserve the right to modify this Privacy Policy at any time. We will notify you of any material changes by updating the "Effective Date" at the top of this page and, where appropriate, by sending a notification to the email address associated with your account. Your continued use of the Site following the posting of changes constitutes your acceptance of such changes.
          </p>
        </section>

        <!-- Section 12 — Governing Law & Contact Block -->
        <section>
          <h2 class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content">
            12. Governing Law &amp; Data Privacy Requests
          </h2>
          <p class="mb-4">
            This Privacy Policy is governed by and construed in accordance with the laws of the <strong class="text-content">State of Wyoming, United States of America</strong>. {COMPANY_NAME} is a Wyoming-registered limited liability company.
          </p>
          <p class="mb-4">
            To submit a data privacy request (Right to Access, Right to Delete, Opt-Out, or any other privacy inquiry), please contact our Privacy Officer using the information below. All requests will be acknowledged within 5 business days and fully processed within 30 days:
          </p>
          <div class="rounded-lg border border-outline bg-surface p-6">
            <p class="font-bold text-content text-base mb-1">Privacy Officer — {COMPANY_NAME}</p>
            <p class="text-sm mb-1">{ADDRESS_LINE_1}</p>
            <p class="text-sm mb-1">{ADDRESS_LINE_2}</p>
            <p class="text-sm mb-1">
              Privacy &amp; Legal Inquiries: <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand hover:underline">{CONTACT_EMAIL}</a>
            </p>
            <p class="text-sm mb-1">
              General Support: <a href={`mailto:${SUPPORT_EMAIL}`} class="text-brand hover:underline">{SUPPORT_EMAIL}</a>
            </p>
            <p class="text-sm">
              Phone: <a href={`tel:${PHONE.replace(/\s/g, '')}`} class="text-brand hover:underline">{PHONE}</a>
            </p>
          </div>
        </section>

      </div>
    </div>
  </div>
</StorefrontLayout>