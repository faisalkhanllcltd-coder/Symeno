---
import StorefrontLayout from '../../layouts/Storefront.astro';
---

<StorefrontLayout title="Shipping Operations">
  <div class="min-h-screen bg-base py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h1
          class="mb-4 text-4xl font-bold tracking-tighter text-content md:text-5xl"
        >
          Shipping Operations.
        </h1>
        <p class="font-mono text-xs tracking-widest text-brand uppercase">
          Last Updated: May 13, 2026
        </p>
      </div>

      <div class="space-y-12 leading-relaxed font-light text-content-muted">
        <section>
          <h2
            class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content"
          >
            Dispatch Timelines
          </h2>
          <p class="mb-4">
            Operational efficiency is core to our model. Orders placed and verified before
            14:00 MT Monday-Friday are dispatched via USPS, UPS, and FedEx for domestic US and Canada orders,
            on the same day. Ships from: Sheridan, Wyoming, USA. Orders placed after the cutoff, or on
            weekends/holidays, are processed the next business operational day.
            Contact: support@symeno.com
          </p>
        </section>

        <section>
          <h2
            class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content"
          >
            Transit Methods & Costs
          </h2>
          <div
            class="mt-6 rounded-sm border border-outline bg-surface p-6"
          >
            <ul class="space-y-4 font-mono text-sm">
              <li class="flex justify-between border-b border-outline pb-4">
                <span class="text-content">Priority Insured (2-4 Days)</span>
                <span class="text-content-muted">Calculated at Checkout</span>
              </li>
              <li class="flex justify-between pt-2">
                <span class="flex items-center gap-2 text-content"
                  >Standard (5-7 Days) <span
                    class="bg-brand/10 px-2 py-0.5 text-[10px] text-brand"
                    >Over $150</span
                  ></span
                >
                <span class="font-bold text-brand uppercase">Free</span>
              </li>
            </ul>
          </div>
        </section>

        <section>
          <h2
            class="mb-4 border-b border-outline pb-2 text-xl font-bold text-content"
          >
            High-Value Order Verification
          </h2>
          <p class="mb-4 text-brand-alert font-bold">
            Due to the high-value nature of electronics, orders exceeding $1,000
            USD may require secondary identity verification and a mandatory
            signature upon delivery.
          </p>
          <p class="mb-4">
            We will not instruct carriers to leave
            high-value inventory unattended on porches, lobbies, or loading docks under any circumstances. If you are unavailable to sign for the package, the carrier will hold the inventory at a local secure facility for pickup.
          </p>
        </section>
      </div>
    </div>
  </div>
</StorefrontLayout>
