---
import Storefront from '../../layouts/Storefront.astro';
---

<Storefront title="Authenticity Guarantee">
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
    <h1 class="mb-8 text-4xl font-bold tracking-tighter uppercase">
      The Authenticity Directive
    </h1>
    <div
      class="prose dark:prose-invert text-content-muted max-w-none font-mono text-sm"
    >
      <p>
        Symeno operates on a zero-tolerance policy for counterfeit hardware.
      </p>
      <p>
        Every unit that passes through our arbitrage network is verified against
        OEM cryptographic supply chain signatures. Serial numbers are logged
        immutably prior to dispatch.
      </p>
      <p>
        If hardware is compromised, the transaction is reversed immediately at
        our expense.
      </p>
    </div>
  </div>
</Storefront>
