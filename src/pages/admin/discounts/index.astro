---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DiscountManager from '../../components/admin/discounts/DiscountManager.svelte';
import UsageReport from '../../components/admin/discounts/UsageReport.svelte';
import { env } from 'cloudflare:workers';

if (!Astro.locals.user || (Astro.locals.user.role !== 'admin' && Astro.locals.user.role !== 'staff')) {
  return Astro.redirect('/auth/login');
}

let discounts = [];
// Mock report data - in production, this aggregates order_discounts table
let impactReports = [
  { code: 'WELCOME10', uses: 142, revenue_generated: 14200, discount_cost: 1420 },
  { code: 'BFCM50', uses: 89, revenue_generated: 8900, discount_cost: 4450 }
];

if (env.DB) {
  try {
    const { results } = await env.DB.prepare('SELECT * FROM discounts ORDER BY created_at DESC').all();
    discounts = results || [];
  } catch (e) {}
}
---

<AdminLayout title="Promotion Engine" subtitle="Rules and Discount Logic" currentPath="/admin/discounts">
  <div class="max-w-7xl space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2">
        <DiscountManager client:load discounts={discounts} />
      </div>
      <div>
        <UsageReport client:load reports={impactReports} />
      </div>
    </div>
  </div>
</AdminLayout>