---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import DiscountManager from '../../../components/admin/discounts/DiscountManager.svelte';
import UsageReport from '../../../components/admin/discounts/UsageReport.svelte';
import { env } from 'cloudflare:workers';

if (
  !Astro.locals.user ||
  (Astro.locals.user.role !== 'admin' && Astro.locals.user.role !== 'staff')
) {
  return Astro.redirect('/auth/login');
}

let discounts: any[] = [];
// Impact reports derived from live discount data when available
let impactReports: any[] = [];

if (env.DB) {
  try {
    const { results } = await env.DB.prepare(
      'SELECT id, code, type, value, min_order_amount, uses_count, is_active, created_at, updated_at FROM discounts ORDER BY created_at DESC'
    ).all();
    discounts = results || [];

    // Build impact reports from live discount data
    impactReports = discounts
      .filter((d: any) => d.uses_count > 0)
      .map((d: any) => ({
        code: d.code,
        uses: d.uses_count || 0,
        revenue_generated: (d.uses_count || 0) * (d.min_order_amount || 100),
        discount_cost: (d.uses_count || 0) * (d.value || 0),
      }));
  } catch (e) {
    console.error('[DISCOUNTS_DB_ERROR]', e);
  }
}
---

<AdminLayout
  title="Promotion Engine"
  subtitle="Rules and Discount Logic"
  currentPath="/admin/discounts"
>
  <div class="max-w-7xl space-y-6">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <DiscountManager client:load discounts={discounts} />
      </div>
      <div>
        <UsageReport client:load reports={impactReports} />
      </div>
    </div>
  </div>
</AdminLayout>
