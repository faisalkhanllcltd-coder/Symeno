---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import DiscountForm from '../../../components/admin/discounts/DiscountForm.svelte';

if (!Astro.locals.user) return Astro.redirect('/auth/login');

const breadcrumbs = [
  { label: 'Discounts', url: '/admin/discounts' },
  { label: 'New Promotion' },
];
---

<AdminLayout
  title="Initialize Promotion"
  subtitle="Configure pricing constraints"
  breadcrumbs={breadcrumbs}
  currentPath="/admin/discounts"
>
  <div class="max-w-[1200px]">
    <div class="border border-white/10 bg-[#111318] p-6">
      <DiscountForm client:load />
    </div>
  </div>
</AdminLayout>
