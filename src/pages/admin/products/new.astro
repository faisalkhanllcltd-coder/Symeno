---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/admin/products/ProductForm.svelte';

// --- STRICT RBAC GATEKEEPER ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}
const role = (user.role || '').toLowerCase();
if (!['admin', 'manager', 'staff'].includes(role)) {
  return Astro.redirect('/account');
}

const breadcrumbs = [
  { label: 'Products', url: '/admin/products' },
  { label: 'Provision Hardware' },
];
---

<AdminLayout
  title="Provision Hardware"
  subtitle="Form architecture secured"
  breadcrumbs={breadcrumbs}
  currentPath="/admin/products"
>
  <div class="rounded-lg border border-outline bg-base p-1">
    <ProductForm client:load initialData={null} />
  </div>
</AdminLayout>