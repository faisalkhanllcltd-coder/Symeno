---
import AdminLayout from '../../../layouts/AdminLayout.astro';
const user = Astro.locals.user;
if (!user || user.role !== 'admin') return Astro.redirect('/auth/admin/login');
---

<AdminLayout title="Bulk Operations | Admin">
  <div class="mx-auto max-w-4xl p-8">
    <h1 class="mb-2 text-2xl font-bold tracking-widest text-white uppercase">
      Mass Ingestion Protocol
    </h1>
    <p class="mb-8 font-mono text-xs text-white/50">
      Upload CSV matrix for bulk inventory adjustments.
    </p>
    <div
      class="cursor-pointer border border-dashed border-white/10 bg-[#111318] p-12 text-center transition-colors hover:border-[#36f4a4]/50"
    >
      <span
        class="mb-2 block text-xs font-bold tracking-widest text-white uppercase"
        >Select CSV Payload</span
      >
      <span class="font-mono text-[10px] text-white/40"
        >Strict schema enforcement active. Max 5MB.</span
      >
    </div>
  </div>
</AdminLayout>
