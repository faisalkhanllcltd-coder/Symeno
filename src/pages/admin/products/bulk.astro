---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BulkActions from '../../../components/admin/products/BulkActions.svelte';

// --- STRICT RBAC GATEKEEPER ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}
const role = (user.role || '').toLowerCase();
if (!['admin', 'manager', 'staff'].includes(role)) {
  return Astro.redirect('/account');
}
---

<AdminLayout title="Bulk Operations | Admin" currentPath="/admin/products">
  <div class="mx-auto max-w-4xl p-8">
    <h1 class="mb-2 text-2xl font-bold tracking-widest text-content uppercase">
      Mass Ingestion Protocol
    </h1>
    <p class="mb-8 font-mono text-xs text-content-muted">
      Upload CSV matrix for bulk inventory adjustments.
    </p>
    
    <BulkActions client:load />
    
  </div>
</AdminLayout>