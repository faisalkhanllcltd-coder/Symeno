---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductDataTable from '../../../components/admin/products/ProductDataTable.svelte';
import { env } from 'cloudflare:workers';

if (!Astro.locals.user || (Astro.locals.user.role !== 'admin' && Astro.locals.user.role !== 'staff')) {
  return Astro.redirect('/auth/login');
}

let products: any[] = [];
let error = '';

try {
  const db = env.DB as any;
  if (db) {
    // 100% CLAUDE SCHEMA
    const { results } = await db.prepare(
      'SELECT id, name, slug, price, in_stock, category FROM catalog_cache ORDER BY scraped_at DESC LIMIT 500'
    ).all();
    products = results || [];
  }
} catch (e) {
  console.error('[ADMIN_PRODUCTS_ERROR]', e);
  error = 'Failed to load catalog cache.';
}
---

<AdminLayout
  title="Hardware Catalog"
  subtitle="Manage edge inventory and pricing"
  currentPath="/admin/products"
  primaryAction={{ label: 'Inject Asset', url: '/admin/products/new' }}
>
  {error && (
    <div class="mb-6 rounded-sm border border-brand-alert/30 bg-brand-alert/10 p-4 font-mono text-[10px] tracking-widest text-brand-alert uppercase shadow-sm">
      {error}
    </div>
  )}

  <div class="space-y-6">
    <ProductDataTable client:load products={products} />
  </div>
</AdminLayout>