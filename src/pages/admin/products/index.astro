---
import AdminLayout from '../../../layouts/Admin.astro';

if (!Astro.locals.user) return Astro.redirect('/auth/login');
---

<AdminLayout title="Hardware Catalog" subtitle="Database population pending" currentPath="/admin/products" primaryAction={{ label: "Add Hardware", url: "/admin/products/new" }}>
  <div class="bg-[#111318] border border-white/10 p-16 flex flex-col items-center justify-center text-center">
    <svg class="w-12 h-12 text-white/10 mb-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" /></svg>
    <p class="text-white font-mono uppercase tracking-widest text-xs">Catalog engine connected. Awaiting D1 population.</p>
  </div>
</AdminLayout>