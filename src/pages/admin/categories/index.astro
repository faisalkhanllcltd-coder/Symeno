---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategoryManager from '../../../components/admin/categories/CategoryManager.svelte';
import '../../../styles/global.css';
---

<AdminLayout title="Manage Categories">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-black tracking-tight text-gray-900">Taxonomy Manager</h1>
      <p class="text-gray-500 mt-2">Manage the top-level categories for your product catalog.</p>
    </div>

    <CategoryManager client:load />
  </div>
</AdminLayout>
