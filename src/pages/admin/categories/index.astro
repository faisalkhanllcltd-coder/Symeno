---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategoryManager from '../../../components/admin/categories/CategoryManager.svelte';
import '../../../styles/global.css';
---

<AdminLayout title="Manage Categories">
  <div class="mx-auto max-w-5xl">
    <div class="mb-8">
      <h1 class="text-3xl font-black tracking-tight text-gray-900">
        Taxonomy Manager
      </h1>
      <p class="mt-2 text-gray-500">
        Manage the top-level categories for your product catalog.
      </p>
    </div>

    <CategoryManager client:load />
  </div>
</AdminLayout>
