---
// src/pages/admin/customers/index.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CustomerCRMCard from '../../../components/admin/customers/CustomerCRMCard.svelte';
import { env } from 'cloudflare:workers';

if (!Astro.locals.user) return Astro.redirect('/auth/login');

const db = env.DB;
let customers: any[] = [];

if (db) {
  try {
    const { results } = await db
      .prepare(`SELECT * FROM customers ORDER BY created_at DESC LIMIT 50`)
      .all();
    // Map DB row to exactly what the Svelte 5 component expects
    customers = (results || []).map((c: any) => ({
      name: `${c.first_name || 'Unknown'} ${c.last_name || ''}`.trim(),
      email: c.email,
      totalSpent: c.total_spent || 0,
      orderCount: c.order_count || 0,
      status: c.status || 'active',
    }));
  } catch (error: unknown) {
    if (error instanceof Error) {
      console.error(
        '[DB_ERROR] Failed to fetch customer ledger:',
        error.message
      );
    }
  }
}
---

<AdminLayout
  title="Customer Directory"
  subtitle="Registered identities and acquisition data"
  currentPath="/admin/customers"
>
  <div
    class="flex h-full flex-col overflow-hidden border border-outline bg-base"
  >
    <div
      class="flex items-center justify-between border-b border-outline bg-surface p-4"
    >
      <input
        type="text"
        placeholder="Search email or ID..."
        class="w-64 border border-outline bg-surface px-3 py-1.5 font-mono text-xs text-content placeholder:text-content-muted focus:border-brand/50 focus:outline-none"
      />
    </div>

    <div class="flex-1 overflow-y-auto p-4">
      {
        customers.length === 0 ? (
          <div class="py-12 text-center font-mono text-[10px] tracking-widest text-content-muted uppercase">
            No customers found.
          </div>
        ) : (
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            {customers.map((c) => (
              <CustomerCRMCard
                client:load
                name={c.name}
                email={c.email}
                totalSpent={c.totalSpent}
                orderCount={c.orderCount}
                status={c.status}
              />
            ))}
          </div>
        )
      }
    </div>
  </div>
</AdminLayout>
