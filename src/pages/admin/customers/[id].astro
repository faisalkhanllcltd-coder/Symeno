---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

if (!Astro.locals.user) return Astro.redirect('/auth/login');

const { id } = Astro.params;
const db = (env as any).DB;

let customer = null;
let orders: any[] = [];

if (db) {
  try {
    customer = await db
      .prepare(`SELECT * FROM customers WHERE id = ?1`)
      .bind(id)
      .first();
    if (customer) {
      const { results } = await db
        .prepare(
          `SELECT * FROM orders WHERE customer_email = ?1 ORDER BY created_at DESC`
        )
        .bind(customer.email)
        .all();
      orders = results || [];
    }
  } catch (e) {
    console.warn('DB not fully migrated', e);
  }
}

if (!customer) return Astro.redirect('/404');

const breadcrumbs = [
  { label: 'Customers', url: '/admin/customers' },
  { label: customer.id },
];
---

<AdminLayout
  title={`${customer.first_name} ${customer.last_name}`}
  subtitle={customer.email}
  breadcrumbs={breadcrumbs}
  currentPath="/admin/customers"
>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="col-span-1 h-fit border border-white/10 bg-[#111318] p-6">
      <h3
        class="mb-4 border-b border-white/10 pb-2 font-mono text-[10px] tracking-widest text-white/40 uppercase"
      >
        Identity Matrix
      </h3>
      <div class="space-y-4 font-mono text-xs">
        <div>
          <span class="mb-1 block text-white/40">Internal ID</span>
          <span class="text-[#36f4a4]">{customer.id}</span>
        </div>
        <div>
          <span class="mb-1 block text-white/40">Email Address</span>
          <span class="text-white">{customer.email}</span>
        </div>
      </div>
    </div>

    <div
      class="col-span-1 overflow-hidden border border-white/10 bg-[#111318] lg:col-span-2"
    >
      <div class="border-b border-white/10 bg-white/[0.02] p-4">
        <h2
          class="font-mono text-xs font-bold tracking-widest text-white uppercase"
        >
          Acquisition History
        </h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-white/10 bg-black/40">
              <th
                class="px-6 py-4 font-mono text-[10px] font-normal tracking-widest text-white/40 uppercase"
                >Order ID</th
              >
              <th
                class="px-6 py-4 font-mono text-[10px] font-normal tracking-widest text-white/40 uppercase"
                >Status</th
              >
              <th
                class="px-6 py-4 text-right font-mono text-[10px] font-normal tracking-widest text-white/40 uppercase"
                >Total</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.04]">
            {
              orders.map((order) => (
                <tr class="transition-colors hover:bg-white/[0.02]">
                  <td class="px-6 py-4 font-mono text-xs text-[#36f4a4]">
                    <a href={`/admin/orders/${order.id}`}>{order.id}</a>
                  </td>
                  <td class="px-6 py-4 font-mono text-[10px] font-bold tracking-widest text-white/80 uppercase">
                    {order.status}
                  </td>
                  <td class="px-6 py-4 text-right font-mono text-xs text-white">
                    ${(order.amount_total || 0).toFixed(2)}
                  </td>
                </tr>
              ))
            }
            {
              orders.length === 0 && (
                <tr>
                  <td
                    colspan="3"
                    class="px-6 py-12 text-center font-mono text-[10px] tracking-widest text-white/30 uppercase"
                  >
                    No orders found for this identity.
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
