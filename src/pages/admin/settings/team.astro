---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import TeamManager from '../../../components/admin/settings/TeamManager.svelte';
import { env } from "cloudflare:workers";

// --- STRICT RBAC GATEKEEPER ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}
const role = (user.role || '').toLowerCase();
if (!['admin', 'manager', 'staff'].includes(role)) {
  return Astro.redirect('/account');
}

// --- D1 EDGE HYDRATION ---
const db = env?.DB as any;
let results: any[] = [];

if (db) {
  try {
    const res = await db.prepare("SELECT id, email, role, name, created_at, updated_at FROM users WHERE role IN ('admin', 'staff', 'manager')").all();
    results = res.results || [];
  } catch (err) {
    console.error("[TEAM_MATRIX_ERROR]", err);
  }
}
---

<AdminLayout title="Access Control" subtitle="Staff & Operator Matrix" currentPath="/admin/settings/team">
  <div class="max-w-6xl">
    <TeamManager client:load team={results} />
  </div>
</AdminLayout>