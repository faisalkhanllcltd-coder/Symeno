---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ShippingZoneManager from '../../../components/admin/settings/ShippingZoneManager.svelte';
import { env } from 'cloudflare:workers';

// --- STRICT RBAC GATEKEEPER ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}
const role = (user.role || '').toLowerCase();
if (!['admin', 'manager', 'staff'].includes(role)) {
  return Astro.redirect('/account');
}

// --- D1 EDGE HYDRATION ---
let shippingZones: any[] = [];
try {
  const db = env?.DB as any;
  if (db) {
    const { results } = await db.prepare('SELECT * FROM shipping_zones ORDER BY created_at DESC').all();
    shippingZones = results || [];
  }
} catch (err) {
  console.warn('[D1_SHIPPING_ZONES_WARN] Table may not exist yet or is empty.');
}
---

<AdminLayout
  title="Logistics"
  subtitle="Regional Shipping & Fulfillment"
  currentPath="/admin/settings/shipping"
>
  <div class="max-w-4xl">
    <ShippingZoneManager client:load initialZones={shippingZones} />
  </div>
</AdminLayout>