
---
import AdminLayout from '../../../layouts/Admin.astro';
const user = Astro.locals.user;
if (!user || user.role !== 'admin') return Astro.redirect('/auth/admin/login');
---
<AdminLayout title='Integrations Matrix | Admin'>
  <div class='p-8 max-w-5xl mx-auto'>
    <h1 class='text-2xl font-bold text-white uppercase tracking-widest mb-2'>External Integrations</h1>
    <p class='text-xs font-mono text-white/50 mb-8'>Manage Webhooks, ERP connections, and API keys.</p>
    <div class='bg-[#111318] border border-white/10 p-6'>
      <h3 class='text-sm font-bold text-white uppercase tracking-widest border-b border-white/10 pb-4 mb-4'>Active Webhooks</h3>
      <p class='text-xs font-mono text-white/50'>No external payload delivery configured.</p>
    </div>
  </div>
</AdminLayout>
