---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import StoreSettingsForm from '../../../components/admin/settings/StoreSettingsForm.svelte';
import { env } from 'cloudflare:workers';

// --- STRICT RBAC GATEKEEPER ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}
const role = (user.role || '').toLowerCase();
if (!['admin', 'manager', 'staff'].includes(role)) {
  return Astro.redirect('/account');
}

// --- D1 EDGE HYDRATION ---
let storeSettings = {};
try {
  const db = env?.DB as any;
  if (db) {
    const { results } = await db.prepare('SELECT * FROM store_settings LIMIT 1').all();
    if (results && results.length > 0) {
      storeSettings = results[0];
    }
  }
} catch (err) {
  console.warn('[D1_STORE_SETTINGS_WARN] Table may not exist yet or is empty. Using default empty settings.');
}
---

<AdminLayout
  title="Global Settings"
  subtitle="Core Storefront Configuration"
  currentPath="/admin/settings/store"
>
  <div class="max-w-4xl">
    <StoreSettingsForm client:load initialSettings={storeSettings} />
  </div>
</AdminLayout>