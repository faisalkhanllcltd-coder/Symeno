---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

if (
  !Astro.locals.user ||
  (Astro.locals.user.role !== 'admin' && Astro.locals.user.role !== 'staff')
) {
  return Astro.redirect('/auth/login');
}

let RMAs = [];
if (env.DB) {
  try {
    const { results } = await env.DB.prepare(
      "SELECT * FROM orders WHERE status = 'RETURN_REQUESTED'"
    ).all();
    RMAs = results || [];
  } catch (e) {}
}
---

<AdminLayout
  title="RMA Management"
  subtitle="Return Merchandise Authorizations"
  currentPath="/admin/orders"
>
  <div class="overflow-hidden border border-outline bg-base">
    <table class="w-full border-collapse text-left">
      <thead>
        <tr
          class="border-b border-outline bg-surface font-mono text-[10px] tracking-widest text-content-muted uppercase"
        >
          <th class="p-4 font-normal">Order ID</th>
          <th class="p-4 font-normal">Customer</th>
          <th class="p-4 text-right font-normal">Value</th>
          <th class="p-4 text-center font-normal">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-outline">
        {
          RMAs.map((rma) => (
            <tr class="transition-colors hover:bg-surface">
              <td class="p-4 font-mono text-xs text-brand">
                <a href={`/admin/orders/${rma.id}`}>{rma.id}</a>
              </td>
              <td class="p-4 font-mono text-xs text-content-muted">
                {rma.customer_email}
              </td>
              <td class="p-4 text-right font-mono text-xs text-content">
                ${rma.total}
              </td>
              <td class="p-4 text-center">
                <a
                  href={`/admin/orders/${rma.id}`}
                  class="border border-outline px-3 py-1 font-mono text-[10px] tracking-widest text-content uppercase hover:opacity-80"
                >
                  Review
                </a>
              </td>
            </tr>
          ))
        }
        {
          RMAs.length === 0 && (
            <tr>
              <td
                colspan="4"
                class="p-8 text-center font-mono text-xs text-content-muted uppercase"
              >
                No active return requests.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
