---
import AdminLayout from '../../../layouts/Admin.astro';
import FulfillmentTracker from '../../../components/admin/orders/FulfillmentTracker.svelte';

if (!Astro.locals.user) return Astro.redirect('/auth/login');

const { id } = Astro.params;

const breadcrumbs = [
  { label: 'Orders', url: '/admin/orders' },
  { label: id || 'Order Details' }
];
---

<AdminLayout title="Order Operations" subtitle={`Managing deployment for ${id}`} breadcrumbs={breadcrumbs} currentPath="/admin/orders">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-[#111318] border border-white/10 p-6">
         <FulfillmentTracker status="processing" client:load />
      </div>
      
      <div class="bg-[#111318] border border-white/10 p-6">
        <h3 class="text-xs font-bold text-white uppercase tracking-widest font-mono border-b border-white/10 pb-3 mb-4">Manifest</h3>
        <div class="flex justify-between items-center py-3 border-b border-white/[0.04]">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-[#1A1D23] border border-white/10 shrink-0"></div>
            <div>
              <p class="text-sm text-white font-bold">Sony WH-1000XM5</p>
              <p class="text-[10px] font-mono text-white/40">SKU: SNY-XM5-BLK</p>
            </div>
          </div>
          <div class="text-right">
            <p class="text-sm font-mono text-white font-bold">$299.00</p>
            <p class="text-[10px] font-mono text-white/40">Qty: 1</p>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-[#111318] border border-white/10 p-6">
        <h3 class="text-xs font-bold text-white uppercase tracking-widest font-mono border-b border-white/10 pb-3 mb-4">Execute Action</h3>
        <form class="space-y-4">
          <div class="space-y-1.5">
            <label class="text-[10px] font-mono text-white/50 uppercase tracking-widest">Update Status</label>
            <select class="w-full bg-[#1A1D23] border border-white/10 text-white px-3 py-2 text-sm focus:outline-none focus:border-[#36f4a4]/50 rounded-none cursor-pointer">
              <option value="pending">Pending</option>
              <option value="processing" selected>Processing</option>
              <option value="shipped">Shipped</option>
            </select>
          </div>
          <div class="space-y-1.5">
            <label class="text-[10px] font-mono text-white/50 uppercase tracking-widest">Inject Tracking Number</label>
            <input type="text" class="w-full bg-[#1A1D23] border border-white/10 text-white px-3 py-2 text-sm focus:outline-none focus:border-[#36f4a4]/50 rounded-none font-mono" placeholder="1Z9999999999999999" />
          </div>
          <button type="button" class="w-full bg-[#36f4a4] text-[#003822] px-4 py-3 text-xs font-bold uppercase tracking-widest hover:bg-white transition-colors focus:outline-none">
            Commit Changes
          </button>
        </form>
      </div>
    </div>

  </div>
</AdminLayout>