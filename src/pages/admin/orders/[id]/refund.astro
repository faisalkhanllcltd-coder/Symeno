---
// src/pages/admin/orders/[id]/refund.astro
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import RefundForm from '../../../../components/admin/orders/RefundForm.svelte';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
const role = (user.role || '').toLowerCase();
if (!['admin', 'manager'].includes(role)) return Astro.redirect('/admin/orders');

const { id } = Astro.params;
let order = null;

try {
  const db = env?.DB as any;
  if (db && id) {
    const { results } = await db.prepare('SELECT * FROM orders WHERE id = ?1').bind(id).all();
    if (results.length > 0) order = results[0];
    else return Astro.redirect('/404');
  }
} catch (e) {
  console.error('[ORDER_FETCH_ERROR]', e);
}

const breadcrumbs = [
  { label: 'Orders', url: '/admin/orders' },
  { label: id || 'Order', url: `/admin/orders/${id}` },
  { label: 'Reverse Payment' },
];
---

<AdminLayout 
  title="Initialize Refund" 
  subtitle={`Reversing capital for transaction: ${id}`}
  breadcrumbs={breadcrumbs}
  currentPath="/admin/orders"
>
  <div class="max-w-3xl">
    <div class="border border-outline bg-base p-6 shadow-sm">
       <div class="mb-6 border-b border-outline pb-4">
         <p class="font-mono text-[10px] text-content-muted uppercase">Authorized Amount</p>
         <p class="text-2xl font-black text-content">$\</p>
       </div>
      <RefundForm client:load orderId={id as string} maxAmount={order?.total_amount?.toString() || "0"} />
    </div>
  </div>
</AdminLayout>
