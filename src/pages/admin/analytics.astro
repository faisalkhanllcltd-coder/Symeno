---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DateRangePicker from '../../components/admin/analytics/DateRangePicker.svelte';
import RevenueOverview from '../../components/admin/analytics/RevenueOverview.svelte';
import OrderMetrics from '../../components/admin/analytics/OrderMetrics.svelte';
import ConversionFunnel from '../../components/admin/analytics/ConversionFunnel.svelte';
import ProductPerformance from '../../components/admin/analytics/ProductPerformance.svelte';
import { env } from 'cloudflare:workers';

if (
  !Astro.locals.user ||
  (Astro.locals.user.role !== 'admin' && Astro.locals.user.role !== 'staff')
) {
  return Astro.redirect('/auth/login');
}

// Pre-fetch initial data server-side
const db = env.DB;
let analyticsData = { revenue: [] as any[], orders: [] as any[], products: [] as any[], customers: [] as any[] };

if (db) {
  try {
    const [rev, ord, prod] = await db.batch([
      db.prepare(
        "SELECT DATE(created_at) as date, SUM(total) as amount FROM orders WHERE status != 'CANCELLED' GROUP BY DATE(created_at) ORDER BY date DESC LIMIT 30"
      ),
      db.prepare(
        'SELECT status, COUNT(*) as count FROM orders GROUP BY status'
      ),
      db.prepare(
        'SELECT title, base_price as revenue FROM products WHERE is_active = 1 ORDER BY base_price DESC LIMIT 5'
      ),
    ]);
    analyticsData.revenue = rev.results || [];
    analyticsData.orders = ord.results || [];
    analyticsData.products = prod.results || [];
  } catch (e) {}
}
---

<AdminLayout
  title="Analytics Studio"
  subtitle="Enterprise Platform Telemetry"
  currentPath="/admin/analytics"
>
  <div class="max-w-7xl space-y-6">
    <div class="flex items-center justify-between">
      <DateRangePicker client:load selectedRange="30d" />
      <button
        class="border border-white/10 px-4 py-2 font-mono text-[10px] tracking-widest text-white/50 transition-colors hover:text-white"
      >
        Export Report PDF
      </button>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <RevenueOverview client:load data={analyticsData.revenue} />
      </div>
      <div>
        <OrderMetrics client:load data={analyticsData.orders} />
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <ConversionFunnel client:load />
      <ProductPerformance client:load products={analyticsData.products} />
    </div>
  </div>
</AdminLayout>
