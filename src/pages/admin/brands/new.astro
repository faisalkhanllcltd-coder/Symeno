---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BrandManager from '../../../components/admin/brands/BrandManager.svelte';

// --- STRICT RBAC GATEKEEPER ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}
const role = (user.role || '').toLowerCase();
if (!['admin', 'manager', 'staff'].includes(role)) {
  return Astro.redirect('/account');
}

const breadcrumbs = [
  { label: 'Brands', url: '/admin/brands' },
  { label: 'New Brand' },
];
---

<AdminLayout
  title="Authorize Supplier"
  subtitle="Inject new brand into logistics matrix"
  breadcrumbs={breadcrumbs}
  currentPath="/admin/brands"
>
  <div class="max-w-[1200px]">
    <div class="border border-outline bg-base p-6">
      <BrandManager client:load />
    </div>
  </div>
</AdminLayout>