---
import AdminLayout from '../../../layouts/AdminLayout.astro';

if (!Astro.locals.user) return Astro.redirect('/auth/login');

const breadcrumbs = [{ label: 'Brands' }];

// Mock Data
const brands = [
  { id: 'BRD-01', name: 'Sony', status: 'Active', skuCount: 14 },
  { id: 'BRD-02', name: 'LG', status: 'Active', skuCount: 8 },
];
---

<AdminLayout
  title="Brand Matrix"
  subtitle="Supplier authorization controls"
  breadcrumbs={breadcrumbs}
  currentPath="/admin/brands"
  primaryAction={{ label: 'Add Brand', url: '/admin/brands/new' }}
>
  <div
    class="flex h-full flex-col overflow-hidden border border-outline bg-base"
  >
    <div class="flex-1 overflow-x-auto">
      <table class="w-full border-collapse text-left whitespace-nowrap">
        <thead>
          <tr
            class="border-b border-outline bg-surface font-mono text-[10px] tracking-widest text-content-muted uppercase"
          >
            <th class="px-4 py-4 font-normal">Brand ID</th>
            <th class="px-4 py-4 font-normal">Name</th>
            <th class="px-4 py-4 font-normal">Active SKUs</th>
            <th class="px-4 py-4 text-right font-normal">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline">
          {
            brands.map((brand) => (
              <tr class="group transition-colors hover:bg-surface">
                <td class="px-4 py-3 font-mono text-xs text-content-muted">
                  {brand.id}
                </td>
                <td class="px-4 py-3 text-xs font-bold text-content transition-colors group-hover:text-brand">
                  {brand.name}
                </td>
                <td class="px-4 py-3 font-mono text-xs text-content">
                  {brand.skuCount}
                </td>
                <td class="px-4 py-3 text-right">
                  <span class="inline-block border border-brand/30 bg-brand/10 px-2 py-1 text-[9px] font-bold tracking-widest text-brand uppercase">
                    {brand.status}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
