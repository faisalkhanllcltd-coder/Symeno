---
// src/pages/admin/orders.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import OrderDataTable from '../../components/admin/orders/OrderDataTable.svelte';
// ASSEMBLY: Wiring FulfillmentTracker for order pipeline visualization
import FulfillmentTracker from '../../components/admin/orders/FulfillmentTracker.svelte';
import { env } from 'cloudflare:workers';

if (!Astro.locals.user) {
  return Astro.redirect('/auth/login');
}

// Live D1 query — orders table columns: id, user_id, customer_email, shipping_name, shipping_address, total_amount, status, created_at, updated_at
let orders: any[] = [];

try {
  const db = env.DB as any;
  if (db) {
    const { results } = await db.prepare(
      `SELECT id, customer_email, total_amount, status, created_at
       FROM orders
       ORDER BY created_at DESC
       LIMIT 50`
    ).all();

    orders = (results || []).map((row: any) => ({
      id: row.id,
      customer: row.customer_email || 'N/A',
      total: `$${Number(row.total_amount || 0).toFixed(2)}`,
      status: row.status || 'pending',
      date: row.created_at ? new Date(row.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A',
    }));
  }
} catch (e) {
  console.error('[ORDERS_DB_ERROR]', e);
}

// Derive fulfillment summary from orders for the tracker
const pendingCount = orders.filter(o => o.status === 'PENDING_DISPATCH' || o.status === 'pending').length;
const fulfilledCount = orders.filter(o => o.status === 'FULFILLED' || o.status === 'fulfilled').length;
const totalCount = orders.length;
---

<AdminLayout title="Order Matrix">
  <div class="space-y-6">
    <FulfillmentTracker
      client:load
      status={pendingCount > 0 ? 'processing' : fulfilledCount === totalCount && totalCount > 0 ? 'delivered' : 'pending'}
    />

    <div
      class="flex h-full flex-col overflow-hidden border border-outline bg-base"
    >
      <div
        class="flex items-center justify-between border-b border-outline bg-surface p-4"
      >
        <input
          type="text"
          placeholder="Search orders by ID or email..."
          class="w-64 border border-outline bg-surface px-3 py-1.5 font-mono text-xs text-content placeholder:text-content-muted focus:border-brand/50 focus:outline-none"
        />
        <div class="flex gap-2">
          <button
            class="border border-outline px-3 py-1.5 font-mono text-[10px] tracking-widest text-content-muted uppercase transition-colors hover:text-content focus:outline-none"
            >Export CSV</button
          >
        </div>
      </div>

      <div class="flex-1 overflow-x-auto">
        {orders.length > 0 ? (
          <OrderDataTable client:load orders={orders} />
        ) : (
          <div class="flex items-center justify-center p-16">
            <p class="text-content-muted font-mono text-xs tracking-widest uppercase">
              No orders in the system. Incoming transactions will appear here.
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</AdminLayout>
