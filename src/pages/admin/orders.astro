---
// src/pages/admin/orders.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import OrderDataTable from '../../components/admin/orders/OrderDataTable.svelte';

if (!Astro.locals.user) {
  return Astro.redirect('/auth/login');
}

// MOCK DATA: Ready for D1 Database replacement
const orders = [
  {
    id: 'SYM-8842',
    customer: 'operator@symeno.com',
    total: '$142.50',
    status: 'PENDING_DISPATCH',
    date: 'Oct 12, 2025',
  },
  {
    id: 'SYM-7190',
    customer: 'client@external.net',
    total: '$89.00',
    status: 'FULFILLED',
    date: 'Sep 04, 2025',
  },
  {
    id: 'SYM-6631',
    customer: 'wholesale@corp.com',
    total: '$1,240.00',
    status: 'PAYMENT_FAILED',
    date: 'Aug 22, 2025',
  },
];
---

<AdminLayout
  title="Order Matrix"
  subtitle="Fulfillment and Dispatch Ledger"
  currentPath="/admin/orders"
>
  <div
    class="flex h-full flex-col overflow-hidden border border-outline bg-base"
  >
    <div
      class="flex items-center justify-between border-b border-outline bg-surface p-4"
    >
      <input
        type="text"
        placeholder="Search orders by ID or email..."
        class="w-64 border border-outline bg-surface px-3 py-1.5 font-mono text-xs text-content placeholder:text-content-muted focus:border-brand/50 focus:outline-none"
      />
      <div class="flex gap-2">
        <button
          class="border border-outline px-3 py-1.5 font-mono text-[10px] tracking-widest text-content-muted uppercase transition-colors hover:text-content focus:outline-none"
          >Export CSV</button
        >
      </div>
    </div>

    <div class="flex-1 overflow-x-auto">
      <OrderDataTable client:load orders={orders} />
    </div>
  </div>
</AdminLayout>
