---
// src/pages/admin/orders.astro
import AdminLayout from '../../layouts/Admin.astro';
import OrderDataTable from '../../components/admin/orders/OrderDataTable.svelte';

if (!Astro.locals.user) {
  return Astro.redirect('/auth/login');
}

// MOCK DATA: Ready for D1 Database replacement
const orders = [
  { id: "SYM-8842", customer: "operator@symeno.com", total: "$142.50", status: "PENDING_DISPATCH", date: "Oct 12, 2025" },
  { id: "SYM-7190", customer: "client@external.net", total: "$89.00", status: "FULFILLED", date: "Sep 04, 2025" },
  { id: "SYM-6631", customer: "wholesale@corp.com", total: "$1,240.00", status: "PAYMENT_FAILED", date: "Aug 22, 2025" }
];
---

<AdminLayout 
  title="Order Matrix" 
  subtitle="Fulfillment and Dispatch Ledger"
  currentPath="/admin/orders"
>
  <div class="bg-[#111318] border border-white/10 overflow-hidden flex flex-col h-full">
    
    <div class="p-4 border-b border-white/10 flex justify-between items-center bg-white/[0.02]">
      <input type="text" placeholder="Search orders by ID or email..." class="bg-[#1A1D23] border border-white/10 text-white px-3 py-1.5 text-xs focus:outline-none focus:border-[#36f4a4]/50 font-mono w-64 placeholder:text-white/30" />
      <div class="flex gap-2">
        <button class="border border-white/10 text-white/60 hover:text-white px-3 py-1.5 text-[10px] font-mono uppercase tracking-widest transition-colors focus:outline-none">Export CSV</button>
      </div>
    </div>

    <div class="overflow-x-auto flex-1">
      <OrderDataTable client:load orders={orders} />
    </div>

  </div>
</AdminLayout>