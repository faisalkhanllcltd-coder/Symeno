---
// src/pages/admin/inventory/index.astro
import AdminLayout from '../../../layouts/Admin.astro';
// FIX 1: Import path corrected to the new domain-driven architecture
import InventoryTable from '../../../components/admin/inventory/InventoryTable.svelte';
// FIX 2: Secure Cloudflare Edge Bindings (dropping legacy getDb)
import { env } from 'cloudflare:workers';

if (!Astro.locals.user) return Astro.redirect('/auth/login');

const db = env.DB;
let inventoryData: any[] = [];

if (db) {
  try {
    const { results } = await db.prepare(`
      SELECT 
        p.id, p.title, p.is_active, v.sku, v.stock_quantity, v.wholesale_cost, v.retail_price
      FROM products p
      LEFT JOIN product_variants v ON p.id = v.product_id
      ORDER BY p.id DESC
    `).all();
    inventoryData = results || [];
  } catch (error: unknown) {
    if (error instanceof Error) {
      console.error("[DB_ERROR] Failed to fetch inventory:", error.message);
    }
  }
}
---

<AdminLayout 
  title="Inventory Matrix" 
  subtitle="Live cross-reference with D1 Edge"
  currentPath="/admin/inventory"
  primaryAction={{ label: "New Product", url: "/admin/inventory/new" }}
>
  <div class="bg-[#111318] border border-white/10">
    <InventoryTable client:load inventory={inventoryData} />
  </div>
</AdminLayout>