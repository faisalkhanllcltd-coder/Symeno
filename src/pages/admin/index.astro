---
// src/pages/admin/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import KPICards from '../../components/admin/dashboard/KPICards.svelte';
import RevenueChart from '../../components/admin/dashboard/RevenueChart.svelte';
import RecentOrders from '../../components/admin/dashboard/RecentOrders.svelte';
import TopProducts from '../../components/admin/dashboard/TopProducts.svelte';
import LowStockAlert from '../../components/admin/dashboard/LowStockAlert.svelte';
import ActivityFeed from '../../components/admin/dashboard/ActivityFeed.svelte';
import { env } from 'cloudflare:workers';

if (!Astro.locals.user || (Astro.locals.user.role !== 'admin' && Astro.locals.user.role !== 'staff')) {
  return Astro.redirect('/auth/login');
}

const db = env.DB;

// DEFAULT TELEMETRY STATE (Safeguards against empty/missing tables during initial boot)
let metrics = {
  revenueToday: 0, revenueChange: 0, ordersToday: 0, ordersWeek: 0,
  newCustomers: 0, conversionRate: 0, aov: 0, pendingFulfillment: 0,
  lowStockCount: 0, pendingReturns: 0
};
let recentOrders: any[] = [];
let lowStockItems: any[] = [];
let topProducts: any[] = [];
let chartData: any[] = [];
let systemFeed: any[] = [{ time: new Date().toLocaleTimeString(), message: "Admin Session Authenticated." }];

if (db) {
  try {
    // 1. Fetch Orders Telemetry — using correct column name: total_amount
    const ordersData = await db.prepare(
      "SELECT id, customer_email, total_amount, status, created_at FROM orders ORDER BY created_at DESC LIMIT 5"
    ).all();
    recentOrders = (ordersData.results || []).map((o: any) => ({
      id: o.id,
      customer_email: o.customer_email,
      total: o.total_amount,
      status: o.status,
      created_at: o.created_at,
    }));

    const pendingOrders = await db.prepare("SELECT COUNT(*) as count FROM orders WHERE status = 'PENDING_DISPATCH' OR status = 'pending'").first();
    metrics.pendingFulfillment = (pendingOrders?.count as number) || 0;

    // Compute total revenue from all orders
    const revenueResult = await db.prepare("SELECT COALESCE(SUM(total_amount), 0) as total_revenue, COUNT(*) as order_count FROM orders").first();
    const totalRevenue = (revenueResult?.total_revenue as number) || 0;
    const orderCount = (revenueResult?.order_count as number) || 0;
    metrics.aov = orderCount > 0 ? totalRevenue / orderCount : 0;
    metrics.revenueToday = totalRevenue;
    metrics.ordersWeek = orderCount;

    // 2. Fetch Top Products from actual catalog by price tier (real data)
    const topProductsResult = await db.prepare(
      `SELECT title, basePrice as revenue FROM rapidapi_cache ORDER BY basePrice DESC LIMIT 5`
    ).all();
    topProducts = (topProductsResult.results || []).map((p: any) => ({
      title: p.title,
      revenue: p.revenue,
    }));

    // 3. Chart Data derived from catalog distribution by category (real data)
    const catDistribution = await db.prepare(
      `SELECT category as date, COUNT(*) as amount FROM rapidapi_cache GROUP BY category ORDER BY amount DESC`
    ).all();
    chartData = (catDistribution.results || []).map((row: any) => ({
      date: row.date,
      amount: row.amount,
    }));

    // 4. Inventory telemetry — check products table if it has data
    try {
      const productCount = await db.prepare("SELECT COUNT(*) as cnt FROM products WHERE stock <= 5 AND stock >= 0").first();
      metrics.lowStockCount = (productCount?.cnt as number) || 0;
    } catch {
      // products table may have different schema, fail silently
    }

    // 5. Customer count
    try {
      const customerCount = await db.prepare("SELECT COUNT(*) as cnt FROM customers").first();
      metrics.newCustomers = (customerCount?.cnt as number) || 0;
    } catch {
      // customers table may be empty, fail silently
    }

  } catch (error: unknown) {
    if (error instanceof Error) console.error("[DASHBOARD_DB_ERROR]", error.message);
  }
}
---

<AdminLayout title="Command Center">
  <div class="max-w-7xl space-y-6">

    <div class="flex flex-wrap items-center gap-4">
      <a href="/admin/products/new" class="bg-brand text-brand-dark px-6 py-2 text-[10px] font-bold uppercase tracking-widest transition-colors hover:opacity-80">
        + New Product
      </a>
      {metrics.pendingFulfillment > 0 && (
        <a href="/admin/orders" class="border border-outline bg-surface text-content flex items-center gap-2 px-4 py-2 font-mono text-[10px] tracking-widest transition-colors hover:border-brand/30">
          <span class="h-2 w-2 animate-pulse rounded-full bg-amber-400"></span>
          Pending Orders: {metrics.pendingFulfillment}
        </a>
      )}
      <a href="/admin/returns" class="border border-outline text-content-muted px-4 py-2 font-mono text-[10px] tracking-widest transition-colors hover:text-content">
        Process Returns
      </a>
    </div>

    <KPICards client:load metrics={metrics} />

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <RevenueChart client:load data={chartData} />
      </div>
      <div>
        <TopProducts client:load products={topProducts} />
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <RecentOrders client:load orders={recentOrders} />
      </div>
      <div class="space-y-6">
        <LowStockAlert client:load items={lowStockItems} />
        <ActivityFeed client:load activities={systemFeed} />
      </div>
    </div>

  </div>
</AdminLayout>