---
import StorefrontLayout from '../../layouts/Storefront.astro';
import ReturnRequestForm from '../../components/storefront/returns/ReturnRequestForm.svelte';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) {
  // Save return URL so they come back here after login
  return Astro.redirect('/auth/login?redirect=/support/start-return');
}

let eligibleOrders: any[] = [];
const db = (env as any).DB;

if (db) {
  try {
    // Fetch orders from last 30 days that are delivered
    const { results } = await db
      .prepare(
        `
      SELECT id, created_at, total, status
      FROM orders
      WHERE customer_id = ? AND status IN ('DELIVERED', 'SHIPPED')
      ORDER BY created_at DESC LIMIT 10
    `
      )
      .bind(user.id)
      .all();
    eligibleOrders = results || [];
  } catch (e) {
    console.error('[RETURNS_DB_ERROR]', e);
  }
}
---

<StorefrontLayout title="Start a Return | Symeno">
  <main class="px-6 pt-32 pb-24">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h1
        class="text-content mb-4 text-3xl font-bold tracking-tighter uppercase md:text-5xl"
      >
        Reverse Logistics
      </h1>
      <p class="text-content-muted mx-auto max-w-xl font-mono text-sm">
        We engineer our products to perfection, but if something isn't right,
        our RMA protocol ensures a seamless resolution.
      </p>
    </div>

    <ReturnRequestForm client:load recentOrders={eligibleOrders} />
  </main>
</StorefrontLayout>

