---
import StorefrontLayout from '../../layouts/Storefront.astro';
import GuestTracker from '../../components/storefront/support/GuestTracker.svelte';
---

<StorefrontLayout title="Track Logistics | Symeno">
  <main class="min-h-screen px-6 pt-32 pb-24">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <h1
        class="mb-4 text-3xl font-bold tracking-tighter text-white uppercase md:text-5xl"
      >
        Logistics Telemetry
      </h1>
      <p class="mx-auto max-w-xl font-mono text-sm text-white/60">
        Enter your credentials to intercept real-time routing data for your
        shipment.
      </p>
    </div>
    <GuestTracker client:load />
  </main>
</StorefrontLayout>
