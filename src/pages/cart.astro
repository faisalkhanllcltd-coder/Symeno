---
import StorefrontLayout from '../layouts/Storefront.astro';
import CartView from '../components/storefront/CartView.svelte';
---

<StorefrontLayout title="Your Cart">
  <div class="min-h-screen bg-base py-8 px-4 sm:py-14 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8 sm:mb-12">
        <h1
          class="mb-2 text-3xl font-bold tracking-tight text-content md:text-5xl"
        >
          Secure Cart.
        </h1>
        <p class="text-sm font-light text-content-muted md:text-base">
          Inventory is held for 15 minutes.
        </p>
      </div>

      <CartView client:load /> 
    </div>
  </div>
</StorefrontLayout>