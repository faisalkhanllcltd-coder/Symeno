---
import StorefrontLayout from '../layouts/Storefront.astro';
import CartView from '../components/storefront/CartView.svelte';
---

<StorefrontLayout title="Your Cart">
  <div class="bg-[#0b1516] min-h-screen py-12 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12">
        <h1 class="text-3xl md:text-5xl font-bold text-white tracking-tight mb-2">Secure Cart.</h1>
        <p class="text-[#dae5e6]/60 font-light text-sm md:text-base">Inventory is held for 15 minutes.</p>
      </div>

      <CartView client:load />

    </div>
  </div>
</StorefrontLayout>
