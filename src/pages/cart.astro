---
import StorefrontLayout from '../layouts/Storefront.astro';
import CartView from '../components/storefront/CartView.svelte';
---

<StorefrontLayout title="Your Cart">
  <div class="min-h-screen bg-[#0b1516] py-12 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h1
          class="mb-2 text-3xl font-bold tracking-tight text-white md:text-5xl"
        >
          Secure Cart.
        </h1>
        <p class="text-sm font-light text-[#dae5e6]/60 md:text-base">
          Inventory is held for 15 minutes.
        </p>
      </div>

      <CartView client:load />
    </div>
  </div>
</StorefrontLayout>
