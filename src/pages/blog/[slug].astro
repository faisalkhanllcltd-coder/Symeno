---
import Storefront from '../../layouts/Storefront.astro';

// If using Astro Content Collections, this would use getStaticPaths()
// For SSR, we read params directly.
const { slug } = Astro.params;
---

<Storefront title={`Transmission: ${slug}`}>
  <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
    <a
      href="/blog"
      class="text-content-muted hover:text-brand mb-8 inline-block font-mono text-xs tracking-widest uppercase transition-colors"
      >&larr; Return to Index</a
    >
    <h1 class="mb-6 text-4xl font-bold tracking-tighter uppercase">
      Transmission: <span class="text-brand">{slug}</span>
    </h1>
    <div
      class="bg-surface border-outline shadow-ambient text-content-muted rounded-xl border p-8 font-mono text-sm leading-relaxed"
    >
      <p>Secure content payload for slug '{slug}' is rendering...</p>
    </div>
  </div>
</Storefront>
