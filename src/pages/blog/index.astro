---
import StorefrontLayout from '../../layouts/Storefront.astro';

const posts = [
  {
    title: 'How Global Arbitrage Drops Hardware Prices by 30%',
    slug: 'global-arbitrage-explained',
    date: 'April 8, 2026',
  },
  {
    title: 'Are Refurbished Units Worth the Risk? A Data Analysis',
    slug: 'refurbished-data-analysis',
    date: 'April 1, 2026',
  },
];
---

<StorefrontLayout title="Intelligence Blog">
  <div class="mx-auto max-w-4xl px-4 py-20">
    <h1 class="mb-12 text-3xl font-bold tracking-tight text-gray-900 uppercase">
      Intelligence.
    </h1>

    <div class="space-y-8">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group block border-b border-gray-200 pb-8"
          >
            <p class="mb-2 font-mono text-[10px] tracking-widest text-gray-400 uppercase">
              {post.date}
            </p>
            <h2 class="text-xl font-bold text-gray-900 transition-colors group-hover:text-[#10b981]">
              {post.title}
            </h2>
          </a>
        ))
      }
    </div>
  </div>
</StorefrontLayout>
