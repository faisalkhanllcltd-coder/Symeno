---
import StorefrontLayout from '../../layouts/Storefront.astro';
import { env } from 'cloudflare:workers';

// FORCE EDGE SSR: Remove getStaticPaths so dynamic D1 pricing and edge caching can operate.
export const prerender = false;

// PERFORMANCE UPGRADE: Cloudflare CDN Caching Strategy
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
);

const { category } = Astro.params;
if (!category) return Astro.redirect('/404');

// Category Metadata mapping
const categoryMeta: Record<string, { name: string; desc: string }> = {
  audio: {
    name: 'Audio & Acoustics',
    desc: 'Studio-grade sound reproduction hardware.',
  },
  displays: {
    name: 'Displays & Monitors',
    desc: 'High-refresh rate visual matrices.',
  },
  peripherals: {
    name: 'Peripherals & Input',
    desc: 'Precision tactile interfaces and mechanical switches.',   
  },
  components: {
    name: 'Core Components',
    desc: 'Raw processing and storage units.',
  },
};

const meta = categoryMeta[category as string];
if (!meta) return Astro.redirect('/404');

// Upgraded Astro v6 D1 Binding
const db = env.DB;
let activeProducts: any[] = [];

if (db) {
  try {
    const { results } = await db
      .prepare(
        `
      SELECT slug, title as name, base_price as price, retail_price as retail, brand
      FROM products
      WHERE category = ?1 AND stock_status != 'OUT_OF_STOCK'
    `
      )
      .bind(category)
      .all();
    activeProducts = results || [];
  } catch (error) {
    console.error('[D1_CATEGORY_QUERY_ERROR]', error);
  }
}
---

<StorefrontLayout
  title={`${meta.name} | Wholesale Arbitrage | Symeno`}
  description={meta.desc}
>
  <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.02]"    
      style="background-image: linear-gradient(var(--color-outline) 1px, transparent 1px), linear-gradient(90deg, var(--color-outline) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <nav
      class="relative z-10 mb-8 flex font-mono text-[10px] tracking-widest text-content-muted uppercase"
    >
      <a href="/" class="transition-colors hover:text-content focus:outline-none"
        >Base</a
      >
      <span class="mx-2">/</span>
      <a
        href="/shop"
        class="transition-colors hover:text-content focus:outline-none">Catalog</a
      >
      <span class="mx-2">/</span>
      <span class="text-brand">{meta.name}</span>
    </nav>

    <div class="relative z-10 mb-12 border-b border-outline pb-8">   
      <h1
        class="group mb-4 text-4xl font-bold tracking-tighter text-content uppercase md:text-5xl"
      >
        {meta.name}<span class="text-brand">.</span>
      </h1>
      <div
        class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center"
      >
        <p class="max-w-xl font-mono text-sm text-content-muted">{meta.desc}</p>
        <span
          class="border border-outline bg-surface px-3 py-1 font-mono text-[10px] tracking-widest text-content-muted uppercase shadow-lg" 
        >
          {activeProducts.length} Units Secured
        </span>
      </div>
    </div>

    <div
      class="relative z-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        activeProducts.length > 0 ? (
          activeProducts.map((product) => (
            <a
              href={`/shop/product/${product.slug}`}
              class="group relative flex flex-col focus:outline-none"
            >
              <div class="relative mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden border border-outline bg-surface transition-colors group-hover:border-brand/50">
                <div class="absolute top-0 left-0 h-2 w-2 border-t border-l border-outline" />
                <div class="absolute right-0 bottom-0 h-2 w-2 border-r border-b border-outline" />

                {product.retail > product.price && (
                  <div class="absolute top-3 left-3 z-10 border border-brand/30 bg-brand/10 px-2 py-1 text-[9px] font-bold tracking-widest text-brand uppercase">
                    Save ${Math.floor(product.retail - product.price)}
                  </div>
                )}
                <span class="font-mono text-[10px] text-content-muted">
                  Hardware Array
                </span>
              </div>

              <span class="mb-1 font-mono text-[10px] tracking-widest text-content-muted uppercase transition-colors group-hover:text-content">
                {product.brand}
              </span>

              <h2 class="mb-1 truncate text-sm font-bold text-content transition-colors group-hover:text-brand">
                {product.name}
              </h2>

              <div class="mt-auto flex items-baseline gap-2 font-mono">
                <span class="text-sm font-bold text-brand">
                  ${product.price.toFixed(2)}
                </span>
                {product.retail > product.price && (
                  <span class="text-[10px] text-content-muted line-through">
                    ${product.retail.toFixed(2)}
                  </span>
                )}
              </div>
            </a>
          ))
        ) : (
          <div class="col-span-full border border-outline bg-surface py-20 text-center">
            <p class="font-mono text-xs tracking-widest text-content-muted uppercase">
              Inventory Depleted. Check back next drop.
            </p>
          </div>
        )
      }
    </div>
  </div>
</StorefrontLayout>