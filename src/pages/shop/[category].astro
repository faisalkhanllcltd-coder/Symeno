---
import StorefrontLayout from '../../layouts/Storefront.astro';

// FORCE EDGE SSR: Remove getStaticPaths so dynamic D1 pricing and edge caching can operate.
export const prerender = false;

// PERFORMANCE UPGRADE: Cloudflare CDN Caching Strategy (1 Hour Edge Cache, 24 Hour Stale Revalidate)
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
);

const { category } = Astro.params;
if (!category) return Astro.redirect('/404');

// Category Metadata mapping (moved from getStaticPaths)
const categoryMeta: Record<string, { name: string; desc: string }> = {
  audio: {
    name: 'Audio & Acoustics',
    desc: 'Studio-grade sound reproduction hardware.',
  },
  displays: {
    name: 'Displays & Monitors',
    desc: 'High-refresh rate visual matrices.',
  },
  peripherals: {
    name: 'Peripherals & Input',
    desc: 'Precision tactile interfaces and mechanical switches.',
  },
  components: {
    name: 'Core Components',
    desc: 'Raw processing and storage units.',
  },
};

const meta = categoryMeta[category as string];
if (!meta) return Astro.redirect('/404');

// D1 Query for active products in this category
const db = (Astro.locals as any).runtime?.env?.DB;
let activeProducts: any[] = [];

if (db) {
  try {
    const { results } = await db
      .prepare(
        `
      SELECT slug, title as name, base_price as price, retail_price as retail, brand 
      FROM products 
      WHERE category = ?1 AND stock_status != 'OUT_OF_STOCK'
    `
      )
      .bind(category)
      .all();
    activeProducts = results || [];
  } catch (error) {
    console.error('[D1_CATEGORY_QUERY_ERROR]', error);
  }
}
---

<StorefrontLayout
  title={`${meta.name} | Wholesale Arbitrage | Symeno`}
  description={meta.desc}
>
  <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.02]"
      style="background-image: linear-gradient(#dae5e6 1px, transparent 1px), linear-gradient(90deg, #dae5e6 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <nav
      class="relative z-10 mb-8 flex font-mono text-[10px] tracking-widest text-[#dae5e6]/40 uppercase"
    >
      <a href="/" class="transition-colors hover:text-white focus:outline-none"
        >Base</a
      >
      <span class="mx-2">/</span>
      <a
        href="/shop"
        class="transition-colors hover:text-white focus:outline-none">Catalog</a
      >
      <span class="mx-2">/</span>
      <span class="text-[#36f4a4]">{meta.name}</span>
    </nav>

    <div class="relative z-10 mb-12 border-b border-[#dae5e6]/10 pb-8">
      <h1
        class="group mb-4 text-4xl font-bold tracking-tighter text-white uppercase md:text-5xl"
      >
        {meta.name}<span class="text-[#36f4a4]">.</span>
      </h1>
      <div
        class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center"
      >
        <p class="max-w-xl font-mono text-sm text-[#dae5e6]/60">{meta.desc}</p>
        <span
          class="border border-[#dae5e6]/10 bg-[#0b1516] px-3 py-1 font-mono text-[10px] tracking-widest text-[#dae5e6]/50 uppercase shadow-[0_0_10px_rgba(0,0,0,0.5)]"
        >
          {activeProducts.length} Units Secured
        </span>
      </div>
    </div>

    <div
      class="relative z-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        activeProducts.length > 0 ? (
          activeProducts.map((product) => (
            <a
              href={`/shop/product/${product.slug}`}
              class="group relative flex flex-col focus:outline-none"
            >
              <div class="relative mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden border border-[#dae5e6]/10 bg-[#0b1516] transition-colors group-hover:border-[#36f4a4]/50">
                <div class="absolute top-0 left-0 h-2 w-2 border-t border-l border-white/20" />
                <div class="absolute right-0 bottom-0 h-2 w-2 border-r border-b border-white/20" />

                {product.retail > product.price && (
                  <div class="absolute top-3 left-3 z-10 border border-[#36f4a4]/30 bg-[#131d1e] px-2 py-1 text-[9px] font-bold tracking-widest text-[#36f4a4] uppercase">
                    Save ${Math.floor(product.retail - product.price)}
                  </div>
                )}
                <span class="font-mono text-[10px] text-[#dae5e6]/20">
                  Hardware Array
                </span>
              </div>

              <span class="mb-1 font-mono text-[10px] tracking-widest text-[#dae5e6]/40 uppercase transition-colors group-hover:text-[#dae5e6]/80">
                {product.brand}
              </span>

              <h2 class="mb-1 truncate text-sm font-bold text-white transition-colors group-hover:text-[#36f4a4]">
                {product.name}
              </h2>

              <div class="mt-auto flex items-baseline gap-2 font-mono">
                <span class="text-sm font-bold text-[#36f4a4]">
                  ${product.price.toFixed(2)}
                </span>
                {product.retail > product.price && (
                  <span class="text-[10px] text-[#dae5e6]/40 line-through">
                    ${product.retail.toFixed(2)}
                  </span>
                )}
              </div>
            </a>
          ))
        ) : (
          <div class="col-span-full border border-[#dae5e6]/10 bg-[#0b1516] py-20 text-center">
            <p class="font-mono text-xs tracking-widest text-[#dae5e6]/40 uppercase">
              Inventory Depleted. Check back next drop.
            </p>
          </div>
        )
      }
    </div>
  </div>
</StorefrontLayout>
