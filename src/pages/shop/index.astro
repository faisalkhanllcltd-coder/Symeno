---
import { env } from "cloudflare:workers";
import StorefrontLayout from '../../layouts/Storefront.astro';
import FilterSidebar from '../../components/storefront/catalog/FilterSidebar.svelte';
import ProductGrid from '../../components/storefront/catalog/ProductGrid.svelte';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
);

let liveProducts: any[] = [];
let dynamicCategories: { name: string; slug: string; count: number }[] = [];
let dynamicBrands: { name: string; slug: string; count: number }[] = [];
let dbError = false;
let totalProducts = 0;

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q')?.toLowerCase() || ''; 
const filterCategory = url.searchParams.get('category')?.toLowerCase() || '';
const filterBrand = url.searchParams.get('brand')?.toLowerCase() || '';
const sort = url.searchParams.get('sort') || 'newest';    

try {
  // ARMOR: Bulletproof bindings for edge execution
  const db = (env.DB as any) || (Astro.locals as any).runtime?.env?.DB;
  if (!db) throw new Error("DB Offline - Check Edge Bindings");

  // SAFETY: Limit response to prevent memory overflow on the edge
  const { results } = await db.prepare('SELECT * FROM catalog_cache ORDER BY scraped_at DESC LIMIT 1000').all();  
  
  let filtered = results ? [...results] : [];

  const categoryMap = new Map();
  const brandMap = new Map();

  filtered.forEach((p: any) => {
    if (p.category) {
      const cSlug = String(p.category).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      categoryMap.set(cSlug, { name: p.category, slug: cSlug, count: (categoryMap.get(cSlug)?.count || 0) + 1 });
    }
    if (p.brand) {
      const bSlug = String(p.brand).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      brandMap.set(bSlug, { name: p.brand, slug: bSlug, count: (brandMap.get(bSlug)?.count || 0) + 1 });
    }
  });

  dynamicCategories = Array.from(categoryMap.values()).sort((a, b) => b.count - a.count);
  dynamicBrands = Array.from(brandMap.values()).sort((a, b) => b.count - a.count);

  if (q) {
    filtered = filtered.filter(p =>
      (p.name && String(p.name).toLowerCase().includes(q)) ||   
      (p.brand && String(p.brand).toLowerCase().includes(q)) ||
      (p.category && String(p.category).toLowerCase().includes(q)) ||
      (p.slug && String(p.slug).toLowerCase().includes(q)) 
    );
  }

  if (filterCategory) {
    filtered = filtered.filter(p => {
      const cSlug = p.category ? String(p.category).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '') : '';
      return cSlug === filterCategory;
    });
  }

  if (filterBrand) {
    filtered = filtered.filter(p => {
      const bSlug = p.brand ? String(p.brand).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '') : '';
      return bSlug === filterBrand;
    });
  }

  if (sort === 'price_asc') {
    filtered.sort((a, b) => (Number(a.price) || 0) - (Number(b.price) || 0));
  } else if (sort === 'price_desc') {
    filtered.sort((a, b) => (Number(b.price) || 0) - (Number(a.price) || 0));
  } else {
    filtered.sort((a, b) => (Number(b.scraped_at) || 0) - (Number(a.scraped_at) || 0));
  }

  totalProducts = filtered.length;

  liveProducts = filtered.map((p: any) => {
    let mainImage = '/images/system/fallback.webp'; 
    
    try {
      if (p.images_json && p.images_json !== '[]') {
        const parsedImages = JSON.parse(p.images_json);
        if (parsedImages.length > 0) mainImage = parsedImages[0]; 
      }
    } catch(e) {}

    return { 
      id: p.id, 
      slug: p.slug || p.id, 
      brand: p.brand || 'Symeno Select',
      category: p.category || 'Uncategorized',
      name: p.name,
      title: p.name,
      basePrice: p.price || 0, // Mapped for Svelte components
      price: p.price || 0,
      retail_price: p.price ? p.price * 1.15 : 0, 
      image_url: mainImage
    };
  });

} catch (error) {
  console.error('[CATALOG_EDGE_ERROR]', error);
  dbError = true;
}
---

<style is:global>
  html, body, main {
    overflow: visible !important;
  }
</style>

<StorefrontLayout 
  title="Complete Wholesale Catalog | Symeno" 
  description="Verified inventory. Shop top brands across our curated lifestyle categories."
>
  <div class="bg-base min-h-screen pt-10 pb-20 transition-colors duration-300">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8 border-b border-outline pb-6">
        <h1 class="text-content mb-3 text-3xl font-bold tracking-tighter uppercase md:text-4xl">        
          {q ? `Search: "${q}"` : filterCategory ? filterCategory.replace(/-/g, ' ') : 'The Catalog.'}        
        </h1>
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
          <p class="text-content-muted font-mono text-xs">
            {q ? `We found assets matching your query.` : 'Browse our complete inventory of premium lifestyle goods.'}
          </p>
          <span class="border border-outline bg-surface px-3 py-1 font-mono text-[10px] tracking-widest text-content-muted uppercase shadow-sm">
            {totalProducts} Units Available
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-4 mt-6">
        <aside class="hidden lg:block relative w-full h-full">
           <div class="sticky top-24 z-10 self-start">
             <FilterSidebar 
               activeBrand={filterBrand} 
               activeCategory={filterCategory} 
               activeSort={sort} 
               currentQuery={q} 
               realCategories={dynamicCategories}
               realBrands={dynamicBrands}
               client:load 
             />
           </div>
        </aside>

        <div class="lg:col-span-3">
          {dbError ? (
             <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert rounded-xl border p-6 text-center font-mono tracking-widest uppercase text-xs">
               Database Connection Offline. Please check your edge bindings.
             </div>
          ) : liveProducts.length > 0 ? (
             <ProductGrid products={liveProducts} client:load />        
          ) : (
             <div class="bg-surface border-outline rounded-xl border p-10 text-center">
               <h3 class="text-content mb-2 font-mono text-lg tracking-widest uppercase">No Matches Found</h3>
               <p class="text-content-muted text-xs">Try adjusting your filters or search parameters.</p>
               <a href="/shop" class="text-brand mt-6 inline-block text-xs font-bold hover:underline">Clear All Filters</a>
             </div>
          )}
        </div>
      </div>

    </div>
  </div>
</StorefrontLayout>