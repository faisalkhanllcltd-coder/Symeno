---
import StorefrontLayout from '../../layouts/Storefront.astro';
import type { Product } from '../../types/storefront';
import FilterSidebar from '../../components/storefront/catalog/FilterSidebar.svelte';
import ProductGrid from '../../components/storefront/catalog/ProductGrid.svelte';

export const prerender = false;

let liveProducts: any[] = [];
let dbError = false;

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q')?.toLowerCase() || '';
const brand = url.searchParams.get('brand')?.toLowerCase() || '';
const sort = url.searchParams.get('sort') || 'newest';

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (!db) throw new Error("DB Offline");

  const { results } = await db.prepare('SELECT * FROM rapidapi_cache ORDER BY last_fetched DESC LIMIT 100').all();
  let filtered = results as any[];

  if (q) {
    filtered = filtered.filter(p => 
      (p.title && p.title.toLowerCase().includes(q)) || 
      (p.category && p.category.toLowerCase().includes(q))
    );
  }

  if (brand) filtered = filtered.filter(p => p.category && p.category.toLowerCase() === brand);

  liveProducts = filtered.slice(0, 50).map((p: any) => ({
    id: p.sku,
    slug: p.sku,
    brand: p.category || 'Symeno Select',
    title: p.title,
    base_price: p.price,
    retail_price: p.price * 1.2,
    image_url: p.image_url || '' 
  }));
} catch (error) {
  dbError = true;
}
---

<StorefrontLayout title="The Catalog" description="Verified inventory.">
  <div class="bg-base min-h-screen pt-8 pb-24">
    <div class="mx-auto max-w-7xl px-4">
      <h1 class="text-content text-4xl font-bold">
        {q ? `Results for "${q}"` : 'The Catalog.'}
      </h1>
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-4 mt-8">
        <aside class="hidden lg:block">
           <FilterSidebar activeBrand={brand} activeSort={sort} currentQuery={q} client:load />
        </aside>
        <div class="lg:col-span-3">
          {dbError ? <p>Database Connection Error</p> : <ProductGrid products={liveProducts} client:load />}
        </div>
      </div>
    </div>
  </div>
</StorefrontLayout>
