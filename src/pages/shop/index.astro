---
import { env } from "cloudflare:workers";
import StorefrontLayout from '../../layouts/Storefront.astro';
import FilterSidebar from '../../components/storefront/catalog/FilterSidebar.svelte';
import ProductGrid from '../../components/storefront/catalog/ProductGrid.svelte';

export const prerender = false;

let liveProducts: any[] = [];
let dynamicCategories: { name: string; slug: string; count: number }[] = [];
let dynamicBrands: { name: string; slug: string; count: number }[] = [];
let dbError = false;
let totalProducts = 0;

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q')?.toLowerCase() || ''; 
const filterCategory = url.searchParams.get('category')?.toLowerCase() || '';
const filterBrand = url.searchParams.get('brand')?.toLowerCase() || '';
const sort = url.searchParams.get('sort') || 'newest';    

try {
  // ASTRO V6 D1 CONNECTION
  const db = env.DB as any;
  if (!db) throw new Error("DB Offline");

  // Fetch complete dataset (Removed the LIMIT 150 trap for accurate edge filtering)
  const { results } = await db.prepare('SELECT * FROM rapidapi_cache').all();  
  let filtered = results as any[];

  // 1. DYNAMIC SIDEBAR DATA EXTRACTION
  // We extract the real categories and brands before filtering so the sidebar always shows all options
  const categoryMap = new Map();
  const brandMap = new Map();

  results.forEach((p: any) => {
    if (p.category) {
      const cSlug = p.categorySlug || p.category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      categoryMap.set(cSlug, { name: p.category, slug: cSlug, count: (categoryMap.get(cSlug)?.count || 0) + 1 });
    }
    if (p.brand) {
      const bSlug = p.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      brandMap.set(bSlug, { name: p.brand, slug: bSlug, count: (brandMap.get(bSlug)?.count || 0) + 1 });
    }
  });

  dynamicCategories = Array.from(categoryMap.values()).sort((a, b) => b.count - a.count);
  dynamicBrands = Array.from(brandMap.values()).sort((a, b) => b.count - a.count);

  // 2. EDGE FILTERING PIPELINE
  if (q) {
    filtered = filtered.filter(p =>
      (p.title && p.title.toLowerCase().includes(q)) ||   
      (p.brand && p.brand.toLowerCase().includes(q)) ||
      (p.category && p.category.toLowerCase().includes(q))
    );
  }

  if (filterCategory) {
    filtered = filtered.filter(p => {
      const cSlug = p.categorySlug || p.category?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      return cSlug === filterCategory;
    });
  }

  if (filterBrand) {
    filtered = filtered.filter(p => {
      const bSlug = p.brand?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      return bSlug === filterBrand;
    });
  }

  if (sort === 'price-low') {
    filtered.sort((a, b) => (a.basePrice || 0) - (b.basePrice || 0));
  } else if (sort === 'price-high') {
    filtered.sort((a, b) => (b.basePrice || 0) - (a.basePrice || 0));
  }

  totalProducts = filtered.length;

  // 3. SECURE DATA MAPPING (Connecting the new Amazon images)
  liveProducts = filtered.map((p: any) => {
    let mainImage = p.image_url || '';
    try {
      if (p.images_json) {
        const parsedImages = JSON.parse(p.images_json);
        if (parsedImages.length > 0) mainImage = parsedImages[0]; // Hijack the grid with the new high-res image
      }
    } catch(e) { console.error('Image JSON parse failed for', p.slug); }

    return { 
      id: p.id,
      slug: p.slug,
      brand: p.brand || 'Symeno Select',
      category: p.category,
      title: p.title,
      base_price: p.basePrice,
      retail_price: p.retailPrice,
      image_url: mainImage
    };
  });

} catch (error) {
  console.error('[CATALOG_EDGE_ERROR]', error);
  dbError = true;
}
---

<StorefrontLayout 
  title="Complete Wholesale Catalog | Symeno" 
  description="Verified inventory. Shop top brands across our curated lifestyle categories."
>
  <div class="bg-base min-h-screen pt-12 pb-24 transition-colors duration-300">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8 border-b border-outline pb-8">
        <h1 class="text-content mb-4 text-4xl font-bold tracking-tighter uppercase md:text-5xl">        
          {q ? `Search: "${q}"` : filterCategory ? filterCategory.replace(/-/g, ' ') : 'The Catalog.'}        
        </h1>
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
          <p class="text-content-muted font-mono text-sm">
            {q ? `We found assets matching your query.` : 'Browse our complete inventory of premium lifestyle goods.'}
          </p>
          <span class="border border-outline bg-surface px-3 py-1 font-mono text-[10px] tracking-widest text-content-muted uppercase shadow-sm">
            {totalProducts} Units Available
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-12 lg:grid-cols-4 mt-8">
        <aside class="hidden lg:block">
           <!-- THE FIX: We are now passing the real database categories and brands into the sidebar -->
           <FilterSidebar 
             activeBrand={filterBrand} 
             activeCategory={filterCategory} 
             activeSort={sort} 
             currentQuery={q} 
             realCategories={dynamicCategories}
             realBrands={dynamicBrands}
             client:load 
           />
        </aside>

        <div class="lg:col-span-3">
          {dbError ? (
             <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert rounded-xl border p-6 text-center font-mono tracking-widest uppercase">
               Database Connection Offline. Please check your edge bindings.
             </div>
          ) : liveProducts.length > 0 ? (
             <ProductGrid products={liveProducts} client:load />        
          ) : (
            <div class="bg-surface border-outline rounded-xl border p-12 text-center">
               <h3 class="text-content mb-2 font-mono text-xl tracking-widest uppercase">No Matches Found</h3>
               <p class="text-content-muted text-sm">Try adjusting your filters or search parameters.</p>
               <a href="/shop" class="text-brand mt-6 inline-block text-sm font-bold hover:underline">Clear All Filters</a>
            </div>
          )}
        </div>
      </div>

    </div>
  </div>
</StorefrontLayout>