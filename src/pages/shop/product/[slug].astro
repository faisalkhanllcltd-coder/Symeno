---
import StorefrontLayout from '../../../layouts/Storefront.astro';
import type { Product, ProductVariant } from '../../../types/storefront';

// NEW IMPORTS: The Trust & Retention Matrix
import WishlistButton from '../../../components/storefront/WishlistButton.svelte';
import ReviewSection from '../../../components/storefront/product/ReviewSection.svelte';
import RecentlyViewed from '../../../components/storefront/product/RecentlyViewed.svelte';

// ASSEMBLY: Wiring extracted product detail components
import ProductGallery from '../../../components/storefront/product/ProductGallery.svelte';
import ProductOptions from '../../../components/storefront/product/ProductOptions.svelte';
import ProductSpecs from '../../../components/storefront/product/ProductSpecs.astro';
import CheckoutStickyBar from '../../../components/storefront/cart/CheckoutStickyBar.svelte';

// FORCE EDGE SSR & CACHING
export const prerender = false;
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
);

const { slug } = Astro.params;
const db = (Astro.locals as any).runtime?.env?.DB;
const user = Astro.locals.user; // Needed for wishlist check

let product: Product | null = null;
let variants: ProductVariant[] = [];
let reviews: any[] = [];
let isWishlisted = false;
let errorMessage = '';

if (!db) {
  errorMessage = 'Database connection failed.';
} else {
  try {
    const prodResult = await db
      .prepare(
        "SELECT * FROM products WHERE slug = ?1 AND stock_status != 'OUT_OF_STOCK'"
      )
      .bind(slug)
      .first();

    if (prodResult) {
      product = {
        id: prodResult.id,
        slug: prodResult.slug,
        brand: prodResult.brand,
        title: prodResult.title,
        description: prodResult.description,
        basePrice: prodResult.base_price,
        retailPrice: prodResult.retail_price,
        stockStatus: prodResult.stock_status,
      } as Product;

      // 1. Fetch Variants
      const varResult = await db
        .prepare('SELECT * FROM product_variants WHERE product_id = ?1')
        .bind(product.id)
        .all();
      variants = (varResult.results || []).map((v: any) => ({
        id: v.id,
        productId: v.product_id,
        sku: v.sku,
        title: v.title,
        priceAdjustment: v.price_adjustment,
        inventoryQuantity: v.inventory_quantity,
      }));

      // 2. Fetch Approved Reviews (Server-Side for SEO/Speed)
      const reviewsRes = await db
        .prepare(
          `
        SELECT r.id, r.rating, r.title, r.comment, r.created_at, r.is_verified_buyer,
               u.first_name, u.last_name 
        FROM reviews r
        LEFT JOIN users u ON r.customer_id = u.id
        WHERE r.product_id = ?1 AND r.status = 'APPROVED'
        ORDER BY r.created_at DESC
      `
        )
        .bind(product.id)
        .all();
      reviews = reviewsRes.results || [];

      // 3. Check Wishlist Status if logged in
      if (user) {
        const wishRes = await db
          .prepare(
            'SELECT id FROM wishlists WHERE customer_id = ?1 AND product_id = ?2'
          )
          .bind(user.id, product.id)
          .first();
        isWishlisted = !!wishRes;
      }
    }
  } catch (error) {
    console.error('[PRODUCT_FETCH_ERROR]', error);
    errorMessage = 'Failed to retrieve telemetry.';
  }
}

if (!product && !errorMessage) {
  return Astro.redirect('/404');
}

const relatedProducts = [
  {
    slug: 'apple-airpods-max',
    name: 'AirPods Max',
    price: 399.0,
    brand: 'Apple',
  },
  { slug: 'sony-xm4', name: 'Sony WH-1000XM4', price: 199.0, brand: 'Sony' },
];

const hasDiscount =
  product?.retailPrice && product.retailPrice > product.basePrice;

// Map variants for ProductOptions component
const optionVariants = variants.map((v) => ({
  id: String(v.id),
  name: v.title,
  available: (v.inventoryQuantity ?? 0) > 0,
}));

// Build specs object for ProductSpecs component
const productSpecs: Record<string, string> = {
  'Brand': product?.brand ?? 'N/A',
  'Model': product?.title ?? 'N/A',
  'SKU': product?.id ? String(product.id) : 'N/A',
  'Condition': 'Brand New — Factory Sealed',
  'Warranty': 'Full Manufacturer Warranty',
  'Stock Status': product?.stockStatus ?? 'N/A',
};
---

<StorefrontLayout
  title={`${product?.title || 'Unknown SKU'} | Verified Wholesale | Symeno`}
  description={`Secure the ${product?.title} at true wholesale arbitrage pricing.`}
>
  {
    product && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          '@context': 'https://schema.org/',
          '@type': 'Product',
          name: product.title,
          description: product.description,
          brand: {
            '@type': 'Brand',
            name: product.brand,
          },
          sku: product.id,
          offers: {
            '@type': 'Offer',
            url: `https://symeno.com/shop/product/${product.slug}`,
            priceCurrency: 'USD',
            price: product.basePrice.toString(),
            availability:
              product.stockStatus === 'IN_STOCK'
                ? 'https://schema.org/InStock'
                : 'https://schema.org/OutOfStock',
            itemCondition: 'https://schema.org/NewCondition',
          },
        })}
      />
    )
  }

  <div
    class="relative mx-auto max-w-7xl px-4 py-12 transition-colors duration-300 sm:px-6 lg:px-8"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.03] transition-opacity duration-300"
      style="background-image: linear-gradient(var(--color-content) 1px, transparent 1px), linear-gradient(90deg, var(--color-content) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    {
      errorMessage && (
        <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert mb-12 rounded-xl border p-6 text-center font-mono tracking-widest uppercase">
          {errorMessage}
        </div>
      )
    }

    {
      product && (
        <>
          <div
            id="product-meta"
            data-product={JSON.stringify({
              id: product.id,
              slug: product.slug,
              title: product.title,
              price: product.basePrice,
              image_url: '',
            })}
            style="display:none;"
          />

          <nav class="text-content-muted relative z-10 mb-8 flex font-mono text-[10px] tracking-widest uppercase transition-colors duration-300">
            <a
              href="/"
              class="hover:text-brand transition-colors focus:outline-none"
            >
              Base
            </a>
            <span class="mx-2">/</span>
            <a
              href="/shop"
              class="hover:text-brand transition-colors focus:outline-none"
            >
              Catalog
            </a>
            <span class="mx-2">/</span>
            <a
              href={`/brands/${product.brand.toLowerCase()}`}
              class="hover:text-brand transition-colors focus:outline-none"
            >
              {product.brand}
            </a>
            <span class="mx-2">/</span>
            <span class="text-brand max-w-[150px] truncate sm:max-w-none">
              {product.title}
            </span>
          </nav>

          <div class="relative z-10 mb-20 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-20">
            <div class="space-y-6">
              <div class="relative">
                <ProductGallery
                  client:load
                  images={[]}
                  alt={product.title}
                />
                <div class="absolute top-4 right-4 z-20">
                  <WishlistButton
                    client:load
                    productId={product.id}
                    initialState={isWishlisted}
                  />
                </div>
              </div>
            </div>

            <div class="flex flex-col justify-center">
              <a
                href={`/brands/${product.brand.toLowerCase()}`}
                class="text-content-muted hover:text-brand mb-4 inline-flex w-max items-center gap-2 font-mono text-[10px] tracking-widest uppercase transition-colors focus:outline-none"
              >
                <span class="bg-brand h-1.5 w-1.5" /> {product.brand} Directory
                &rarr;
              </a>

              <h1 class="text-content mb-4 text-3xl leading-none font-bold tracking-tighter uppercase transition-colors duration-300 md:text-5xl">
                {product.title}
              </h1>

              <div class="mb-8 flex items-end gap-4 pb-8 font-mono transition-colors duration-300">
                <span class="text-brand text-4xl font-bold tracking-tighter transition-colors duration-300">
                  ${product.basePrice.toFixed(2)}
                </span>

                {hasDiscount && (
                  <div class="flex flex-col pb-1 transition-colors duration-300">
                    <span class="text-content-muted text-[10px] tracking-widest uppercase line-through">
                      Retail: ${product.retailPrice!.toFixed(2)}
                    </span>
                    <span class="text-content text-xs font-bold tracking-widest uppercase transition-colors duration-300">
                      Arbitrage: Save $
                      {Math.floor(product.retailPrice! - product.basePrice)}
                    </span>
                  </div>
                )}
              </div>

              <p class="text-content-muted mb-10 font-mono text-sm leading-relaxed transition-colors duration-300">
                {product.description}
              </p>

              {optionVariants.length > 0 && (
                <div class="mb-8">
                  <ProductOptions
                    client:load
                    variants={optionVariants}
                  />
                </div>
              )}

              <div class="bg-surface shadow-ambient group relative mb-8 overflow-hidden rounded-xl p-6 transition-colors duration-300">
                <div class="from-brand/5 pointer-events-none absolute top-0 right-0 h-full w-32 bg-gradient-to-l to-transparent" />

                <div class="mb-6 flex items-center justify-between">
                  <span class="text-content flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase transition-colors duration-300">
                    <span class="relative flex h-2 w-2">
                      <>
                        <span class="bg-brand absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" />
                        <span class="bg-brand relative inline-flex h-2 w-2 rounded-full" />
                      </>
                    </span>{' '}
                    Network Status: Ready
                  </span>
                </div>

                {variants.length > 0 && (
                  <div class="mb-6">
                    <label
                      for="variant-select"
                      class="text-content-muted mb-2 block font-mono text-[10px] tracking-widest uppercase"
                    >
                      Select Variant
                    </label>
                    <select
                      id="variant-select"
                      class="bg-base border-outline text-content focus:ring-brand shadow-ambient w-full cursor-pointer rounded-md border px-4 py-3 font-mono text-sm transition-colors duration-300 focus:ring-1 focus:outline-none"
                    >
                      {variants.map((v) => (
                        <option value={v.id} data-price-adj={v.priceAdjustment}>
                          {v.title}{' '}
                          {v.priceAdjustment > 0
                            ? `(+$${v.priceAdjustment.toFixed(2)})`
                            : ''}
                        </option>
                      ))}
                    </select>
                  </div>
                )}

                <button
                  id="add-to-cart-btn"
                  class="bg-brand text-brand-dark w-full rounded-md py-4 text-sm font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(54,244,164,0.15)] transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_25px_rgba(54,244,164,0.3)] focus:outline-none"
                  data-product-id={product.id}
                >
                  Execute Acquisition
                </button>
              </div>

              <div class="text-content-muted flex items-center gap-6 font-mono text-[10px] tracking-widest uppercase transition-colors duration-300">
                <div class="flex items-center gap-2">
                  <svg
                    class="text-brand h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>{' '}
                  Verified Serial
                </div>
                <a
                  href="/policies/returns"
                  class="hover:text-brand flex items-center gap-2 transition-colors focus:outline-none"
                >
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z"
                    />
                  </svg>{' '}
                  30-Day RMA Protocol
                </a>
              </div>
            </div>
          </div>

          <div class="relative z-10 mb-16">
            <ProductSpecs specs={productSpecs} />
          </div>

          <div class="relative z-10">
            <ReviewSection
              client:load
              productId={product.id}
              initialReviews={reviews}
            />
          </div>

          <div class="relative z-10 border-t border-white/10 pt-16">
            <h2 class="text-content mb-8 flex items-center gap-3 text-xl font-bold tracking-tighter uppercase transition-colors duration-300">
              <span class="bg-content-muted h-2 w-2 opacity-50" /> Operators
              Also Deployed
            </h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {relatedProducts.map((rel) => (
                <a
                  href={`/shop/product/${rel.slug}`}
                  class="group bg-surface shadow-ambient flex flex-col rounded-xl p-4 transition-all duration-300 hover:-translate-y-1"
                >
                  <div class="bg-surface-hover relative mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden rounded-lg transition-colors duration-300">
                    <span class="text-content-muted font-mono text-[10px] opacity-40">
                      Visual
                    </span>
                  </div>
                  <span class="text-content-muted mb-1 font-mono text-[10px] tracking-widest uppercase transition-colors duration-300">
                    {rel.brand}
                  </span>
                  <h3 class="text-content group-hover:text-brand mb-1 truncate text-sm font-bold transition-colors">
                    {rel.name}
                  </h3>
                  <div class="mt-auto flex items-baseline gap-2 font-mono">
                    <span class="text-brand text-sm font-bold">
                      ${rel.price.toFixed(2)}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <div class="relative z-10 mt-20">
            <RecentlyViewed
              client:only="svelte"
              currentProductId={product.id}
            />
          </div>

          <CheckoutStickyBar
            client:load
            price={product.basePrice}
            title={product.title}
          />
        </>
      )
    }
  </div>
</StorefrontLayout>

<script>
  // 1. Cart Integration Script
  const btn = document.getElementById('add-to-cart-btn');
  const variantSelect = document.getElementById(
    'variant-select'
  ) as HTMLSelectElement | null;

  btn?.addEventListener('click', () => {
    const productId = btn.dataset.productId;
    if (!productId) return;

    let variantId = undefined;
    if (variantSelect) {
      variantId = variantSelect.value;
    }

    import('../../../stores/cart.svelte.ts')
      .then((module) => {
        const { cart } = module;
        cart.addItem(productId, variantId, 1);
        cart.toggleCart();
      })
      .catch((err) => {
        console.error('Failed to load cart store:', err);
      });

    const originalText = btn.innerText;
    btn.innerText = 'Acquisition Confirmed';
    btn.classList.add('bg-content', 'text-base');
    btn.classList.remove('bg-brand', 'text-brand-dark');

    setTimeout(() => {
      btn.innerText = originalText;
      btn.classList.remove('bg-content', 'text-base');
      btn.classList.add('bg-brand', 'text-brand-dark');
    }, 2000);
  });

  // 2. Recently Viewed Auto-Tracker (Pushes current item to LocalStorage on load)
  const metaEl = document.getElementById('product-meta');
  if (metaEl && metaEl.dataset.product) {
    try {
      const p = JSON.parse(metaEl.dataset.product);
      import('../../../stores/recentlyViewed.svelte.ts').then(
        ({ recentStore }) => {
          recentStore.add(p);
        }
      );
    } catch (e) {
      console.error('Failed to track view.', e);
    }
  }
</script>
