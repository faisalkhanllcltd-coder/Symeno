---
import { env } from "cloudflare:workers";
import StorefrontLayout from '../../../layouts/Storefront.astro';
import WishlistButton from '../../../components/storefront/WishlistButton.svelte';
import RecentlyViewed from '../../../components/storefront/product/RecentlyViewed.svelte';
import ProductGallery from '../../../components/storefront/product/ProductGallery.svelte';
import CheckoutStickyBar from '../../../components/storefront/cart/CheckoutStickyBar.svelte';

export const prerender = false;

// PERFORMANCE UPGRADE: Cloudflare CDN Caching Strategy
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
);

const { slug } = Astro.params;
let product: any = null;
let relatedProducts: any[] = [];
let descriptionBullets: string[] = [];
let errorMessage = '';

try {
  const db = (env.DB as any) || (Astro.locals as any).runtime?.env?.DB;      
  if (!db) {
    errorMessage = 'Database connection offline.';        
  } else {
    const rawProduct = await db.prepare("SELECT * FROM catalog_cache WHERE slug = ?1").bind(slug).first();

    if (rawProduct) {
      let parsedImages = [];
      try {
        if (rawProduct.images_json && rawProduct.images_json !== '[]') {
          parsedImages = JSON.parse(rawProduct.images_json);
        }
      } catch(e) { console.error('Image parse failed', e); }
      
      if (parsedImages.length === 0) {
        parsedImages = ['/assets/placeholders/product-unavailable.webp'];
      }

      product = {
        id: rawProduct.id,
        slug: rawProduct.slug,
        brand: rawProduct.brand ?? 'Symeno Select',    
        category: rawProduct.category || 'Hardware',
        name: rawProduct.name,
        description: rawProduct.description || rawProduct.name,
        price: Number(rawProduct.price) || 0,
        retailPrice: Number(rawProduct.price) > 0 ? Number(rawProduct.price) * 1.15 : 0, 
        in_stock: rawProduct.in_stock,
        rating: rawProduct.rating || 0,
        reviewCount: rawProduct.review_count || 0,
        images: parsedImages
      };

      if (product.description && product.description.length > 20) {
        let rawText = product.description.replace(/<[^>]*>?/gm, ''); 
        if (rawText.includes('\n')) {
          descriptionBullets = rawText.split('\n');
        } else {
          descriptionBullets = rawText.split(/(?<=\.)\s+/);
        }
        descriptionBullets = descriptionBullets
          .map((s: string) => s.trim())
          .filter((s: string) => s.length > 5);
      }

      const { results: related } = await db.prepare(
        "SELECT slug, name, brand, price, images_json FROM catalog_cache WHERE category = ?1 AND id != ?2 LIMIT 4"
      ).bind(product.category, product.id).all();

      relatedProducts = related.map((p: any) => {
        let relImages = [];
        try {
          if (p.images_json && p.images_json !== '[]') relImages = JSON.parse(p.images_json);
        } catch(e) {}
        
        return {
          slug: p.slug,
          name: p.name,
          brand: p.brand || 'Symeno Select',
          price: Number(p.price) || 0,
          retailPrice: Number(p.price) > 0 ? Number(p.price) * 1.15 : 0,
          image: relImages.length > 0 ? relImages[0] : '/assets/placeholders/product-unavailable.webp'
        };
      });
    }
  }
} catch (e) {
  errorMessage = 'Anomaly detected while accessing edge datastore.';
  console.error('[EDGE_DB_ERROR]', e);
}

const isWishlisted = false;
const hasDiscount = product?.retailPrice && product.retailPrice > product.price;
const isInStock = product?.in_stock === 1;

const productSpecs = [
  { label: 'Brand', value: product?.brand ?? 'N/A' },
  { label: 'Category', value: product?.category ?? 'N/A' },
  { label: 'SKU', value: product?.id ? String(product.id).split('-')[0] : 'N/A' },        
  { label: 'Condition', value: 'Brand New — Factory Sealed' },
  { label: 'Warranty', value: 'Full Manufacturer Warranty' },
];
---

<StorefrontLayout
  title={product ? `${product.name} | Symeno` : 'Asset Not Found | Symeno'}
  description={product ? `Secure the ${product.name} at true wholesale pricing.` : 'Item unavailable.'}  
  image={product?.images[0]}
>
  {
    product && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          '@context': 'https://schema.org/',
          '@type': 'Product',
          name: product.name,
          description: product.description,
          brand: {
            '@type': 'Brand',
            name: product.brand,
          },
          sku: product.id,
          offers: {
            '@type': 'Offer',
            url: `https://symeno.com/shop/product/${product.slug}`,
            priceCurrency: 'USD',
            price: product.price.toString(),
            availability: isInStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
            itemCondition: 'https://schema.org/NewCondition',
          },
        })}
      />
    )
  }

  <div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12 min-h-screen">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.02] bg-[linear-gradient(var(--color-outline)_1px,transparent_1px),linear-gradient(90deg,var(--color-outline)_1px,transparent_1px)] bg-[size:32px_32px]"
    ></div>

    {
      errorMessage && (
        <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert relative z-10 mb-8 rounded border p-5 text-center font-mono text-[10px] sm:text-xs tracking-widest uppercase">
          {errorMessage}
        </div>
      )
    }

    {
      !product && !errorMessage && (
        <div class="bg-surface border-outline/50 relative z-10 mb-12 rounded-lg border p-12 text-center">
          <h1 class="text-content mb-4 font-mono text-xl sm:text-2xl font-bold tracking-widest uppercase">Asset Not Found</h1>
          <p class="text-content-muted font-mono text-xs">This unit is not currently indexed in our edge cache.</p>
          <a href="/shop" class="text-brand mt-6 inline-block font-mono text-xs tracking-widest uppercase font-bold hover:underline min-h-[44px] focus:outline-none">Return to Catalog</a>      
        </div>
      )
    }

    {
      product && (
        <>
          <div
            id="product-meta"
            data-product={JSON.stringify({
              id: product.id,
              slug: product.slug,
              brand: product.brand,
              name: product.name,
              price: product.price,
              retailPrice: product.retailPrice,
              stockStatus: isInStock ? 1 : 0,
              image: product.images[0] || ''
            })}
            style="display:none;"
          />

          <nav class="text-content-muted relative z-10 mb-6 flex flex-wrap items-center font-mono text-[9px] sm:text-[10px] tracking-widest uppercase">
            <a href="/" class="hover:text-content transition-colors focus:outline-none min-h-[44px] flex items-center">Base</a>
            <span class="mx-2">/</span>
            <a href="/shop" class="hover:text-content transition-colors focus:outline-none min-h-[44px] flex items-center">Catalog</a>
            <span class="mx-2">/</span>
            <span class="text-content font-bold truncate max-w-[120px] sm:max-w-[200px] min-h-[44px] flex items-center">{product.brand}</span>
          </nav>

          <div class="relative z-10 mb-16 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
            
            <div class="lg:col-span-7 relative">
              <div class="lg:sticky lg:top-24">
                <ProductGallery
                  client:load
                  images={product.images as string[]}
                  name={product.name as string}
                />
                <div class="absolute top-4 right-4 z-20"> 
                  <WishlistButton
                    client:load
                    productId={product.id as string}
                    initialState={isWishlisted as boolean}   
                  />
                </div>
              </div>
            </div>

            <div class="lg:col-span-5 flex flex-col pt-2 lg:pt-0">   
              
              <div class="mb-6 border-b border-outline/30 pb-6">
                <p class="mb-3 font-mono text-[11px] font-bold tracking-[0.2em] text-content-muted uppercase">
                  {product.brand}
                </p>
                <h1 class="text-3xl sm:text-4xl font-bold leading-tight text-content mb-4 text-balance">
                  {product.name}
                </h1>
                
                <div class="flex flex-wrap items-center gap-4">
                  {isInStock ? (
                    <span class="inline-flex items-center gap-1.5 rounded-sm border border-brand/20 bg-brand/5 px-2 py-1 font-mono text-[10px] font-bold uppercase tracking-widest text-brand">
                      <span class="h-1.5 w-1.5 rounded-full bg-brand animate-pulse"></span>
                      Available for Dispatch
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 rounded-sm bg-brand-alert/10 px-2 py-1 font-mono text-[10px] font-bold tracking-widest text-brand-alert uppercase border border-brand-alert/20">
                      Allocation Exhausted
                    </span>
                  )}
                  <span class="font-mono text-[10px] uppercase tracking-widest text-content-muted">
                    ID: {String(product.id).split('-')[0]}
                  </span>
                </div>
              </div>

              <div class="mb-8 rounded-xl border border-outline/50 bg-surface p-6 sm:p-8">
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
                  <div>
                    <p class="mb-1 font-mono text-[10px] font-bold tracking-[0.2em] text-content-muted uppercase">
                      Arbitrage Rate
                    </p>
                    <div class="flex items-baseline gap-3">
                      <span class="font-mono text-4xl sm:text-5xl font-bold tracking-tight text-brand">
                        ${Number(product.price).toFixed(2)}
                      </span>
                      {hasDiscount && (
                        <span class="font-mono text-sm text-content-muted line-through opacity-60">
                          ${Number(product.retailPrice).toFixed(2)} RRP
                        </span>
                      )}
                    </div>
                  </div>
                  {hasDiscount && (
                    <div class="flex flex-col items-start sm:items-end">
                      <span class="font-mono text-[10px] font-bold tracking-widest uppercase text-content-muted mb-1">Delta</span>
                      <span class="font-mono text-[12px] font-bold uppercase px-2.5 py-1 rounded-sm border border-brand/30 bg-brand/10 text-brand">
                        Save ${Math.floor(product.retailPrice - product.price)}
                      </span>
                    </div>
                  )}
                </div>

                {isInStock ? (
                  <div id="main-add-to-cart" class="flex flex-col gap-4">
                    <button
                      type="button"
                      id="add-to-cart-btn"
                      class="bg-brand text-brand-dark w-full min-h-[48px] rounded py-3 text-sm font-bold tracking-widest uppercase transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_20px_rgba(54,244,164,0.2)] focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 focus:ring-offset-base"
                      data-product-id={product.id}
                    >
                      Add to Cart
                    </button>
                    
                    <div class="text-content-muted flex items-center justify-center gap-4 sm:gap-6 font-mono text-[8px] sm:text-[9px] tracking-widest uppercase mt-2">
                      <div class="flex items-center gap-1.5">     
                        <svg class="text-brand h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Verified Authentic
                      </div>
                      <div class="flex items-center gap-1.5">     
                        <svg class="text-brand h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> Fast Dispatch
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="bg-base border border-outline/50 relative overflow-hidden rounded-lg p-5 sm:p-6 transition-colors duration-300">
                    <div class="from-brand/5 pointer-events-none absolute top-0 right-0 h-full w-32 bg-gradient-to-l to-transparent" />
                    <div class="mb-4 relative z-10">
                      <h3 class="text-content mb-1 text-xs font-bold tracking-widest uppercase">Join Waitlist</h3> 
                      <p class="text-content-muted font-mono text-[10px] sm:text-xs leading-relaxed">Due to high demand, this unit is currently backordered. Secure your priority position for the next supply drop.</p>
                    </div>
                    <div class="flex flex-col gap-3 relative z-10">
                      <input
                        type="email" 
                        id="waitlist-email"
                        placeholder="ENTER COMM LINK (EMAIL)..."
                        class="bg-surface border-outline/60 text-content placeholder:text-content-muted focus:border-brand focus:ring-brand w-full min-h-[44px] rounded-md border px-4 py-2 font-mono text-[10px] sm:text-xs transition-colors duration-300 focus:ring-1 focus:outline-none"
                      />
                      <button
                        type="button"
                        id="join-waitlist-btn"
                        class="bg-brand text-brand-dark w-full min-h-[48px] rounded py-3 text-xs font-bold tracking-widest uppercase transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_20px_rgba(54,244,164,0.2)] focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 focus:ring-offset-base"
                      >
                        Secure Position
                      </button>
                    </div>
                    <p id="waitlist-success" class="text-brand hidden mt-4 text-center font-bold font-mono text-[9px] tracking-widest uppercase">Protocol Accepted. You are on the list.</p>   
                  </div>
                )}
              </div>

            </div>
          </div>

          <div class="relative z-10 mb-16 pt-12 border-t border-outline/30 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
            
            <div>
              {descriptionBullets.length > 0 ? (
                <div class="space-y-4">
                  <h3 class="font-mono text-[11px] font-bold tracking-widest text-content uppercase border-b border-outline/30 pb-3">Product Highlights</h3>
                  <ul class="space-y-3">
                    {descriptionBullets.map((bullet) => (
                      <li class="flex items-start gap-3 text-xs sm:text-sm text-content-muted leading-relaxed">
                        <span class="text-brand mt-1.5 h-1 w-1 shrink-0 rounded-full bg-brand"></span>
                        <span>{bullet.trim()}{bullet.endsWith('.') || bullet.endsWith('!') ? '' : '.'}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <div class="space-y-4">
                  <h3 class="font-mono text-[11px] font-bold tracking-widest text-content uppercase border-b border-outline/30 pb-3">Product Highlights</h3>
                  <p class="text-xs sm:text-sm text-content-muted italic">Detailed documentation currently unavailable.</p>
                </div>
              )}
            </div>

            <div>
              <div class="overflow-hidden rounded-lg border border-outline/50 bg-surface shadow-sm">
                <div class="px-5 py-4 border-b border-outline/50 bg-base/30">
                  <h3 class="font-mono text-[11px] font-bold tracking-widest text-content uppercase">Detailed Specifications</h3>
                </div>
                <div class="divide-y divide-outline/30">
                  {productSpecs.map((spec) => (
                    <div class="grid grid-cols-1 sm:grid-cols-3 px-5 py-3 transition-colors hover:bg-base/50 gap-1 sm:gap-4">
                      <div class="font-mono text-[9px] sm:text-[10px] text-content-muted uppercase tracking-wider flex items-center">{spec.label}</div>
                      <div class="col-span-2 text-xs sm:text-sm font-medium text-content">{spec.value}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

          </div>

          {relatedProducts.length > 0 && (
            <div class="relative z-10 mb-16 pt-10 sm:pt-12 border-t border-outline/30">
              <h2 class="mb-6 sm:mb-8 text-lg sm:text-xl font-bold tracking-tighter text-content uppercase">Similar Items</h2>
              <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4 lg:gap-6">
                {relatedProducts.map((rp) => (
                  /* THE FIX: Rebuilt card layout to push image edge-to-edge with no padding */
                  <div class="group bg-surface border-outline/60 hover:border-brand/50 relative flex flex-col border transition-colors focus-within:outline-none focus-within:ring-2 focus-within:ring-brand rounded-lg shadow-sm hover:shadow-[0_8px_25px_-8px_rgba(0,0,0,0.2)] overflow-hidden">
                    <a href={`/shop/product/${rp.slug}`} class="absolute inset-0 z-30" aria-label={`View ${rp.name}`}></a>

                    <div class="bg-surface-hover relative flex aspect-[4/5] sm:aspect-square w-full items-center justify-center overflow-hidden border-b border-outline/30">
                      
                      {rp.image !== '/assets/placeholders/product-unavailable.webp' ? (
                        <img 
                          src={rp.image} 
                          alt={rp.name} 
                          loading="lazy" 
                          /* Changed to object-cover to stretch edge-to-edge */
                          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 z-0" 
                        />
                      ) : (
                        <span class="font-mono text-[9px] sm:text-[10px] text-content-muted z-0">Visual Missing</span>
                      )}

                      {rp.retailPrice && rp.retailPrice > rp.price && (
                        <div class="absolute left-3 top-3 z-20">
                          <span class="bg-brand text-brand-dark px-2 py-1 text-[8px] sm:text-[9px] font-bold tracking-widest uppercase rounded-sm shadow-md">
                            Save ${Math.floor(rp.retailPrice - rp.price)}
                          </span>
                        </div>
                      )}
                    </div>
                    
                    <div class="flex flex-col flex-1 p-3 sm:p-4">
                      <span class="text-content-muted font-mono text-[8px] sm:text-[9px] tracking-widest uppercase mb-1.5 truncate">
                        {rp.brand}
                      </span>
                      <h3 class="mb-3 line-clamp-2 text-[11px] sm:text-[13px] font-bold text-content group-hover:text-brand transition-colors leading-snug">
                        {rp.name}
                      </h3>
                      <div class="mt-auto flex items-baseline gap-2 font-mono">
                        <span class="text-brand text-sm sm:text-base font-bold tracking-tight">${rp.price.toFixed(2)}</span>
                        {rp.retailPrice && rp.retailPrice > rp.price && (
                          <span class="text-[9px] sm:text-[10px] text-content-muted line-through opacity-70">${rp.retailPrice.toFixed(2)}</span>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="relative z-10 mt-10 border-t border-outline/30 pt-10 sm:pt-12">
            <RecentlyViewed
              client:only="svelte"
              currentProductId={product.id as string}        
            />
          </div>
          
          <CheckoutStickyBar client:load product={product} />
        </>
      )
    }
  </div>
</StorefrontLayout>

<script>
  // Kept your vanilla JS wiring exactly intact so your Svelte store connects perfectly
  import { cart } from '../../../stores/cart.svelte.ts';

  const waitlistBtn = document.getElementById('join-waitlist-btn');
  const emailInput = document.getElementById('waitlist-email');
  const successMsg = document.getElementById('waitlist-success');

  waitlistBtn?.addEventListener('click', () => {
    const email = emailInput instanceof HTMLInputElement ? emailInput.value : '';
    if (!email || !email.includes('@')) {
      alert('Please provide a valid comm link (email).'); 
      return;
    }
    if (waitlistBtn) waitlistBtn.style.display = 'none';
    if (emailInput) emailInput.style.display = 'none';
    if (successMsg) successMsg.classList.remove('hidden');
  });

  const cartBtn = document.getElementById('add-to-cart-btn');
  cartBtn?.addEventListener('click', () => {
    const originalText = cartBtn.innerText;
    cartBtn.innerText = 'SECURING...';
    if (cartBtn instanceof HTMLButtonElement) cartBtn.disabled = true;
    
    setTimeout(() => {
      const metaEl = document.getElementById('product-meta'); 
      if (metaEl && metaEl.dataset.product) {
        try {
          const p = JSON.parse(metaEl.dataset.product);
          cart.addItem(p, 1);
          cart.openCart();
        } catch (e) {
          console.error('[CART_FATAL] Failed to parse product payload', e);
        }
      }

      cartBtn.innerText = 'ADDED TO CART ✓';
      cartBtn.classList.add('bg-brand', 'text-brand-dark', 'shadow-[0_0_20px_rgba(54,244,164,0.3)]');
      
      setTimeout(() => {
        cartBtn.innerText = originalText;
        if (cartBtn instanceof HTMLButtonElement) cartBtn.disabled = false;
        cartBtn.classList.remove('shadow-[0_0_20px_rgba(54,244,164,0.3)]');
      }, 2000);
    }, 400);
  });

  const metaEl = document.getElementById('product-meta'); 
  if (metaEl && metaEl.dataset.product) {
    try {
      const p = JSON.parse(metaEl.dataset.product);       
      import('../../../stores/recentlyViewed.svelte.ts').then(
        ({ recentStore }) => {
          recentStore.add({
            id: p.id,
            slug: p.slug,
            name: p.name,
            price: p.price,
            image_url: p.image
          });
        }
      );
    } catch (e) {
      console.error('Failed to track view.', e);
    }
  }
</script>