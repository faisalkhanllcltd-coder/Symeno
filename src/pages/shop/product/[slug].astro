---
import StorefrontLayout from '../../../layouts/Storefront.astro';

// ACTIVE IMPORTS
import WishlistButton from '../../../components/storefront/WishlistButton.svelte';
import RecentlyViewed from '../../../components/storefront/product/RecentlyViewed.svelte';
import ProductGallery from '../../../components/storefront/product/ProductGallery.svelte';
import ProductSpecs from '../../../components/storefront/product/ProductSpecs.astro';

// FORCE EDGE SSR - No Node.js modules allowed here
export const prerender = false;

const { slug } = Astro.params;
let product: any = null;
let errorMessage = '';

try {
  // Typecast Astro.locals to bypass TS strictness
  const db = (Astro.locals as any).runtime?.env?.DB;
  if (!db) {
    errorMessage = 'Database connection offline.';
  } else {
    // Fetch directly from Edge Cache
    const rawProduct = await db.prepare("SELECT * FROM rapidapi_cache WHERE sku = ?1").bind(slug).first();
    
    if (rawProduct) {
      // Map flat D1 row to the object structure your UI expects
      product = {
        ...rawProduct,
        id: rawProduct.sku,
        slug: rawProduct.sku,
        brand: rawProduct.category ?? 'Symeno Select',
        title: rawProduct.title,
        description: rawProduct.description || rawProduct.title,
        basePrice: rawProduct.price,
        retailPrice: rawProduct.price * 1.2, // Arbitrage visual padding
        images: rawProduct.image_url ? [rawProduct.image_url] : []
      };
    }
  }
} catch (e) {
  errorMessage = 'Anomaly detected while accessing edge datastore.';
  console.error('[EDGE_DB_ERROR]', e);
}

// Default fallbacks
const isWishlisted = false;
const hasDiscount = product?.retailPrice && product.retailPrice > product.basePrice;

const productSpecs: Record<string, string> = {
  'Brand': product?.brand ?? 'N/A',
  'Model': product?.title ? product.title.slice(0, 30) + '...' : 'N/A',
  'SKU': product?.id ? String(product.id) : 'N/A',
  'Condition': 'Brand New — Factory Sealed',
  'Warranty': 'Full Manufacturer Warranty',
  'Stock Status': product?.stock_status === 'IN_STOCK' ? 'Available' : 'Allocation Exhausted (Backordered)',
};
---

<StorefrontLayout
  title={product ? `${product.title} | Verified Wholesale | Symeno` : 'SKU Not Found | Symeno'}
  description={product ? `Secure the ${product.title} at true wholesale arbitrage pricing.` : 'Item unavailable.'}
>
  {
    product && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          '@context': 'https://schema.org/',
          '@type': 'Product',
          name: product.title,
          description: product.description,
          brand: {
            '@type': 'Brand',
            name: product.brand,
          },
          sku: product.id,
          offers: {
            '@type': 'Offer',
            url: `https://symeno.com/shop/product/${product.slug}`,
            priceCurrency: 'USD',
            price: product.basePrice.toString(),
            availability: 'https://schema.org/OutOfStock',
            itemCondition: 'https://schema.org/NewCondition',
          },
        })}
      />
    )
  }

  <div class="relative mx-auto max-w-7xl px-4 py-12 transition-colors duration-300 sm:px-6 lg:px-8">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.03] transition-opacity duration-300"
      style="background-image: linear-gradient(var(--color-content) 1px, transparent 1px), linear-gradient(90deg, var(--color-content) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    {
      errorMessage && (
        <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert mb-12 rounded-xl border p-6 text-center font-mono tracking-widest uppercase">
          {errorMessage}
        </div>
      )
    }

    {
      !product && !errorMessage && (
        <div class="bg-surface border-outline mb-12 rounded-xl border p-12 text-center">
          <h1 class="text-content font-mono text-2xl tracking-widest uppercase mb-4">SKU Not Found</h1>
          <p class="text-content-muted">This asset is not currently indexed in our edge cache.</p>
          <a href="/shop" class="text-brand mt-6 inline-block font-bold hover:underline">Return to Catalog</a>
        </div>
      )
    }

    {
      product && (
        <>
          <div
            id="product-meta"
            data-product={JSON.stringify({
              id: product.id,
              slug: product.slug,
              title: product.title,
              price: product.basePrice,
              image_url: product.images[0] || '',
            })}
            style="display:none;"
          />

          <nav class="text-content-muted relative z-10 mb-8 flex font-mono text-[10px] tracking-widest uppercase transition-colors duration-300">
            <a href="/" class="hover:text-brand transition-colors focus:outline-none">Base</a>
            <span class="mx-2">/</span>
            <a href="/shop" class="hover:text-brand transition-colors focus:outline-none">Catalog</a>
            <span class="mx-2">/</span>
            <span class="text-brand max-w-[150px] truncate sm:max-w-none">{product.title}</span>
          </nav>

          <div class="relative z-10 mb-20 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-20">
            <div class="space-y-6">
              <div class="relative">
                <ProductGallery
                  client:load
                  images={product.images as any}
                  alt={product.title as any}
                />
                <div class="absolute top-4 right-4 z-20">
                  <WishlistButton
                    client:load
                    productId={product.id as any}
                    initialState={isWishlisted as any}
                  />
                </div>
              </div>
            </div>

            <div class="flex flex-col justify-center">
              <h1 class="text-content mb-4 text-3xl leading-none font-bold tracking-tighter uppercase transition-colors duration-300 md:text-5xl">
                {product.title}
              </h1>

              <div class="mb-8 flex items-end gap-4 pb-8 font-mono transition-colors duration-300">
                <span class="text-brand text-4xl font-bold tracking-tighter transition-colors duration-300">
                  ${product.basePrice.toFixed(2)}
                </span>

                {hasDiscount && (
                  <div class="flex flex-col pb-1 transition-colors duration-300">
                    <span class="text-content-muted text-[10px] tracking-widest uppercase line-through">
                      Retail: ${product.retailPrice!.toFixed(2)}
                    </span>
                    <span class="text-content text-xs font-bold tracking-widest uppercase transition-colors duration-300">
                      Arbitrage: Save ${Math.floor(product.retailPrice! - product.basePrice)}
                    </span>
                  </div>
                )}
              </div>

              <p class="text-content-muted mb-10 font-mono text-sm leading-relaxed transition-colors duration-300">
                {product.description}
              </p>

              {/* PAINTED DOOR UI: Replaces standard checkout cart */}
              <div class="bg-surface border-brand/30 shadow-ambient group relative mb-8 overflow-hidden rounded-xl border p-6 transition-colors duration-300">
                <div class="from-brand/5 pointer-events-none absolute top-0 right-0 h-full w-32 bg-gradient-to-l to-transparent" />
                
                <div class="mb-4">
                  <h3 class="text-brand mb-1 text-sm font-bold tracking-widest uppercase">Allocation Exhausted</h3>
                  <p class="text-content-muted font-mono text-xs">Due to high demand, this unit is currently backordered. Secure your priority position for the next supply drop.</p>
                </div>

                <div class="flex flex-col gap-3">
                  <input 
                    type="email" 
                    id="waitlist-email" 
                    placeholder="ENTER COMM LINK (EMAIL)..." 
                    class="bg-base border-outline text-content focus:ring-brand shadow-ambient w-full rounded-md border px-4 py-3 font-mono text-sm transition-colors duration-300 focus:ring-1 focus:outline-none" 
                  />
                  <button
                    id="join-waitlist-btn"
                    class="bg-brand text-brand-dark w-full rounded-md py-4 text-sm font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(54,244,164,0.15)] transition-all duration-300 hover:opacity-90 hover:shadow-[0_0_25px_rgba(54,244,164,0.3)] focus:outline-none"
                    data-product-id={product.id}
                  >
                    Join Priority Waitlist
                  </button>
                </div>
                <p id="waitlist-success" class="text-brand hidden mt-4 text-center font-mono text-xs tracking-widest uppercase">Protocol Accepted. You are on the list.</p>
              </div>

              <div class="text-content-muted flex items-center gap-6 font-mono text-[10px] tracking-widest uppercase transition-colors duration-300">
                <div class="flex items-center gap-2">
                  <svg class="text-brand h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg> Verified Serial
                </div>
              </div>
            </div>
          </div>

          <div class="relative z-10 mb-16">
            <ProductSpecs specs={productSpecs} />
          </div>

          <div class="relative z-10 mt-20">
            <RecentlyViewed
              client:only="svelte"
              currentProductId={product.id as any}
            />
          </div>
        </>
      )
    }
  </div>
</StorefrontLayout>

<script>
  // 1. Painted Door / Waitlist Logic
  const btn = document.getElementById('join-waitlist-btn');
  const emailInput = document.getElementById('waitlist-email') as HTMLInputElement;
  const successMsg = document.getElementById('waitlist-success');

  btn?.addEventListener('click', () => {
    const email = emailInput?.value;
    if (!email || !email.includes('@')) {
      alert('Please provide a valid comm link (email).');
      return;
    }

    // Capture metric for demand testing
    console.log(`[PAINTED DOOR] Waitlist captured for: ${btn.dataset.productId} | Email: ${email}`);
    
    // UI Feedback
    btn.style.display = 'none';
    emailInput.style.display = 'none';
    if (successMsg) successMsg.classList.remove('hidden');
  });

  // 2. Recently Viewed Auto-Tracker
  const metaEl = document.getElementById('product-meta');
  if (metaEl && metaEl.dataset.product) {
    try {
      const p = JSON.parse(metaEl.dataset.product);
      import('../../../stores/recentlyViewed.svelte.ts').then(
        ({ recentStore }) => {
          recentStore.add(p);
        }
      );
    } catch (e) {
      console.error('Failed to track view.', e);
    }
  }
</script>