---
import StorefrontLayout from '../layouts/Storefront.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

// PERFORMANCE UPGRADE: Cache the Latest Deployments snapshot to offload D1
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=1200'
);

let newDeployments: any[] = [];
let errorMessage = '';

try {
  // ARMOR: Bulletproof edge bindings
  const db = (env.DB as any) || (Astro.locals as any).runtime?.env?.DB;
  if (db) {
    const { results } = await db.prepare(
      `SELECT id, slug, name, brand, category, price, images_json
       FROM catalog_cache
       ORDER BY scraped_at DESC
       LIMIT 16` // Boosted to 16 to fill a 4-column desktop grid perfectly
    ).all();
    
    newDeployments = (results || []).map((p: any) => {
      let mainImage = '/assets/placeholders/product-unavailable.webp';
      try {
        if (p.images_json && p.images_json !== '[]') {
          const parsed = JSON.parse(p.images_json);
          if (parsed.length > 0) mainImage = parsed[0];
        }
      } catch(e) {}

      return {
        slug: p.slug,
        brand: p.brand || 'Symeno Select',
        name: p.name,
        price: p.price || 0,
        retailPrice: p.price ? p.price * 1.15 : 0,
        image_url: mainImage
      };
    });
  } else {
    errorMessage = 'Database connection offline.';
  }
} catch (e) {
  errorMessage = 'Failed to load latest products.';
  console.error('[NEW_ARRIVALS_DB_ERROR]', e);
}
---

<StorefrontLayout
  title="Latest Deployments | Symeno"
  description="The newest hardware injections to our logistics pipeline."
>
  <div
    class="bg-base relative mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-14 lg:px-8 lg:py-20 transition-colors duration-300"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.02] bg-[linear-gradient(var(--color-outline)_1px,transparent_1px),linear-gradient(90deg,var(--color-outline)_1px,transparent_1px)] bg-[size:32px_32px]"
    ></div>

    <nav
      class="text-content-muted relative z-10 mb-6 flex font-mono text-[10px] tracking-widest uppercase"
    >
      <a
        href="/"
        class="hover:text-content transition-colors focus:outline-none min-h-[44px] flex items-center"
      >Base</a>
      <span class="mx-2 flex items-center">/</span>
      <span class="text-brand min-h-[44px] flex items-center">Pipeline</span>
    </nav>

    <div
      class="border-outline/50 relative z-10 mb-8 sm:mb-10 flex flex-col justify-between gap-6 border-b pb-6 sm:pb-8 md:flex-row md:items-end"
    >
      <div>
        <div class="mb-3 sm:mb-4 flex items-center gap-2">
          <span class="bg-brand h-1.5 w-1.5 animate-pulse rounded-full"></span>
          <p
            class="text-content-muted font-mono text-[9px] sm:text-[10px] tracking-widest uppercase font-bold"
          >
            Fresh Allocations
          </p>
        </div>
        <h1
          class="text-content mb-2 text-3xl font-bold tracking-tighter uppercase sm:text-4xl md:text-5xl"
        >
          Latest Deployments<span class="text-brand">.</span>
        </h1>
        <p class="text-content-muted font-mono text-xs sm:text-sm">
          The latest verified hardware injections to our logistics pipeline.
        </p>
      </div>
    </div>

    {errorMessage && (
      <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert relative z-10 mb-8 rounded border p-5 text-center font-mono text-[10px] sm:text-xs tracking-widest uppercase">
        {errorMessage}
      </div>
    )}

    {newDeployments.length === 0 && !errorMessage && (
      <div class="bg-surface border-outline/50 relative z-10 mb-8 rounded-lg border p-10 text-center">
        <p class="text-content-muted font-mono text-[10px] sm:text-xs tracking-widest uppercase">No deployments in the pipeline yet.</p>
      </div>
    )}

    <div
      class="relative z-10 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4 lg:gap-6"
    >
      {
        newDeployments.map((product) => (
          <a
            href={`/shop/product/${product.slug}`}
            class="group bg-surface border-outline/60 hover:border-brand/40 relative flex flex-col border p-3 sm:p-4 transition-colors focus:outline-none rounded-md shadow-sm hover:shadow-[0_8px_25px_-8px_rgba(0,0,0,0.2)]"
          >
            <div class="mb-3 sm:mb-4 flex items-start justify-between">
              <span class="text-content-muted font-mono text-[8px] sm:text-[9px] tracking-widest uppercase truncate max-w-[60%]">
                {product.brand}
              </span>
              <span class="text-brand border-brand/30 bg-brand/5 border px-1.5 py-0.5 text-[7px] sm:text-[8px] font-bold tracking-widest uppercase rounded-sm backdrop-blur-sm">
                NEW
              </span>
            </div>

            <div class="bg-surface-hover border-outline/30 relative mb-3 sm:mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden border rounded group-hover:border-brand/20 transition-colors">
              {product.image_url !== '/assets/placeholders/product-unavailable.webp' ? (
                <img
                  src={product.image_url}
                  alt={product.name}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-contain transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                />
              ) : (
                <span class="text-content-muted font-mono text-[9px] sm:text-[10px]">
                  Visual Missing
                </span>
              )}
            </div>

            <h2 class="text-content group-hover:text-brand mb-2 sm:mb-3 line-clamp-2 text-[10px] sm:text-xs font-bold transition-colors leading-snug">
              {product.name}
            </h2>

            <div class="mt-auto flex flex-col gap-1 font-mono">
              <div class="flex items-baseline gap-2">
                <span class="text-brand text-sm sm:text-base font-bold">
                  ${Number(product.price).toFixed(2)}
                </span>
                {product.retailPrice && product.retailPrice > product.price && (
                  <span class="text-content-muted text-[9px] sm:text-[10px] line-through">
                    ${Number(product.retailPrice).toFixed(2)}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</StorefrontLayout>