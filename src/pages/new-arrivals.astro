---
import StorefrontLayout from '../layouts/Storefront.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

let newDeployments: any[] = [];
let errorMessage = '';

try {
  const db = env.DB as any;
  if (db) {
    // 100% CLAUDE SCHEMA: Fetch the most recently added products
    const { results } = await db.prepare(
      `SELECT id, slug, name, brand, category, price, images_json
       FROM catalog_cache
       ORDER BY scraped_at DESC
       LIMIT 12`
    ).all();
    
    newDeployments = (results || []).map((p: any) => {
      let mainImage = '';
      try {
        if (p.images_json) {
          const parsed = JSON.parse(p.images_json);
          if (parsed.length > 0) mainImage = parsed[0];
        }
      } catch(e) {}

      return {
        slug: p.slug,
        brand: p.brand || 'Symeno Select',
        name: p.name,
        price: p.price || 0,
        retailPrice: p.price ? p.price * 1.15 : 0,
        image_url: mainImage || '/images/system/fallback.webp'
      };
    });
  } else {
    errorMessage = 'Database connection offline.';
  }
} catch (e) {
  errorMessage = 'Failed to load latest products.';
  console.error('[NEW_ARRIVALS_DB_ERROR]', e);
}
---

<StorefrontLayout
  title="Latest Deployments | Symeno"
  description="The newest hardware injections to our logistics pipeline."
>
  <div
    class="bg-base relative mx-auto max-w-7xl px-4 py-10 transition-colors duration-300 sm:px-6 md:py-16 lg:px-8"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(var(--color-content)_1px,transparent_1px),linear-gradient(90deg,var(--color-content)_1px,transparent_1px)] bg-[size:32px_32px] opacity-[0.03]"
    >
    </div>

    <nav
      class="text-content-muted relative z-10 mb-6 flex font-mono text-[10px] tracking-widest uppercase"
    >
      <a
        href="/"
        class="hover:text-content transition-colors focus:outline-none">Base</a
      >
      <span class="mx-2">/</span>
      <span class="text-brand">Pipeline</span>
    </nav>

    <div
      class="border-outline relative z-10 mb-10 flex flex-col justify-between gap-6 border-b pb-6 md:flex-row md:items-end"
    >
      <div>
        <div class="mb-3 flex items-center gap-2">
          <span class="bg-brand h-1.5 w-1.5"></span>
          <p
            class="text-content-muted font-mono text-[9px] tracking-widest uppercase"
          >
            Fresh Allocations
          </p>
        </div>
        <h1
          class="text-content mb-2 text-3xl font-bold tracking-tighter uppercase md:text-5xl"
        >
          Latest Deployments<span class="text-brand">.</span>
        </h1>
        <p class="text-content-muted font-mono text-xs">
          The latest verified hardware injections to our logistics pipeline.
        </p>
      </div>
    </div>

    {errorMessage && (
      <div class="bg-brand-alert/10 border-brand-alert/30 text-brand-alert mb-10 rounded-xl border p-5 text-center font-mono text-xs tracking-widest uppercase">
        {errorMessage}
      </div>
    )}

    {newDeployments.length === 0 && !errorMessage && (
      <div class="bg-surface border-outline mb-10 rounded-xl border p-10 text-center">
        <p class="text-content-muted font-mono text-[10px] tracking-widest uppercase">No deployments in the pipeline yet.</p>
      </div>
    )}

    <div
      class="relative z-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        newDeployments.map((product) => (
          <a
            href={`/shop/product/${product.slug}`}
            class="group bg-surface border-outline hover:border-brand/50 relative flex flex-col border p-3.5 transition-colors focus:outline-none rounded-xl shadow-sm"
          >
            <div class="mb-3 flex items-start justify-between">
              <span class="text-content-muted font-mono text-[9px] tracking-widest uppercase">
                {product.brand}
              </span>
              <span class="text-brand border-brand/30 border px-1.5 py-0.5 text-[8px] font-bold tracking-widest uppercase">
                NEW
              </span>
            </div>

            <div class="bg-base border-outline/50 relative mb-3 flex aspect-[4/5] items-center justify-center overflow-hidden border rounded-lg">
              {product.image_url ? (
                <img
                  src={product.image_url}
                  alt={product.name}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                />
              ) : (
                <span class="text-content-muted font-mono text-[9px]">
                  No Image
                </span>
              )}
            </div>

            <h2 class="text-content group-hover:text-brand mb-2.5 truncate text-xs font-bold transition-colors">
              {product.name}
            </h2>

            <div class="mt-auto flex flex-col gap-1 font-mono">
              <div class="flex items-baseline gap-2">
                <span class="text-brand text-base font-bold">
                  ${Number(product.price).toFixed(2)}
                </span>
                {product.retailPrice && product.retailPrice > product.price && (
                  <span class="text-content-muted text-[9px] line-through">
                    ${Number(product.retailPrice).toFixed(2)}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</StorefrontLayout>