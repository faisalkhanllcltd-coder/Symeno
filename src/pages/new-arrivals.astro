---
import StorefrontLayout from '../layouts/Storefront.astro';

// Mock Database - Filtered for items injected in the last 7 days
const newDeployments = [
  { id: 'lg-ultragear', name: 'LG 27" UltraGear OLED', price: 649.00, retail: 899.00, category: 'displays', brand: 'LG', date: 'TODAY' },
  { id: 'logitech-mx', name: 'Logitech MX Master 3S', price: 89.00, retail: 119.00, category: 'peripherals', brand: 'Logitech', date: 'YESTERDAY' },
  { id: 'sony-xm5', name: 'Sony WH-1000XM5', price: 249.00, retail: 399.00, category: 'audio', brand: 'Sony', date: 'T-MINUS 3 DAYS' }
];
---

<StorefrontLayout title="Latest Deployments | Symeno" description="The newest hardware injections to our logistics pipeline.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 relative bg-base transition-colors duration-300">

    <div class="absolute inset-0 opacity-[0.05] pointer-events-none bg-[linear-gradient(var(--color-content)_1px,transparent_1px),linear-gradient(90deg,var(--color-content)_1px,transparent_1px)] bg-[size:32px_32px]"></div>

    <nav class="flex text-[10px] font-mono text-content-muted uppercase tracking-widest mb-8 relative z-10">     
      <a href="/" class="hover:text-content transition-colors focus:outline-none">Base</a>
      <span class="mx-2">/</span>
      <span class="text-brand">Pipeline</span>      
    </nav>

    <div class="border-b border-outline pb-8 mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6 relative z-10">
      <div>
        <div class="flex items-center gap-3 mb-4">      
          <span class="w-2 h-2 bg-brand"></span>
          <p class="text-[10px] font-mono uppercase tracking-widest text-content-muted">Fresh Allocations</p>    
        </div>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter text-content uppercase mb-2">Latest Deployments<span class="text-brand">.</span></h1>
        <p class="text-sm text-content-muted font-mono">The latest verified hardware injections to our logistics pipeline.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">
      {newDeployments.map(product => (
        <a href={`/shop/product/${product.id}`} class="group flex flex-col focus:outline-none relative bg-surface border border-outline p-4 hover:border-brand/50 transition-colors">

          <div class="flex justify-between items-start mb-4">
            <span class="text-[10px] font-mono text-content-muted uppercase tracking-widest">{product.brand}</span>
            <span class="text-brand text-[9px] font-bold uppercase tracking-widest px-2 py-1 border border-brand/30">
              {product.date}
            </span>
          </div>

          <div class="aspect-[4/5] mb-4 relative flex items-center justify-center overflow-hidden bg-base border border-outline/50">
            <span class="text-[10px] font-mono text-content-muted">Hardware Array</span>
          </div>

          <h2 class="text-sm font-bold text-content mb-3 group-hover:text-brand transition-colors truncate">{product.name}</h2>

          <div class="flex flex-col gap-1 font-mono mt-auto">
            <div class="flex items-baseline gap-2">     
              <span class="text-lg font-bold text-brand">${product.price.toFixed(2)}</span>
              <span class="text-[10px] text-content-muted line-through">${product.retail.toFixed(2)}</span>      
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</StorefrontLayout>