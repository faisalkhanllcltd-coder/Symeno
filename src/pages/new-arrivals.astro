---
import StorefrontLayout from '../layouts/Storefront.astro';

// Mock Database - Filtered for items injected in the last 7 days
const newDeployments = [
  {
    id: 'lg-ultragear',
    name: 'LG 27" UltraGear OLED',
    price: 649.0,
    retail: 899.0,
    category: 'displays',
    brand: 'LG',
    date: 'TODAY',
  },
  {
    id: 'logitech-mx',
    name: 'Logitech MX Master 3S',
    price: 89.0,
    retail: 119.0,
    category: 'peripherals',
    brand: 'Logitech',
    date: 'YESTERDAY',
  },
  {
    id: 'sony-xm5',
    name: 'Sony WH-1000XM5',
    price: 249.0,
    retail: 399.0,
    category: 'audio',
    brand: 'Sony',
    date: 'T-MINUS 3 DAYS',
  },
];
---

<StorefrontLayout
  title="Latest Deployments | Symeno"
  description="The newest hardware injections to our logistics pipeline."
>
  <div
    class="bg-base relative mx-auto max-w-7xl px-4 py-12 transition-colors duration-300 sm:px-6 md:py-20 lg:px-8"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(var(--color-content)_1px,transparent_1px),linear-gradient(90deg,var(--color-content)_1px,transparent_1px)] bg-[size:32px_32px] opacity-[0.05]"
    >
    </div>

    <nav
      class="text-content-muted relative z-10 mb-8 flex font-mono text-[10px] tracking-widest uppercase"
    >
      <a
        href="/"
        class="hover:text-content transition-colors focus:outline-none">Base</a
      >
      <span class="mx-2">/</span>
      <span class="text-brand">Pipeline</span>
    </nav>

    <div
      class="border-outline relative z-10 mb-12 flex flex-col justify-between gap-6 border-b pb-8 md:flex-row md:items-end"
    >
      <div>
        <div class="mb-4 flex items-center gap-3">
          <span class="bg-brand h-2 w-2"></span>
          <p
            class="text-content-muted font-mono text-[10px] tracking-widest uppercase"
          >
            Fresh Allocations
          </p>
        </div>
        <h1
          class="text-content mb-2 text-4xl font-bold tracking-tighter uppercase md:text-6xl"
        >
          Latest Deployments<span class="text-brand">.</span>
        </h1>
        <p class="text-content-muted font-mono text-sm">
          The latest verified hardware injections to our logistics pipeline.
        </p>
      </div>
    </div>

    <div
      class="relative z-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        newDeployments.map((product) => (
          <a
            href={`/shop/product/${product.id}`}
            class="group bg-surface border-outline hover:border-brand/50 relative flex flex-col border p-4 transition-colors focus:outline-none"
          >
            <div class="mb-4 flex items-start justify-between">
              <span class="text-content-muted font-mono text-[10px] tracking-widest uppercase">
                {product.brand}
              </span>
              <span class="text-brand border-brand/30 border px-2 py-1 text-[9px] font-bold tracking-widest uppercase">
                {product.date}
              </span>
            </div>

            <div class="bg-base border-outline/50 relative mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden border">
              <span class="text-content-muted font-mono text-[10px]">
                Hardware Array
              </span>
            </div>

            <h2 class="text-content group-hover:text-brand mb-3 truncate text-sm font-bold transition-colors">
              {product.name}
            </h2>

            <div class="mt-auto flex flex-col gap-1 font-mono">
              <div class="flex items-baseline gap-2">
                <span class="text-brand text-lg font-bold">
                  ${product.price.toFixed(2)}
                </span>
                <span class="text-content-muted text-[10px] line-through">
                  ${product.retail.toFixed(2)}
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</StorefrontLayout>
