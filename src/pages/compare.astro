---
import StorefrontLayout from '../layouts/Storefront.astro';
---

<StorefrontLayout title="Hardware Comparison">
  <div class="mx-auto max-w-7xl px-4 py-20">
    <h1 class="mb-12 text-3xl font-bold tracking-tight text-gray-900 uppercase">
      Hardware Comparison.
    </h1>

    <div class="overflow-x-auto border border-gray-200">
      <table class="w-full bg-white text-left">
        <thead>
          <tr
            class="border-b border-gray-200 bg-gray-50 font-mono text-[10px] tracking-widest text-gray-500 uppercase"
          >
            <th class="w-1/4 p-4">Spec</th>
            <th class="border-l border-gray-200 p-4">Item A</th>
            <th class="border-l border-gray-200 p-4">Item B</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 text-sm">
          <tr
            ><td
              class="bg-gray-50 p-4 font-mono text-xs font-bold text-gray-900 uppercase"
              >Price</td
            ><td class="border-l border-gray-200 p-4">--</td><td
              class="border-l border-gray-200 p-4">--</td
            ></tr
          >
          <tr
            ><td
              class="bg-gray-50 p-4 font-mono text-xs font-bold text-gray-900 uppercase"
              >Condition</td
            ><td class="border-l border-gray-200 p-4">--</td><td
              class="border-l border-gray-200 p-4">--</td
            ></tr
          >
        </tbody>
      </table>
    </div>
  </div>
</StorefrontLayout>
