---
import StorefrontLayout from '../layouts/Storefront.astro';
---

<StorefrontLayout title="Hardware Comparison">
  <div class="mx-auto max-w-7xl px-4 py-20">
    <h1 class="mb-12 text-3xl font-bold tracking-tight text-content uppercase">
      Hardware Comparison.
    </h1>

    <div class="overflow-x-auto border border-outline">
      <table class="w-full bg-surface text-left">
        <thead>
          <tr
            class="border-b border-outline bg-base font-mono text-[10px] tracking-widest text-content-muted uppercase"
          >
            <th class="w-1/4 p-4">Spec</th>
            <th class="border-l border-outline p-4">Item A</th>
            <th class="border-l border-outline p-4">Item B</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline text-sm">
          <tr
            ><td
              class="bg-base p-4 font-mono text-xs font-bold text-content uppercase"
              >Price</td
            ><td class="border-l border-outline p-4">--</td><td
              class="border-l border-outline p-4">--</td
            ></tr
          >
          <tr
            ><td
              class="bg-base p-4 font-mono text-xs font-bold text-content uppercase"
              >Condition</td
            ><td class="border-l border-outline p-4">--</td><td
              class="border-l border-outline p-4">--</td
            ></tr
          >
        </tbody>
      </table>
    </div>
  </div>
</StorefrontLayout>
