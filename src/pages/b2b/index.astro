---
import StorefrontLayout from '../../layouts/Storefront.astro';
import B2BApplicationForm from '../../components/storefront/b2b/B2BApplicationForm.svelte';
---

<StorefrontLayout title="B2B Wholesale Operations | Symeno" description="Corporate hardware acquisition and logistics.">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    
    <div class="mb-16 max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tighter text-white uppercase mb-4">Wholesale Matrix.</h1>
      <p class="text-sm font-mono text-white/60 leading-relaxed">
        Symeno provides zero-markup hardware routing for registered enterprise clients. B2B status unlocks API access, automated bulk ordering interfaces, Net-30 terms, and dedicated logistics pipelines.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div class="space-y-12">
        <div>
          <h3 class="text-sm font-bold text-white uppercase tracking-widest font-mono border-b border-white/10 pb-3 mb-6">The Operator Advantage</h3>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="w-6 h-6 border border-[#36f4a4] bg-[#36f4a4]/10 text-[#36f4a4] flex items-center justify-center shrink-0 font-mono text-xs">1</div>
              <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-widest">Algorithmic Pricing</h4>
                <p class="text-[10px] font-mono text-white/50 mt-1">Tiered models driven strictly by base wholesale acquisition costs. No retail bloat.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-6 h-6 border border-[#36f4a4] bg-[#36f4a4]/10 text-[#36f4a4] flex items-center justify-center shrink-0 font-mono text-xs">2</div>
              <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-widest">High-Volume Interfacing</h4>
                <p class="text-[10px] font-mono text-white/50 mt-1">Bypass standard cart flows. Use our Bulk Matrix UI to acquire hundreds of units instantly.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-6 h-6 border border-[#36f4a4] bg-[#36f4a4]/10 text-[#36f4a4] flex items-center justify-center shrink-0 font-mono text-xs">3</div>
              <div>
                <h4 class="text-xs font-bold text-white uppercase tracking-widest">API Telemetry</h4>
                <p class="text-[10px] font-mono text-white/50 mt-1">Connect your ERP directly to our Edge network for live stock and pricing data.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div>
        <B2BApplicationForm client:load />
      </div>
    </div>

  </main>
</StorefrontLayout>