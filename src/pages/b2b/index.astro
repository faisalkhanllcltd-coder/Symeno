---
import StorefrontLayout from '../../layouts/Storefront.astro';
import B2BApplicationForm from '../../components/storefront/b2b/B2BApplicationForm.svelte';
---

<StorefrontLayout
  title="B2B Wholesale Operations | Symeno"
  description="Corporate hardware acquisition and logistics."
>
  <main class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-16 max-w-2xl">
      <h1 class="mb-4 text-4xl font-bold tracking-tighter text-content uppercase">
        Wholesale Matrix.
      </h1>
      <p class="font-mono text-sm leading-relaxed text-content-muted">
        SYMENO LLC provides zero-markup hardware routing for registered enterprise
        clients. B2B status unlocks API access, automated bulk ordering
        interfaces, Net-30 terms, and dedicated logistics pipelines.
        Contact info@symeno.com for wholesale inquiries.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-16 lg:grid-cols-2">
      <div class="space-y-12">
        <div>
          <h3
            class="mb-6 border-b border-outline pb-3 font-mono text-sm font-bold tracking-widest text-content uppercase"
          >
            The Operator Advantage
          </h3>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div
                class="flex h-6 w-6 shrink-0 items-center justify-center border border-brand bg-brand/10 font-mono text-xs text-brand"
              >
                1
              </div>
              <div>
                <h4
                  class="text-xs font-bold tracking-widest text-content uppercase"
                >
                  Algorithmic Pricing
                </h4>
                <p class="mt-1 font-mono text-[10px] text-content-muted">
                  Tiered models driven strictly by base wholesale acquisition
                  costs. No retail bloat.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div
                class="flex h-6 w-6 shrink-0 items-center justify-center border border-brand bg-brand/10 font-mono text-xs text-brand"
              >
                2
              </div>
              <div>
                <h4
                  class="text-xs font-bold tracking-widest text-content uppercase"
                >
                  High-Volume Interfacing
                </h4>
                <p class="mt-1 font-mono text-[10px] text-content-muted">
                  Bypass standard cart flows. Use our Bulk Matrix UI to acquire
                  hundreds of units instantly.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div
                class="flex h-6 w-6 shrink-0 items-center justify-center border border-brand bg-brand/10 font-mono text-xs text-brand"
              >
                3
              </div>
              <div>
                <h4
                  class="text-xs font-bold tracking-widest text-content uppercase"
                >
                  API Telemetry
                </h4>
                <p class="mt-1 font-mono text-[10px] text-content-muted">
                  Connect your ERP directly to our Edge network for live stock
                  and pricing data.
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div>
        <B2BApplicationForm client:load />
      </div>
    </div>
  </main>
</StorefrontLayout>
