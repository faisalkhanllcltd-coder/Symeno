---
import Storefront from '../layouts/Storefront.astro';
---

<Storefront title="Press & Media">
  <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <h1 class="mb-6 text-5xl font-bold tracking-tighter uppercase">
      Press Deck
    </h1>
    <p class="text-content-muted mx-auto mb-12 max-w-2xl text-lg">
      Official statements, brand assets, and media contact directives.
    </p>
    <div
      class="bg-surface border-outline shadow-ambient rounded-xl border p-12"
    >
      <a
        href="mailto:info@symeno.com"
        class="text-brand decoration-brand font-mono text-xs tracking-widest uppercase underline-offset-4 hover:underline"
        >Direct all media inquiries to info@symeno.com &rarr;</a
      >
      <p class="mt-4 font-mono text-[10px] text-content-muted uppercase">Legal Name: SYMENO LLC</p>
    </div>
  </div>
</Storefront>
