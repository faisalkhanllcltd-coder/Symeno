---
import Storefront from '../layouts/Storefront.astro';
const query = Astro.url.searchParams.get('q') || '';
---

<Storefront title={`Search: ${query}`}>
  <div class="mx-auto max-w-7xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <h1 class="mb-4 text-4xl font-bold tracking-tighter uppercase">
      Query: <span class="text-brand">{query || 'ALL PRODUCTS'}</span>
    </h1>
    <p
      class="text-content-muted mb-12 font-mono text-sm tracking-widest uppercase"
    >
      Global product indexing and arbitrage search...
    </p>

    <div
      class="bg-surface border-outline shadow-ambient inline-block w-full max-w-2xl rounded-xl border p-12"
    >
      <svg
        class="text-content-muted mx-auto mb-4 h-12 w-12 animate-pulse"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
      >
      <p class="text-content font-mono text-xs tracking-widest uppercase">
        Search indexing engine currently provisioning.
      </p>
      <a
        href="/shop"
        class="bg-brand text-brand-dark mt-8 inline-block px-8 py-3 text-xs font-bold tracking-widest uppercase transition-opacity hover:opacity-90"
        >Return to Catalog</a
      >
    </div>
  </div>
</Storefront>
