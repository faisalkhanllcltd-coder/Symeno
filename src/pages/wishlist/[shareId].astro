---
import StorefrontLayout from '../../layouts/Storefront.astro';
import { env } from "cloudflare:workers";

export const prerender = false;

const { shareId } = Astro.params;
const db = env.DB;

let ownerName = 'Someone';
let wishlistItems: any[] = [];

if (db) {
  try {
    // FIX: Using the correct 'customers' table as defined in your schema
    const user = await db
      .prepare(
        'SELECT id, first_name FROM customers WHERE id = ? LIMIT 1'
      )
      .bind(shareId)
      .first<{ id: string, first_name: string }>();

    if (user) {
      ownerName = user.first_name || 'A User';
      const { results } = await db
        .prepare(
          `
        SELECT p.title, p.slug, p.basePrice, p.image_url, COALESCE(v.inventory_quantity, 0) as stock
        FROM wishlists w
        JOIN products p ON w.product_id = p.id
        LEFT JOIN product_variants v ON p.id = v.product_id AND v.is_default = 1
        WHERE w.customer_id = ?1
        ORDER BY w.created_at DESC
      `
        )
        .bind(user.id)
        .all();
      wishlistItems = results || [];
    }
  } catch (e) {
    console.error('[WISHLIST_DB_ERROR]', e);
  }
}

if (wishlistItems.length === 0) {
  return Astro.redirect('/404');
}
---

<StorefrontLayout title={`${ownerName}'s Wishlist | Symeno`}>
  <main class="mx-auto max-w-6xl px-6 pt-32 pb-24">
    <div class="border-outline mb-12 border-b pb-6 text-center">
      <h1 class="text-content text-3xl font-bold tracking-widest uppercase">
        {ownerName}'s Wishlist
      </h1>
      <p class="text-content-muted mt-2 font-mono text-xs">
        Shared inventory selection
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:grid-cols-4">
      {
        wishlistItems.map((item: any) => (
          <a
            href={`/shop/product/${item.slug}`}
            class="bg-surface border-outline hover:border-brand/50 group flex flex-col border transition-colors"
          >
            <div class="bg-base relative aspect-square overflow-hidden">
              <img
                src={item.image_url || '/placeholder.webp'}
                alt={item.title}
                class="h-full w-full object-cover opacity-80 transition-all duration-500 group-hover:scale-105 group-hover:opacity-100"
              />
              {item.stock <= 0 && (
                <div class="absolute bottom-0 left-0 w-full bg-rose-500/90 py-1 text-center text-[10px] font-bold tracking-widest text-white uppercase">
                  Out of Stock
                </div>
              )}
            </div>
            <div class="p-4">
              <h3 class="text-content mb-1 truncate text-xs font-bold">
                {item.title}
              </h3>
              <p class="text-brand font-mono text-[10px] font-bold">
                ${item.basePrice?.toFixed(2)}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</StorefrontLayout>
